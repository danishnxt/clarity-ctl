+
+
+def test_build_invoice_looks_up_each_country_once_per_call_and_never_across_calls(data_dir, catalog):
+    from conftest import event_record
+    from meterbill.events import parse_event
+    from meterbill.invoices import build_invoice
+    from meterbill.period import Period
+
+    calls = []
+
+    class Counting(TaxResolver):
+        def rate_for(self, tenant_id, country, on_date):
+            calls.append(country)
+            return super().rate_for(tenant_id, country, on_date)
+
+    events = [parse_event(event_record(tenant_id="NWD", quantity="1", idempotency_key=f"k{i}"))
+              for i in range(5)]
+    resolver = Counting(data_dir)
+    period, issued = Period.parse("2026-10"), date(2026, 10, 15)
+    first = build_invoice("NWD", period, events, catalog, issued, resolver)
+    assert len(first.lines) >= 1 and len(calls) == len({l.country for l in first.lines})
+    n = len(calls)
+    build_invoice("NWD", period, events, catalog, issued, resolver)
+    assert len(calls) == 2 * n  # nothing carried over to the next call
