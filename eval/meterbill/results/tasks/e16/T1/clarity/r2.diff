+def test_tax_lookup_once_per_country_per_call_and_not_across_calls(catalog):
+    class CountingResolver:
+        def __init__(self):
+            self.calls = 0
+
+        def rate_for(self, tenant_id, country, on_date):
+            self.calls += 1
+            return Decimal("0.19")
+
+    resolver = CountingResolver()
