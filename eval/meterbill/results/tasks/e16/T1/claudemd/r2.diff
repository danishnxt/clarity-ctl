+class _CountingResolver:
+    def __init__(self, inner):
+        self.inner, self.calls = inner, []
+
+    def rate_for(self, tenant_id, country, on_date):
+        self.calls.append((tenant_id, country, on_date))
+        return self.inner.rate_for(tenant_id, country, on_date)
+
+
+def test_tax_looked_up_once_per_country_per_build_not_across_builds(catalog):
+    from meterbill.tax import TaxResolver
+
+    evs = [
+        parse_event(event_record(quantity="10", idempotency_key=f"k{i}",
+                                 properties={"country": c}))
+        for i, c in enumerate(["DE", "FR", "DE", "FR"])
+    ]
+    resolver = _CountingResolver(TaxResolver())
+    first = build_invoice("NWD", OCT, evs, catalog, date(2026, 11, 2), tax_resolver=resolver)
+    assert len(first.lines) >= 2
+    assert sorted(c for _, c, _ in resolver.calls) == sorted({l.country for l in first.lines})
+    n = len(resolver.calls)
+    build_invoice("NWD", OCT, evs, catalog, date(2026, 11, 2), tax_resolver=resolver)
+    assert len(resolver.calls) == 2 * n  # nothing remembered between builds
