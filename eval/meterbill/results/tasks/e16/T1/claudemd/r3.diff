     ]
     assert [l.tax_rate for l in inv.lines] == [Decimal("0.19"), Decimal("0.20")]
     assert [l.tax_amount.minor for l in inv.lines] == [28, 60]  # 150 * 0.19 = 28.5 -> 28; 300 * 0.20 = 60
+
+
+def test_tax_looked_up_once_per_country_per_build_and_never_across_builds(catalog, data_dir):
+    from meterbill.tax import TaxResolver
+
+    class Counting(TaxResolver):
+        calls = 0
+
+        def rate_for(self, *a):
+            Counting.calls += 1
+            return super().rate_for(*a)
+
+    evs = [parse_event(event_record(quantity="1", idempotency_key=f"k{i}",
+                                    properties={"country": "FR" if i % 2 else "DE"}))
+           for i in range(6)]
+    resolver = Counting(data_dir)
+    build_invoice("NWD", OCT, evs, catalog, issue_date=date(2026, 11, 2), tax_resolver=resolver)
+    first = Counting.calls
+    assert first == 2  # DE and FR; flat-fee lines share the country lookup
+    build_invoice("NWD", OCT, evs, catalog, issue_date=date(2026, 11, 2), tax_resolver=resolver)
+    assert Counting.calls == 2 * first  # a second run asks again: no cross-run cache
