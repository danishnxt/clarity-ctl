+def credit_note_postings(note: CreditNote) -> list[Posting]:
+    """The balanced postings of one credit note: the mirror image of its invoice's.
+
+    Revenue goes back to the account stored on the invoice line, and tax is
+    reversed at the stored tax amounts; the current account map is not used.
+    """
+    number, day, zero = note.number, note.issue_date.isoformat(), Money.zero(note.currency)
+    postings = [Posting(number, day, RECEIVABLE_ACCOUNT, zero, -note.total)]
+    for line in note.lines:
+        if not line.revenue_account:
+            raise ExportError(
+                f"{number}: invoice line {line.invoice_line} of {note.invoice_number} has no "
+                "stored revenue account (invoice predates it); cannot post the credit note"
+            )
+        postings.append(Posting(number, day, line.revenue_account, -line.amount, zero))
+        if line.tax_amount.minor != 0:
+            if not line.country:
+                raise ExportError(f"{number}: line for {line.meter!r} has tax but no country")
+            postings.append(Posting(number, day, TAX_ACCOUNT_PREFIX + line.country,
+                                    -line.tax_amount, zero))
+    return postings
+
+
 def write_postings(
     documents: Iterable[Document], period: Period, accounts: AccountMap, out: IO[str]
 ) -> int:
-    """Write one JSON object per posting for the finalized invoices of ``period``.
+    """Write one JSON object per posting for the documents of ``period``.
 
-    Credit notes and drafts are skipped. Returns the number of postings written.
+    Finalized invoices belong to their billing period, credit notes to their
+    issue month; drafts are skipped. Returns the number of postings written.
     """
     selected = sorted(
         (d for d in documents
-         if isinstance(d, Invoice) and d.number and d.period == period
-         and d.status is InvoiceStatus.FINALIZED),
+         if d.number and (
+             (isinstance(d, Invoice) and d.period == period
+              and d.status is InvoiceStatus.FINALIZED)
+             or (isinstance(d, CreditNote)
+                 and (d.issue_date.year, d.issue_date.month) == (period.year, period.month)))),
         key=lambda d: (d.issue_date, d.number),
     )
     count = 0
-    for invoice in selected:
-        for posting in invoice_postings(invoice, accounts):
+    for doc in selected:
+        postings = (invoice_postings(doc, accounts) if isinstance(doc, Invoice)
+                    else credit_note_postings(doc))
+        for posting in postings:
             out.write(json.dumps(posting.to_dict()) + "\n")
             count += 1
     return count
