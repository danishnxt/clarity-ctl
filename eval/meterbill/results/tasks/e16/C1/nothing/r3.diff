+def _run_plans(args: argparse.Namespace) -> int:
+    try:
+        catalog = load_catalog(args.data_dir)
+    except (ValueError, OSError, CatalogError) as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 1
+    rows = []
+    for plan_id in sorted(catalog.plans):
+        plan = catalog.plans[plan_id]
+        models = {c.model for c in plan.components}
+        model = next(iter(models)).value if len(models) == 1 else "mixed"
+        rows.append((plan.id, plan.name, model, plan.currency))
+    header = ("ID", "NAME", "MODEL", "CURRENCY")
+    widths = [max(len(r[i]) for r in [header, *rows]) for i in range(len(header))]
+    for row in [header, *rows]:
+        print("  ".join(f"{c:<{w}}" for c, w in zip(row, widths)))
+    return 0
