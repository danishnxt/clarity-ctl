     return parser
 
 
+def _plan_model(plan) -> str:
+    models = {c.model.value for c in plan.components}
+    if not models:
+        return "-"
+    return models.pop() if len(models) == 1 else "mixed"
+
+
+def _run_plans(args: argparse.Namespace) -> int:
+    try:
+        catalog = load_catalog(args.data_dir)
+    except (ValueError, OSError) as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 1
+    rows = [("ID", "NAME", "MODEL", "CURRENCY")]
+    rows += [(p.id, p.name, _plan_model(p), p.currency)
+             for p in sorted(catalog.plans.values(), key=lambda p: p.id)]
+    widths = [max(len(r[i]) for r in rows) for i in range(4)]
+    for r in rows:
+        print("  ".join(f"{c:<{w}}" for c, w in zip(r, widths)).rstrip())
+    return 0
+
