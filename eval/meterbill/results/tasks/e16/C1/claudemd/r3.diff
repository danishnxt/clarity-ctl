+def test_plans_list_sorted_aligned(data_dir, capsys):
+    assert main(["plans", "list", "--data-dir", str(data_dir)]) == 0
+    lines = capsys.readouterr().out.splitlines()
+    assert lines[0].split() == ["ID", "NAME", "MODEL", "CURRENCY"]
+    ids = [l.split("  ")[0].strip() for l in lines[1:]]
+    assert ids == sorted(ids) and "usage-eur" in ids
+    assert len({len(l) for l in lines}) == 1
+    row = next(l for l in lines if l.startswith("usage-eur"))
+    assert "per_unit" in row
+    assert "mixed" in next(l for l in lines if l.startswith("starter"))
