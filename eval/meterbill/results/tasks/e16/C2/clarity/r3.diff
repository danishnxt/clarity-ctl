+def test_tenants_list(data_dir, capsys):
+    assert main(["tenants", "list", "--data-dir", str(data_dir)]) == 0
+    lines = capsys.readouterr().out.splitlines()
+    assert lines[0].split() == ["ID", "NAME", "COUNTRY", "PLAN", "CURRENCY", "TZ"]
+    ids = [line.split()[0] for line in lines[1:]]
+    assert ids == sorted(ids) and ids
