+def _run_tenants(args: argparse.Namespace) -> int:
+    try:
+        catalog = load_catalog(args.data_dir)
+    except (ValueError, OSError, CatalogError) as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 1
+    rows = [
+        (t.id, t.name, t.country, t.plan_id,
+         t.billing_currency or catalog.plans[t.plan_id].currency, t.tz)
+        for t in sorted(catalog.tenants.values(), key=lambda t: t.id)
+    ]
+    table = [("ID", "NAME", "COUNTRY", "PLAN", "CURRENCY", "TZ"), *rows]
+    widths = [max(len(r[i]) for r in table) for i in range(6)]
+    for row in table:
+        print("  ".join(f"{c:<{w}}" for c, w in zip(row, widths)).rstrip())
+    return 0
+
