 def _table(header: Sequence[str], rows: Sequence[Sequence[str]], left: int) -> list[str]:
     """Aligned columns; the first ``left`` are left-aligned, the rest right-aligned."""
     widths = [max(len(header[i]), *(len(r[i]) for r in rows)) if rows else len(header[i])
