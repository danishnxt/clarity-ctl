+def test_tenants_list_aligned_sorted(data_dir, capsys):
+    assert main(["tenants", "list", "--data-dir", str(data_dir)]) == 0
+    lines = capsys.readouterr().out.splitlines()
+    assert lines[0] == "ID   NAME           COUNTRY  PLAN            CURRENCY  TZ"
+    assert lines[1:] == [
+        "ACM  Acme Corp      US       starter         USD       America/New_York",
+        "GLB  Globex         GB       starter         USD       UTC",
+        "NWD  Northwind      DE       usage-eur       EUR       Europe/Berlin",
+        "TKY  Tokyo Freight  JP       enterprise-jpy  USD       UTC",
+        "ZEN  ZEN            US       starter         USD       UTC",
+    ]
+
+
+def test_tenants_list_bad_data_dir(tmp_path, capsys):
