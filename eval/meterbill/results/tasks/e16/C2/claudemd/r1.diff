+def test_tenants_list_seed(data_dir, capsys):
+    assert main(["tenants", "list", "--data-dir", str(data_dir)]) == 0
+    lines = capsys.readouterr().out.splitlines()
+    assert lines[0] == "ID   NAME           COUNTRY  PLAN            CURRENCY  TZ"
+    assert [l.split()[0] for l in lines[1:]] == ["ACM", "GLB", "NWD", "TKY", "ZEN"]
+    assert lines[3] == "NWD  Northwind      DE       usage-eur       EUR       Europe/Berlin"
+    assert lines[4] == "TKY  Tokyo Freight  JP       enterprise-jpy  USD       UTC"
+
+
+def test_tenants_list_bad_data_dir(tmp_path, capsys):
+    assert main(["tenants", "list", "--data-dir", str(tmp_path)]) == 1
+    assert "error:" in capsys.readouterr().err
