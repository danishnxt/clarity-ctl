+def _run_tenants(args: argparse.Namespace) -> int:
+    try:
+        catalog = load_catalog(args.data_dir)
+        rows = [
+            (t.id, t.name, t.country, t.plan_id,
+             t.billing_currency or catalog.plan(t.plan_id).currency, t.tz)
+            for t in sorted(catalog.tenants.values(), key=lambda t: t.id)
+        ]
+    except (ValueError, OSError) as exc:  # CatalogError is a ValueError
+        print(f"error: {exc}", file=sys.stderr)
+        return 1
+    header = ("ID", "NAME", "COUNTRY", "PLAN", "CURRENCY", "TZ")
+    widths = [max(len(h), *(len(r[i]) for r in rows)) if rows else len(h)
+              for i, h in enumerate(header)]
+    for row in (header, *rows):
+        print("  ".join(f"{c:<{w}}" for c, w in zip(row, widths)).rstrip())
+    return 0
