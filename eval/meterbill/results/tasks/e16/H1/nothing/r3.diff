+def _credit_note(lines, cur="EUR", number="CN-ACM-2026-00001", issued=date(2026, 10, 20)):
+    from meterbill.credits import CreditNote, CreditNoteLine
+    cl = tuple(CreditNoteLine(i, m, c, Decimal(-1), Money(-n, cur), Decimal("0.19"), Money(-t, cur))
+               for i, (m, n, t, c) in enumerate(lines, 1))
+    return CreditNote(number, "INV-ACM-2026-00001", "ACM", "Acme", cur, "dispute", issued, cl)
+
+
+def test_credit_note_postings_reverse_and_balance():
+    from meterbill.exports import credit_note_postings
+    note = _credit_note([("api_calls", 1001, 190, "DE"), ("platform_fee", 300, 0, "US")])
+    postings = credit_note_postings(note, ACCOUNTS)
+    assert [(p.account, p.debit.minor, p.credit.minor) for p in postings] == [
+        ("4010", 1001, 0), ("2200-DE", 190, 0), ("4000", 300, 0), ("1200", 0, 1491),
+    ]
+    assert _balance(postings) == 0
+
+
