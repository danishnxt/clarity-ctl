@@ -93,3 +93,27 @@ def test_cli_ledger(tmp_path):
     assert code == 0
     rows = [json.loads(r) for r in out.read_text().splitlines()]
     assert [r["account"] for r in rows] == ["1200", "4010", "2200-DE"]
+
+
+def _credit_note(number="CN-ACM-2026-00001", issue=date(2026, 11, 20)):
+    from meterbill.credits import CreditNote, CreditNoteLine
+    lines = (CreditNoteLine(1, "api_calls", "DE", Decimal(-1), Money(-1000, "EUR"),
+                            Decimal("0.19"), Money(-190, "EUR")),)
+    return CreditNote(number, "INV-ACM-2026-00001", "ACM", "Acme", "EUR", "oops", issue, lines)
+
+
+def test_credit_note_postings_reverse_invoice():
+    from meterbill.exports import credit_note_postings
+    postings = credit_note_postings(_credit_note(), ACCOUNTS)
+    assert [(p.account, p.debit.minor, p.credit.minor) for p in postings] == [
+        ("1200", 0, 1190), ("4010", 1000, 0), ("2200-DE", 190, 0)]
+    assert _balance(postings) == 0
+
+
+def test_write_postings_includes_credit_notes_by_issue_month():
+    out = io.StringIO()
+    note = _credit_note()
+    assert write_postings([note], Period(2026, 10), ACCOUNTS, io.StringIO()) == 0
+    assert write_postings([note], Period(2026, 11), ACCOUNTS, out) == 3
+    rows = [json.loads(r) for r in out.getvalue().splitlines()]
+    assert rows[0]["document_number"] == "CN-ACM-2026-00001" and rows[0]["credit"] == "11.90"
