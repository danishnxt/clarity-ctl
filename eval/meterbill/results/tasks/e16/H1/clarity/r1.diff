+def credit_note_postings(note: CreditNote, accounts: AccountMap) -> list[Posting]:
+    """The balanced postings of one credit note (amounts on the note are negative)."""
+    number, day, zero = note.number, note.issue_date.isoformat(), Money.zero(note.currency)
+    # A negative note amount reverses a credit (debit it); a positive one the opposite.
+    def post(account: str, amount: Money) -> Posting:
+        if amount.minor <= 0:
+            return Posting(number, day, account, -amount, zero)
+        return Posting(number, day, account, zero, amount)
+
+    total = note.total
+    postings = [Posting(number, day, RECEIVABLE_ACCOUNT, zero, -total) if total.minor <= 0
+                else Posting(number, day, RECEIVABLE_ACCOUNT, total, zero)]
+    for line in note.lines:
+        postings.append(post(line.revenue_account or accounts.revenue_account(line.meter),
+                             line.amount))
+        if line.tax_amount.minor != 0:
+            if not line.country:
+                raise ExportError(f"{number}: line for {line.meter!r} has tax but no country")
+            postings.append(post(TAX_ACCOUNT_PREFIX + line.country, line.tax_amount))
+    return postings
+
