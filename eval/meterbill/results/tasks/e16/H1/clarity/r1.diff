     assert [r["account"] for r in rows] == ["1200", "4010", "2200-DE"]
+
+
+# --- credit notes -----------------------------------------------------------
+
+from meterbill.credits import (CreditNote, CreditNoteLine, credit_note_from_json,
+                               credit_note_to_json, issue_credit_note)
+from meterbill.invoices import SequenceStore, invoice_from_json
+from meterbill.exports import credit_note_postings
+
+
+def _acct_line(meter, net, tax, country, account):
+    return InvoiceLine(meter, Decimal(1), Decimal(1), Money(net, "EUR"), country,
+                       Decimal("0.19"), Money(tax, "EUR"), revenue_account=account)
+
+
+def _credit(invoice, tmp_path, lines=None):
+    store = SequenceStore(tmp_path / "cn.json", prefix="CN")
+    return issue_credit_note(invoice, lines, reason="refund", store=store,
+                             issue_date=date(2026, 12, 5))
+
+
+def test_credit_note_posts_reverse_to_original_account_after_remap(tmp_path):
+    inv = _invoice([_acct_line("api_calls", 1000, 190, "DE", "4010")])
+    note = _credit(inv, tmp_path)
+    remapped = AccountMap({"api_calls": "4999"}, "4000")  # year-end remap
+    postings = credit_note_postings(note, remapped)
+    assert [(p.account, p.debit.minor, p.credit.minor) for p in postings] == [
+        ("1200", 0, 1190), ("4010", 1000, 0), ("2200-DE", 190, 0),
+    ]
+    assert _balance(postings) == 0
+    assert all(p.date == "2026-12-05" and p.document_number == note.number for p in postings)
+
+
+def test_credit_note_legacy_line_falls_back_to_current_map(tmp_path):
+    note = _credit(_invoice([_line("api_calls", 1000, 190, "DE")]), tmp_path)
+    assert credit_note_postings(note, ACCOUNTS)[1].account == "4010"
+
+
+def test_account_survives_serialization_and_issue(tmp_path):
+    inv = _invoice([_acct_line("api_calls", 1000, 190, "DE", "4010")])
+    assert invoice_from_json(invoice_to_json(inv)).lines[0].revenue_account == "4010"
+    note = credit_note_from_json(credit_note_to_json(_credit(inv, tmp_path)))
+    assert note.lines[0].revenue_account == "4010"
+
+
+def test_write_postings_includes_credit_notes_by_issue_month(tmp_path):
+    inv = _invoice([_acct_line("api_calls", 1000, 190, "DE", "4010")])
+    note = _credit(inv, tmp_path)
+    out = io.StringIO()
+    assert write_postings([inv, note], Period(2026, 12), ACCOUNTS, out) == 3
+    assert write_postings([inv, note], P, ACCOUNTS, io.StringIO()) == 3  # the invoice only
+    rows = [json.loads(x) for x in out.getvalue().splitlines()]
+    assert {r["document_number"] for r in rows} == {note.number}
+
+
+def test_credit_note_tax_without_country_is_an_error(tmp_path):
+    note = _credit(_invoice([_acct_line("api_calls", 1000, 190, None, "4010")]), tmp_path)
+    with pytest.raises(ExportError):
+        credit_note_postings(note, ACCOUNTS)
