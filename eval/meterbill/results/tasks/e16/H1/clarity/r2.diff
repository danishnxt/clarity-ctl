diff --git a/tests/test_ledger.py b/tests/test_ledger.py
index c5b2953..cfcce97 100644
--- a/tests/test_ledger.py
+++ b/tests/test_ledger.py
@@ -93,3 +93,52 @@ def test_cli_ledger(tmp_path):
     assert code == 0
     rows = [json.loads(r) for r in out.read_text().splitlines()]
     assert [r["account"] for r in rows] == ["1200", "4010", "2200-DE"]
+
+
+# --- credit notes ---------------------------------------------------------
+
+def _credit(invoice, lines=None):
+    from meterbill.credits import issue_credit_note
+    from meterbill.invoices import SequenceStore
+
+    import tempfile, pathlib
+    store = SequenceStore(pathlib.Path(tempfile.mkdtemp()) / "c.json")
+    return issue_credit_note(invoice, lines, reason="refund", store=store,
+                             issue_date=date(2026, 12, 3))
+
+
+def test_credit_note_reverses_invoice_postings_and_balances():
+    from meterbill.exports import credit_note_postings
+    inv = _invoice([_line("api_calls", 1250, 238, "DE"), _line("storage_gb", 100, 0, "DE")])
+    postings = credit_note_postings(_credit(inv), ACCOUNTS)
+    assert _balance(postings) == 0
+    assert [(p.account, p.debit.minor, p.credit.minor) for p in postings] == [
+        ("1200", 0, 1588), ("4010", 1250, 0), ("2200-DE", 238, 0), ("4000", 100, 0)]
+
+
+def test_credit_note_posts_to_recorded_account_not_current_mapping():
+    from dataclasses import replace
+    from meterbill.exports import credit_note_postings
+    inv = _invoice([replace(_line("api_calls", 1000, 190, "DE"), revenue_account="4999")])
+    note = _credit(inv)
+    assert note.lines[0].revenue_account == "4999"
+    assert credit_note_postings(note, ACCOUNTS)[1].account == "4999"  # map says 4010
+
+
+def test_credit_note_in_period_by_issue_month_and_cli_round_trip(tmp_path):
+    from dataclasses import replace
+    from meterbill.credits import credit_note_to_json
+    inv = _invoice([replace(_line("api_calls", 1000, 190, "DE"), revenue_account="4999")])
+    docs = tmp_path / "docs"
+    docs.mkdir()
+    (docs / "a.json").write_text(invoice_to_json(inv))
+    (docs / "b.json").write_text(credit_note_to_json(_credit(inv)))
+    (tmp_path / "accounts.json").write_text('{"meters": {"api_calls": "4010"}, "default": "4000"}')
+    out = tmp_path / "p.jsonl"
+    args = ["ledger", "--out", str(out), "--documents-dir", str(docs), "--data-dir", str(tmp_path)]
+    assert main(args + ["--period", "2026-12"]) == 0
+    rows = [json.loads(r) for r in out.read_text().splitlines()]
+    assert [(r["account"], r["debit"], r["credit"]) for r in rows] == [
+        ("1200", "0.00", "11.90"), ("4999", "10.00", "0.00"), ("2200-DE", "1.90", "0.00")]
+    assert {r["document_number"] for r in rows} == {rows[0]["document_number"]}
+    assert rows[0]["date"] == "2026-12-03"
