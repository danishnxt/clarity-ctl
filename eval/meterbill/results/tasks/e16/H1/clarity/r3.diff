-         and d.status is InvoiceStatus.FINALIZED),
-        key=lambda d: (d.issue_date, d.number),
-    )
+    def wanted(d: Document) -> bool:
+        if isinstance(d, CreditNote):
+            return (d.issue_date.year, d.issue_date.month) == (period.year, period.month)
+        return bool(d.number) and d.period == period and d.status is InvoiceStatus.FINALIZED
+
+    selected = sorted((d for d in documents if wanted(d)), key=lambda d: (d.issue_date, d.number))
     count = 0
-    for invoice in selected:
