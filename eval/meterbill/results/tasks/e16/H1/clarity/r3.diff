+def credit_note_postings(note: CreditNote, accounts: AccountMap) -> list[Posting]:
+    """The balanced postings of one credit note: the exact reverse of the invoice's.
+
+    Per line, the revenue account stored on the original invoice line is debited
+    for the net and ``2200-<country>`` for the tax; ``1200`` is credited for the
+    gross. Only a line from an invoice built before accounts were stored falls
+    back to the current meter mapping.
+    """
+    day, zero = note.issue_date.isoformat(), Money.zero(note.currency)
+    postings = [Posting(note.number, day, RECEIVABLE_ACCOUNT, zero, -note.total)]
+    for line in note.lines:
+        account = line.revenue_account or accounts.revenue_account(line.meter)
+        postings.append(Posting(note.number, day, account, -line.amount, zero))
+        if line.tax_amount.minor != 0:
+            if not line.country:
+                raise ExportError(f"{note.number}: line for {line.meter!r} has tax but no country")
+            postings.append(Posting(note.number, day, TAX_ACCOUNT_PREFIX + line.country,
+                                    -line.tax_amount, zero))
+    return postings
+
