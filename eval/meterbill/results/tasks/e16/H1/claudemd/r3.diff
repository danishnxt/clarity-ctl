diff --git a/tests/test_ledger.py b/tests/test_ledger.py
index c5b2953..d9efcab 100644
--- a/tests/test_ledger.py
+++ b/tests/test_ledger.py
@@ -93,3 +93,68 @@ def test_cli_ledger(tmp_path):
     assert code == 0
     rows = [json.loads(r) for r in out.read_text().splitlines()]
     assert [r["account"] for r in rows] == ["1200", "4010", "2200-DE"]
+
+
+# -- credit notes ------------------------------------------------------------
+from meterbill.credits import issue_credit_note, credit_note_to_json
+from meterbill.exports import credit_note_postings
+from meterbill.invoices import SequenceStore
+
+
+def _stamped(tmp_path, cur="EUR"):
+    inv = _invoice([_line("api_calls", 1000, 190, "DE", cur), _line("other", 500, 0, "US", cur)], cur)
+    lines = tuple(__import__("dataclasses").replace(
+        l, revenue_account=a) for l, a in zip(inv.lines, ["4010", "4099"]))
+    inv = Invoice(inv.tenant_id, inv.tenant_name, P, cur, lines, inv.issue_date,
+                  number=inv.number, status=inv.status)
+    return inv, SequenceStore(tmp_path / "cn.json", prefix="CN")
+
+
+@pytest.mark.parametrize("cur", ["EUR", "JPY", "KWD"])
+def test_credit_note_reverses_original_accounts_and_balances(tmp_path, cur):
+    inv, store = _stamped(tmp_path, cur)
+    note = issue_credit_note(inv, reason="oops", store=store, issue_date=date(2026, 11, 5))
+    postings = credit_note_postings(note)
+    # ACCOUNTS now maps differently; the stored accounts must win
+    assert [(p.account, p.debit.minor, p.credit.minor) for p in postings] == [
+        ("1200", 0, 1690), ("4010", 1000, 0), ("2200-DE", 190, 0), ("4099", 500, 0)]
+    assert _balance(postings) == 0
+
+
+def test_credit_note_without_stored_account_is_an_error(tmp_path):
+    inv = _invoice([_line("api_calls", 1000, 190, "DE")])
+    note = issue_credit_note(inv, reason="x", store=SequenceStore(tmp_path / "c.json", prefix="CN"))
+    with pytest.raises(ExportError):
+        credit_note_postings(note)
+
+
+def test_write_postings_includes_credit_notes_by_issue_month(tmp_path):
+    inv, store = _stamped(tmp_path)
+    note = issue_credit_note(inv, reason="x", store=store, issue_date=date(2026, 10, 30))
+    out = io.StringIO()
+    assert write_postings([inv, note], Period(2026, 10), ACCOUNTS, out) == 8
+    assert write_postings([inv, note], P, ACCOUNTS, io.StringIO()) == 8
+    assert write_postings([note], Period(2026, 11), ACCOUNTS, io.StringIO()) == 0
+
+
+def test_invoice_line_account_roundtrips_and_old_docs_load(tmp_path):
+    from meterbill.invoices import invoice_from_json
+    inv, _ = _stamped(tmp_path)
+    assert [l.revenue_account for l in invoice_from_json(invoice_to_json(inv)).lines] == ["4010", "4099"]
+    doc = json.loads(invoice_to_json(inv))
+    for l in doc["lines"]:
+        del l["revenue_account"]
+    assert invoice_from_json(json.dumps(doc)).lines[0].revenue_account is None
+
+
+def test_credit_note_json_roundtrip_keeps_account(tmp_path):
+    from meterbill.credits import credit_note_from_json
+    inv, store = _stamped(tmp_path)
+    note = issue_credit_note(inv, reason="x", store=store)
+    assert credit_note_from_json(credit_note_to_json(note)) == note
+
+
+def test_build_invoice_stamps_base_meter_account(catalog):
+    from meterbill.invoices import build_invoice
+    inv = build_invoice("NWD", P, [], catalog, date(2026, 11, 2), accounts=ACCOUNTS)
+    assert all(l.revenue_account for l in inv.lines)
