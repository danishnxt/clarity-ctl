+# --- credit notes ---------------------------------------------------------
+
+from datetime import datetime, timezone
+
+from meterbill.credits import credit_note_to_json, issue_credit_note
+from meterbill.credits.serialization import credit_note_from_json
+from meterbill.events import UsageEvent
+from meterbill.exports import credit_note_postings
+from meterbill.invoices import SequenceStore, build_invoice, invoice_from_json
+from meterbill.tax import TaxResolver
+
+
+def _stored_line(meter, net, tax, country, account, cur="EUR"):
+    return InvoiceLine(meter, Decimal(1), Decimal(1), Money(net, cur), country,
+                       Decimal("0.19"), Money(tax, cur), revenue_account=account)
+
+
+def _credit(inv, tmp_path, lines=None, issue=date(2026, 11, 20)):
+    return issue_credit_note(inv, lines, reason="r", issue_date=issue,
+                             store=SequenceStore(tmp_path / "cn.json", "CN"))
+
+
+def test_credit_note_mirrors_invoice_and_balances(tmp_path):
+    inv = _invoice([_stored_line("api_calls", 1001, 190, "DE", "4010"),
+                    _stored_line("platform_fee", 500, 0, "US", "4020")])
+    postings = credit_note_postings(_credit(inv, tmp_path))
+    assert [(p.account, p.debit.minor, p.credit.minor) for p in postings] == [
+        ("1200", 0, inv.total.minor),
+        ("4010", 1001, 0), ("2200-DE", 190, 0),
+        ("4020", 500, 0),
+    ]
+    assert _balance(postings) == 0
+    assert postings[0].date == "2026-11-20"
+
+
+@pytest.mark.parametrize("cur", ["JPY", "KWD"])
+def test_credit_note_balanced_in_other_exponents(cur, tmp_path):
+    inv = _invoice([_stored_line("api_calls", 1234, 123, "JP", "4010", cur)], cur)
+    assert _balance(credit_note_postings(_credit(inv, tmp_path))) == 0
+
+
+def test_credit_note_uses_original_account_not_current_map(tmp_path):
+    inv = _invoice([_stored_line("api_calls", 1000, 190, "DE", "4010")])
+    note = _credit(inv, tmp_path)
+    remapped = AccountMap({"api_calls": "4999"}, "4999")  # accounting remapped at year end
+    out = io.StringIO()
+    write_postings([inv, note], Period(2026, 11), remapped, out)
+    accounts = [json.loads(r)["account"] for r in out.getvalue().splitlines()]
+    assert accounts == ["1200", "4010", "2200-DE"]  # the note only; the invoice is October
+    assert invoice_postings(inv, remapped)[1].account == "4010"
+
+
+def test_credit_note_account_survives_json_round_trip(tmp_path):
+    inv = invoice_from_json(invoice_to_json(
+        _invoice([_stored_line("api_calls", 1000, 190, "DE", "4010")])))
+    note = credit_note_from_json(credit_note_to_json(_credit(inv, tmp_path)))
+    assert note.lines[0].revenue_account == "4010"
+
+
+def test_credit_note_without_stored_account_is_an_error(tmp_path):
+    inv = _invoice([_line("api_calls", 1000, 190, "DE")])  # old document, no account
+    with pytest.raises(ExportError, match="no stored revenue account"):
+        credit_note_postings(_credit(inv, tmp_path))
+
+
+def test_old_invoice_still_posts_with_current_map():
+    inv = _invoice([_line("api_calls", 1000, 190, "DE")])
+    assert invoice_postings(inv, ACCOUNTS)[1].account == "4010"
+
+
+def test_credit_note_period_is_issue_month(tmp_path):
+    inv = _invoice([_stored_line("api_calls", 1000, 190, "DE", "4010")])
+    note = _credit(inv, tmp_path)
+    assert write_postings([note], Period(2026, 10), ACCOUNTS, io.StringIO()) == 0
+    assert write_postings([note], Period(2026, 11), ACCOUNTS, io.StringIO()) == 3
+
+
