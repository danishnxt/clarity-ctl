+"""Revenue account mapping, shared by invoice building and the ledger export."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True, slots=True)
+class AccountMap:
+    """Revenue account per meter, with a fallback for unmapped meters."""
+
+    meters: dict[str, str]
+    default: str
+
+    def revenue_account(self, meter: str) -> str:
+        return self.meters.get(meter, self.default)
