diff --git a/tests/test_quote.py b/tests/test_quote.py
index 1bf3250..2d69915 100644
--- a/tests/test_quote.py
+++ b/tests/test_quote.py
@@ -131,3 +131,25 @@ def test_cli_quote_errors(args, capsys):
     assert main(["quote", *args]) == 1
     captured = capsys.readouterr()
     assert captured.err.startswith("error: ") and captured.out == ""
+
+
+def test_next_tier_hint():
+    from meterbill.pricing import next_tier_hint
+    tiers = (Tier(Decimal(1000), Decimal("0.10")), Tier(Decimal(5000), Decimal("0.08")),
+             Tier(None, Decimal("0.05")))
+    tiered = PlanComponent("m", PricingModel.TIERED, tiers=tiers)
+    volume = PlanComponent("m", PricingModel.VOLUME, tiers=tiers)
+    per_unit = PlanComponent("m", PricingModel.PER_UNIT, unit_price=Decimal("0.1"))
+    assert next_tier_hint(tiered, Decimal(1000)) == "next tier: +1 unit at 0.08"
+    assert next_tier_hint(tiered, Decimal(999)) == "next tier: +2 units at 0.08"
+    assert next_tier_hint(tiered, Decimal(1001)) == "next tier: +4000 units at 0.05"
+    assert next_tier_hint(tiered, Decimal(5001)) == "next tier: top tier"
+    assert next_tier_hint(volume, Decimal(999)) == "next tier: +1 unit at 0.08"
+    assert next_tier_hint(volume, Decimal(1000)) == "next tier: +4000 units at 0.05"
+    assert next_tier_hint(volume, Decimal(5000)) == "next tier: top tier"
+    assert next_tier_hint(per_unit, Decimal(5)) is None
+
+
+def test_cli_quote_prints_next_tier(capsys):
+    assert main(["quote", "--plan", "growth", "--meter", "api_calls", "--quantity", "1000"]) == 0
+    assert "api_calls: next tier: +1 unit at 0.08" in capsys.readouterr().out
