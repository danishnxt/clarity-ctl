@@ -63,6 +63,31 @@ def price_quantity(
     )]
 
 
+def next_tier_hint(component: PlanComponent, quantity: Decimal) -> str | None:
+    """Upsell hint for a tiered or volume component, or None for other models.
+
+    Counts whole extra units: a tiered quantity must exceed a tier's ``up_to`` to
+    reach the next tier; a volume quantity must reach it.
+    """
+    if component.model not in (PricingModel.TIERED, PricingModel.VOLUME):
+        return None
+    for index, tier in enumerate(component.tiers):
+        if tier.up_to is None:
+            break
+        if component.model is PricingModel.TIERED:
+            if quantity > tier.up_to:
+                continue
+            units = (tier.up_to - quantity).to_integral_value(rounding=ROUND_FLOOR) + 1
+        else:
+            if quantity >= tier.up_to:
+                continue
+            units = (tier.up_to - quantity).to_integral_value(rounding=ROUND_CEILING)
+        nxt = component.tiers[index + 1]
+        word = "unit" if units == 1 else "units"
+        return f"next tier: +{units:f} {word} at {nxt.unit_price:f}"
+    return "next tier: top tier"
+
+
 def _amount(quantity: Decimal, unit_price: Decimal, currency: str) -> Money:
     return Money.from_major(quantity * unit_price, currency, rounding=ROUND_HALF_UP)
 
