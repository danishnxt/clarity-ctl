diff --git a/meterbill/pricing.py b/meterbill/pricing.py
index 8173df5..4f5fbd7 100644
--- a/meterbill/pricing.py
+++ b/meterbill/pricing.py
@@ -91,3 +91,33 @@ def _price_volume(component: PlanComponent, quantity: Decimal, currency: str) ->
         f"{component.meter} (volume tier {number})", quantity, tier.unit_price,
         _amount(quantity, tier.unit_price, currency),
     )
+
+
+@dataclass(frozen=True, slots=True)
+class NextTier:
+    units_needed: Decimal  # more units, on top of the quoted quantity, to reach the next tier
+    unit_price: Decimal  # the next tier's price per unit
+
+
+def next_tier(component: PlanComponent, quantity: Decimal) -> NextTier | None:
+    """The upsell hint for a tiered or volume component, or None if it has no tiers to climb.
+
+    Returns None for flat and per_unit components. For a component already in its
+    last tier, also returns None; callers tell the two apart by the model.
+
+    Tiered: the next tier starts at unit ``up_to + 1`` of the current tier, so
+    that many units in total are needed. Volume: the next tier starts at a
+    quantity equal to the current tier's ``up_to``.
+    """
+    if component.model not in (PricingModel.TIERED, PricingModel.VOLUME):
+        return None
+    tiers = component.tiers
+    for i, tier in enumerate(tiers):
+        if tier.up_to is None:
+            return None
+        if component.model is PricingModel.TIERED:
+            if quantity <= tier.up_to:
+                return NextTier(tier.up_to + 1 - quantity, tiers[i + 1].unit_price)
+        elif quantity < tier.up_to:
+            return NextTier(tier.up_to - quantity, tiers[i + 1].unit_price)
+    return None
