diff --git a/tests/test_quote.py b/tests/test_quote.py
index 1bf3250..f69da9e 100644
--- a/tests/test_quote.py
+++ b/tests/test_quote.py
@@ -131,3 +131,25 @@ def test_cli_quote_errors(args, capsys):
     assert main(["quote", *args]) == 1
     captured = capsys.readouterr()
     assert captured.err.startswith("error: ") and captured.out == ""
+
+
+@pytest.mark.parametrize("plan,meter,qty,expected", [
+    ("growth", "api_calls", "1000", "api_calls next tier: +1 unit at 0.08"),
+    ("growth", "api_calls", "1", "api_calls next tier: +1000 units at 0.08"),
+    ("growth", "api_calls", "1001", "api_calls next tier: +9000 units at 0.05"),
+    ("growth", "api_calls", "12000", "api_calls next tier: top tier"),
+    ("volume", "storage_gb", "999", "storage_gb next tier: +1 unit at 0.08"),
+    ("volume", "storage_gb", "1000", "storage_gb next tier: +9000 units at 0.05"),
+    ("volume", "storage_gb", "10000", "storage_gb next tier: top tier"),
+])
+def test_cli_next_tier_hint(capsys, plan, meter, qty, expected):
+    assert main(["quote", "--plan", plan, "--meter", meter, "--quantity", qty]) == 0
+    assert expected in capsys.readouterr().out
+
+
+def test_cli_plan_quote_hint_and_flat_has_none(capsys):
+    assert main(["quote", "--plan", "growth", "--usage", "api_calls=1000"]) == 0
+    out = capsys.readouterr().out
+    assert out.count("next tier") == 1 and "api_calls next tier: +1 unit at 0.08" in out
+    assert main(["quote", "--plan", "growth", "--meter", "platform_fee", "--quantity", "1"]) == 0
+    assert "next tier" not in capsys.readouterr().out
