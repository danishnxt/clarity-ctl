     return "\n".join(out)
diff --git a/tests/test_quote.py b/tests/test_quote.py
index 1bf3250..0dd9b65 100644
--- a/tests/test_quote.py
+++ b/tests/test_quote.py
@@ -131,3 +131,24 @@ def test_cli_quote_errors(args, capsys):
     assert main(["quote", *args]) == 1
     captured = capsys.readouterr()
     assert captured.err.startswith("error: ") and captured.out == ""
+
+
+@pytest.mark.parametrize("plan,meter,qty,hint", [
+    ("growth", "api_calls", "1000", "next tier: +1 unit at 0.08"),
+    ("growth", "api_calls", "1", "next tier: +1000 units at 0.08"),
+    ("growth", "api_calls", "10000", "next tier: +1 unit at 0.05"),
+    ("growth", "api_calls", "10001", "next tier: top tier"),
+    ("volume", "storage_gb", "999", "next tier: +1 unit at 0.08"),
+    ("volume", "storage_gb", "1000", "next tier: +9000 units at 0.05"),
+    ("volume", "storage_gb", "10000", "next tier: top tier"),
+])
+def test_cli_next_tier_hint(plan, meter, qty, hint, capsys):
+    assert main(["quote", "--plan", plan, "--meter", meter, "--quantity", qty]) == 0
+    assert f"{meter}: {hint}" in capsys.readouterr().out
+
+
+def test_cli_plan_quote_next_tier_per_component(capsys):
+    assert main(["quote", "--plan", "growth", "--usage", "api_calls=500"]) == 0
+    assert "api_calls: next tier: +501 units at 0.08" in capsys.readouterr().out
+    assert main(["quote", "--plan", "starter", "--usage", "api_calls=5"]) == 0
+    assert "next tier" not in capsys.readouterr().out
