+
+def _upsell_hint(component, quantity: Decimal) -> str:
+    step = next_tier(component, quantity)
+    if step is None:
+        return "next tier: top tier"
+    units, price = step
+    count = f"{units.normalize():f}"
+    return f"next tier: +{count} {'unit' if units == 1 else 'units'} at {price:f}"
 
 
