diff --git a/meterbill/pricing.py b/meterbill/pricing.py
index 8173df5..fcdbeda 100644
--- a/meterbill/pricing.py
+++ b/meterbill/pricing.py
@@ -91,3 +91,20 @@ def _price_volume(component: PlanComponent, quantity: Decimal, currency: str) ->
         f"{component.meter} (volume tier {number})", quantity, tier.unit_price,
         _amount(quantity, tier.unit_price, currency),
     )
+
+
+def next_tier(component: PlanComponent, quantity: Decimal) -> tuple[Decimal, Decimal] | None:
+    """Units to add to ``quantity`` to reach the next price tier, and that tier's unit price.
+
+    None when the quantity is already in the last tier, or the component is not
+    tiered or volume. Tiered bounds are inclusive, so the next tier starts at
+    ``up_to + 1``; a volume tier is left at ``up_to`` itself.
+    """
+    if component.model not in (PricingModel.TIERED, PricingModel.VOLUME):
+        return None
+    tiered = component.model is PricingModel.TIERED
+    for tier, following in zip(component.tiers, component.tiers[1:]):
+        assert tier.up_to is not None
+        if quantity < tier.up_to or (tiered and quantity == tier.up_to):
+            return tier.up_to + (1 if tiered else 0) - quantity, following.unit_price
+    return None
