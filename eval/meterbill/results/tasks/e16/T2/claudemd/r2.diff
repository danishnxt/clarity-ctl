+def next_tier(component: PlanComponent, quantity: Decimal) -> tuple[Decimal, Decimal] | None:
+    """Whole extra units needed to reach the next tier, and that tier's unit price.
+
+    Only for tiered and volume components; None when ``quantity`` is already in
+    the last tier. Graduated bounds are inclusive (1000 is still tier 1, so
+    1001 is needed); volume bounds are strict (1000 already is tier 2).
+    """
+    if component.model not in (PricingModel.TIERED, PricingModel.VOLUME):
+        raise ValueError(f"{component.meter!r} has no tiers")
+    if quantity < 0 or not quantity.is_finite():
+        raise ValueError(f"quantity must be finite and not negative: {quantity}")
+    tiers = component.tiers
+    for index, tier in enumerate(tiers):
+        if tier.up_to is None:
+            return None
+        if component.model is PricingModel.TIERED:
+            if quantity > tier.up_to:
+                continue
+            needed = (tier.up_to - quantity).to_integral_value(rounding=ROUND_FLOOR) + 1
+        else:
+            if quantity >= tier.up_to:
+                continue
+            needed = (tier.up_to - quantity).to_integral_value(rounding=ROUND_CEILING)
+        return needed, tiers[index + 1].unit_price
+    return None
+
+
 def _amount(quantity: Decimal, unit_price: Decimal, currency: str) -> Money:
     return Money.from_major(quantity * unit_price, currency, rounding=ROUND_HALF_UP)
 
