diff --git a/tests/test_quote.py b/tests/test_quote.py
index 1bf3250..1a1c877 100644
--- a/tests/test_quote.py
+++ b/tests/test_quote.py
@@ -131,3 +131,39 @@ def test_cli_quote_errors(args, capsys):
     assert main(["quote", *args]) == 1
     captured = capsys.readouterr()
     assert captured.err.startswith("error: ") and captured.out == ""
+
+
+def _three_tiers():
+    return [Tier(Decimal(1000), Decimal("0.10")), Tier(Decimal(10000), Decimal("0.08")),
+            Tier(None, Decimal("0.05"))]
+
+
+@pytest.mark.parametrize("model, qty, expected", [
+    (PricingModel.TIERED, "0", (1001, "0.08")),
+    (PricingModel.TIERED, "999", (2, "0.08")),
+    (PricingModel.TIERED, "1000", (1, "0.08")),
+    (PricingModel.TIERED, "1000.5", (9000, "0.05")),
+    (PricingModel.TIERED, "999.5", (1, "0.08")),
+    (PricingModel.TIERED, "10000", (1, "0.05")),
+    (PricingModel.TIERED, "10001", None),
+    (PricingModel.VOLUME, "0", (1000, "0.08")),
+    (PricingModel.VOLUME, "999", (1, "0.08")),
+    (PricingModel.VOLUME, "1000", (9000, "0.05")),
+    (PricingModel.VOLUME, "9999", (1, "0.05")),
+    (PricingModel.VOLUME, "10000", None),
+])
+def test_next_tier(model, qty, expected):
+    from meterbill.pricing import next_tier
+    got = next_tier(PlanComponent("m", model, tiers=_three_tiers()), Decimal(qty))
+    assert got == (None if expected is None else (expected[0], Decimal(expected[1])))
+
+
+def test_cli_quote_hints(capsys):
+    assert main(["quote", "--plan", "growth", "--meter", "api_calls", "--quantity", "1000"]) == 0
+    assert "api_calls: next tier: +1 unit at" in capsys.readouterr().out
+    assert main(["quote", "--plan", "volume", "--usage", "storage_gb=999"]) == 0
+    assert "storage_gb: next tier: +1 unit at 0.08" in capsys.readouterr().out
+    assert main(["quote", "--plan", "volume", "--usage", "storage_gb=10000"]) == 0
+    assert "storage_gb: next tier: top tier" in capsys.readouterr().out
+    assert main(["quote", "--plan", "starter", "--usage", "api_calls=5"]) == 0
+    assert "next tier" not in capsys.readouterr().out
