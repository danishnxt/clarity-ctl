+@pytest.mark.parametrize("qty,expected", [
+    ("0", "next tier: +1001 units at 0.08"),
+    ("1000", "next tier: +1 unit at 0.08"),
+    ("999.5", "next tier: +1 unit at 0.08"),
+    ("1001", "next tier: +9000 units at 0.05"),
+    ("10000", "next tier: +1 unit at 0.05"),
+    ("10001", "next tier: top tier"),
+])
+def test_next_tier_hint_graduated(qty, expected):
+    assert _hint_for("growth", "api_calls", qty) == expected
+
+
+@pytest.mark.parametrize("qty,expected", [
