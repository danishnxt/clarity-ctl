+def next_tier(component: PlanComponent, quantity: Decimal) -> tuple[Decimal, Decimal] | None:
+    """Whole units to add to ``quantity`` to reach the next tier, and that tier's unit price.
+
+    None for components that are not tiered/volume, or when ``quantity`` is
+    already in the last tier. Tiered bounds are inclusive (1000 is still tier 1,
+    so the next tier needs 1001); volume bounds are strict (1000 is tier 2).
+    Fractional gaps round up to a whole unit.
+    """
+    if component.model not in (PricingModel.TIERED, PricingModel.VOLUME):
+        return None
+    tiers = component.tiers
+    for i, tier in enumerate(tiers):
+        if tier.up_to is None:
+            return None
+        if component.model is PricingModel.TIERED:
+            if quantity <= tier.up_to:
+                needed = (tier.up_to - quantity).to_integral_value(ROUND_FLOOR) + 1
+                return needed, tiers[i + 1].unit_price
+        elif quantity < tier.up_to:
+            needed = (tier.up_to - quantity).to_integral_value(ROUND_CEILING)
+            return needed, tiers[i + 1].unit_price
+    return None
+
+
 def _amount(quantity: Decimal, unit_price: Decimal, currency: str) -> Money:
     return Money.from_major(quantity * unit_price, currency, rounding=ROUND_HALF_UP)
 
