@@ -3,7 +3,7 @@
 from __future__ import annotations
 
 from dataclasses import dataclass
-from decimal import ROUND_HALF_UP, Decimal
+from decimal import ROUND_CEILING, ROUND_FLOOR, ROUND_HALF_UP, Decimal
 
 from meterbill.money import Money
 from meterbill.plans import PlanComponent, PricingModel, Tier
@@ -91,3 +91,33 @@ def _price_volume(component: PlanComponent, quantity: Decimal, currency: str) ->
         f"{component.meter} (volume tier {number})", quantity, tier.unit_price,
         _amount(quantity, tier.unit_price, currency),
     )
+
+
+@dataclass(frozen=True, slots=True)
+class NextTier:
+    units: Decimal  # whole units to add to the quantity to land in the next tier
+    unit_price: Decimal  # that tier's price, major currency units per unit
+
+
+def next_tier(component: PlanComponent, quantity: Decimal) -> NextTier | None:
+    """The smallest whole-unit increase that reaches the next tier, or None in the top tier.
+
+    Follows the model's own boundary rule (see ``price_quantity``): for tiered
+    (inclusive bounds) the next tier starts strictly above ``up_to``; for
+    volume it starts at ``up_to`` itself. Only valid for tiered and volume components.
+    """
+    if component.model not in (PricingModel.TIERED, PricingModel.VOLUME):
+        raise ValueError(f"{component.meter!r} has no tiers")
+    if quantity < 0 or not quantity.is_finite():
+        raise ValueError(f"quantity must be finite and not negative: {quantity}")
+    tiers = component.tiers
+    volume = component.model is PricingModel.VOLUME
+    for index, tier in enumerate(tiers):
+        if tier.up_to is None or (quantity < tier.up_to if volume else quantity <= tier.up_to):
+            break
+    if tier.up_to is None:
+        return None
+    gap = tier.up_to - quantity
+    units = gap.to_integral_value(ROUND_CEILING) if volume else (
+        gap.to_integral_value(ROUND_FLOOR) + 1)
+    return NextTier(units, tiers[index + 1].unit_price)
