diff --git a/tests/test_quote.py b/tests/test_quote.py
index 1bf3250..1f3924d 100644
--- a/tests/test_quote.py
+++ b/tests/test_quote.py
@@ -131,3 +131,31 @@ def test_cli_quote_errors(args, capsys):
     assert main(["quote", *args]) == 1
     captured = capsys.readouterr()
     assert captured.err.startswith("error: ") and captured.out == ""
+
+
+@pytest.mark.parametrize("plan,meter,qty,expected", [
+    ("growth", "api_calls", "0", "next tier: +1001 units at 0.08"),
+    ("growth", "api_calls", "1000", "next tier: +1 unit at 0.08"),
+    ("growth", "api_calls", "1001", "next tier: +9000 units at 0.05"),
+    ("growth", "api_calls", "1000.5", "next tier: +9000 units at 0.05"),
+    ("growth", "api_calls", "10001", "next tier: top tier"),
+    ("volume", "storage_gb", "999", "next tier: +1 unit at 0.08"),
+    ("volume", "storage_gb", "999.5", "next tier: +1 unit at 0.08"),
+    ("volume", "storage_gb", "1000", "next tier: +9000 units at 0.05"),
+    ("volume", "storage_gb", "10000", "next tier: top tier"),
+])
+def test_next_tier_hint(capsys, plan, meter, qty, expected):
+    assert main(["quote", "--plan", plan, "--meter", meter, "--quantity", qty]) == 0
+    assert capsys.readouterr().out.rstrip().splitlines()[-1] == expected
+
+
+def test_whole_plan_hint_per_component(capsys):
+    assert main(["quote", "--plan", "volume", "--usage", "storage_gb=500"]) == 0
+    assert "storage_gb: next tier: +500 units at 0.08" in capsys.readouterr().out
+    assert main(["quote", "--plan", "volume", "--usage", "platform_fee=1"]) == 0
+    assert "storage_gb: next tier: +1000 units at 0.08" in capsys.readouterr().out
+
+
+def test_no_hint_without_tiered_components(capsys):
+    assert main(["quote", "--plan", "starter", "--usage", "platform_fee=1"]) == 0
+    assert "next tier" not in capsys.readouterr().out
