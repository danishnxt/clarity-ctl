+    return f"next tier: +{needed} {unit} at {hint.unit_price:f}"
diff --git a/tests/test_quote.py b/tests/test_quote.py
index 1bf3250..314a97a 100644
--- a/tests/test_quote.py
+++ b/tests/test_quote.py
@@ -131,3 +131,22 @@ def test_cli_quote_errors(args, capsys):
     assert main(["quote", *args]) == 1
     captured = capsys.readouterr()
     assert captured.err.startswith("error: ") and captured.out == ""
+
+
+def test_next_tier_hint_text(catalog):
+    growth, vol = catalog.plans["growth"], catalog.plans["volume"]
+
+    def hint(plan, meter, qty):
+        return quote_meter(plan, meter, Decimal(qty)).hints
+
+    from meterbill.quote import format_quote
+    assert format_quote(quote_meter(growth, "api_calls", Decimal(1000))).endswith(
+        "api_calls: next tier: +1 unit at 0.08")
+    assert format_quote(quote_meter(growth, "api_calls", Decimal(10001))).endswith(
+        "api_calls: next tier: top tier")
+    # volume bounds are exclusive: 999 -> one more unit reaches 1000
+    assert format_quote(quote_meter(vol, "storage_gb", Decimal(999))).endswith(
+        "storage_gb: next tier: +1 unit at 0.08")
+    assert format_quote(quote_plan(vol, {"storage_gb": Decimal(1000)})).endswith(
+        "storage_gb: next tier: +9000 units at 0.05")
+    assert hint(growth, "platform_fee", 1) == ()
