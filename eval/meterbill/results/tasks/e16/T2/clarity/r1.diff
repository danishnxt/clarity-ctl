--- a/meterbill/pricing.py
+++ b/meterbill/pricing.py
@@ -63,6 +63,33 @@ def price_quantity(
     )]
 
 
+@dataclass(frozen=True, slots=True)
+class NextTier:
+    units_needed: Decimal  # more units, from the quoted quantity, to land in the next tier
+    unit_price: Decimal  # major currency units per unit in that tier
+
+
+def next_tier(component: PlanComponent, quantity: Decimal) -> NextTier | None:
+    """The next price tier above ``quantity`` of a tiered or volume component.
+
+    Returns None when ``quantity`` is already in the last tier, or the
+    component is not tiered/volume. Bounds follow the pricing rules: tiered
+    tiers are inclusive, so the next tier starts at unit ``up_to + 1``
+    (whole units); volume tiers are exclusive, so the next tier starts at a
+    quantity equal to ``up_to``.
+    """
+    if component.model not in (PricingModel.TIERED, PricingModel.VOLUME):
+        return None
+    tiered = component.model is PricingModel.TIERED
+    for index, tier in enumerate(component.tiers):
+        if tier.up_to is None:
+            return None
+        if quantity <= tier.up_to if tiered else quantity < tier.up_to:
+            start = tier.up_to + 1 if tiered else tier.up_to
+            return NextTier(start - quantity, component.tiers[index + 1].unit_price)
+    return None
+
+
 def _amount(quantity: Decimal, unit_price: Decimal, currency: str) -> Money:
     return Money.from_major(quantity * unit_price, currency, rounding=ROUND_HALF_UP)
 
