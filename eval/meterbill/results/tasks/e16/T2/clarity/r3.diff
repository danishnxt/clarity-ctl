@@ -25,6 +25,34 @@ def tier_span(lower: Decimal, tier: Tier) -> str:
     return f"{first}+" if tier.up_to is None else f"{first}-{tier.up_to:f}"
 
 
+@dataclass(frozen=True, slots=True)
+class NextTier:
+    """What it takes to move from a quantity into the next price tier."""
+
+    units: Decimal  # more units needed
+    unit_price: Decimal  # the next tier's price, major currency units per unit
+
+
+def next_tier(component: PlanComponent, quantity: Decimal) -> NextTier | None:
+    """Units still needed to reach the next tier of a tiered or volume component.
+
+    None when the quantity is already in the last tier. Follows the same bounds
+    as price_quantity: tiered bounds are inclusive (a quantity above a tier's
+    ``up_to`` is in the next tier), volume bounds exclusive (a quantity equal to
+    ``up_to`` is already in the next tier). Only for tiered and volume components.
+    """
+    if component.model not in (PricingModel.TIERED, PricingModel.VOLUME):
+        raise ValueError(f"{component.meter!r} has no tiers")
+    volume = component.model is PricingModel.VOLUME
+    for index, tier in enumerate(component.tiers):
+        if tier.up_to is None or (quantity < tier.up_to if volume else quantity <= tier.up_to):
+            break
+    if tier.up_to is None:
+        return None
+    needed = tier.up_to - quantity if volume else tier.up_to + 1 - quantity
+    return NextTier(needed, component.tiers[index + 1].unit_price)
+
+
 def price_quantity(
     component: PlanComponent, quantity: Decimal, currency: str | None = None
 ) -> list[PricedPart]:
