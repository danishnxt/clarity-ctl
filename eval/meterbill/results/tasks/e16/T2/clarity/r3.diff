+    ("growth", "api_calls", "10001", "api_calls: next tier: top tier"),
+    ("volume", "storage_gb", "999", "storage_gb: next tier: +1 unit at 0.08"),
+    ("volume", "storage_gb", "1000", "storage_gb: next tier: +9000 units at 0.05"),
+    ("volume", "storage_gb", "10000", "storage_gb: next tier: top tier"),
