diff --git a/meterbill/pricing.py b/meterbill/pricing.py
index 8173df5..db3aecb 100644
--- a/meterbill/pricing.py
+++ b/meterbill/pricing.py
@@ -91,3 +91,32 @@ def _price_volume(component: PlanComponent, quantity: Decimal, currency: str) ->
         f"{component.meter} (volume tier {number})", quantity, tier.unit_price,
         _amount(quantity, tier.unit_price, currency),
     )
+
+
+@dataclass(frozen=True, slots=True)
+class NextTier:
+    """How far a quantity is from the next price tier; None from ``next_tier`` means top tier."""
+    units_needed: Decimal
+    unit_price: Decimal  # major currency units per unit, of the next tier
+
+
+def next_tier(component: PlanComponent, quantity: Decimal) -> NextTier | None:
+    """The next tier above ``quantity`` for a tiered or volume component.
+
+    Returns None when ``quantity`` is already in the last tier. Bounds follow
+    the pricing rules: for tiered (inclusive) the next tier starts at
+    ``up_to + 1``; for volume (exclusive) it starts at ``up_to`` itself.
+    Other models have no tiers and raise ValueError.
+    """
+    if component.model not in (PricingModel.TIERED, PricingModel.VOLUME):
+        raise ValueError(f"{component.meter!r} has no tiers")
+    if quantity < 0 or not quantity.is_finite():
+        raise ValueError(f"quantity must be finite and not negative: {quantity}")
+    inclusive = component.model is PricingModel.TIERED
+    for index, tier in enumerate(component.tiers):
+        if tier.up_to is None:
+            return None
+        if (quantity <= tier.up_to) if inclusive else (quantity < tier.up_to):
+            start = tier.up_to + 1 if inclusive else tier.up_to
+            return NextTier(start - quantity, component.tiers[index + 1].unit_price)
+    return None
