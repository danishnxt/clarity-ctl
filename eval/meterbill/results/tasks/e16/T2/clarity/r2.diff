+def _next_tier_hint(component, quantity: Decimal) -> str:
+    nxt = next_tier(component, quantity)
+    if nxt is None:
+        return "next tier: top tier"
+    units = f"{nxt.units_needed.normalize():f}"
+    noun = "unit" if nxt.units_needed == 1 else "units"
+    return f"next tier: +{units} {noun} at {nxt.unit_price:f}"
 
 
