diff --git a/tests/test_quote.py b/tests/test_quote.py
index 1bf3250..c5b8d90 100644
--- a/tests/test_quote.py
+++ b/tests/test_quote.py
@@ -131,3 +131,26 @@ def test_cli_quote_errors(args, capsys):
     assert main(["quote", *args]) == 1
     captured = capsys.readouterr()
     assert captured.err.startswith("error: ") and captured.out == ""
+
+
+def test_next_tier_hints():
+    from meterbill.pricing import next_tier
+    from meterbill.quote import _next_tier_hint
+    tiers = (Tier(Decimal(1000), Decimal("0.10")), Tier(Decimal(5000), Decimal("0.08")),
+             Tier(None, Decimal("0.05")))
+    tiered = PlanComponent("m", PricingModel.TIERED, tiers=tiers)
+    volume = PlanComponent("m", PricingModel.VOLUME, tiers=tiers)
+    h = lambda c, q: _next_tier_hint(c, Decimal(q))
+    # tiered: unit 1001 is the first at tier 2
+    assert h(tiered, 1000) == "next tier: +1 unit at 0.08"
+    assert h(tiered, 990) == "next tier: +11 units at 0.08"
+    assert h(tiered, 0) == "next tier: +1001 units at 0.08"
+    assert h(tiered, 1001) == "next tier: +4000 units at 0.05"
+    assert h(tiered, 5001) == "next tier: top tier"
+    # volume: a total of 1000 already prices at tier 2
+    assert h(volume, 999) == "next tier: +1 unit at 0.08"
+    assert h(volume, 1000) == "next tier: +4000 units at 0.05"
+    assert h(volume, 5000) == "next tier: top tier"
+    flat = PlanComponent("f", PricingModel.PER_UNIT, unit_price=Decimal(1))
+    with pytest.raises(ValueError):
+        next_tier(flat, Decimal(1))
