diff --git a/tests/test_ingest.py b/tests/test_ingest.py
index f4ebf60..8d75e25 100644
--- a/tests/test_ingest.py
+++ b/tests/test_ingest.py
@@ -298,3 +298,48 @@ def test_invoice_reads_from_store_when_events_omitted(data_dir, drop, capsys):
     assert "1800.15 EUR" in from_store
     # a tenant or period with no stored events yields an empty invoice, not an error
     assert main(args("2026-08")) == 0
+
+
+def write_envelope(path, events, **extra):
+    doc = {"batch_id": "b1", "sent_at": "2026-10-05T10:00:00Z", "device_id": "d1",
+           "events": events, **extra}
+    path.write_text(json.dumps(doc))
+
+
+def test_envelope_file_is_stored_and_moved(drop, data):
+    write_envelope(drop / "a.envelope.json",
+                   [event_record(), event_record(event_id="e2", idempotency_key="k2")])
+    counts = ingest_drop(drop, data)
+    assert (counts["NWD"].accepted, counts["NWD"].duplicate, counts["NWD"].rejected) == (2, 0, 0)
+    assert [r["event_id"] for r in store_lines(data)] == ["e1", "e2"]
+    assert (drop / "processed" / "a.envelope.json").exists()
+
+
+def test_envelope_dedupes_across_formats_and_rejects_bad_events(drop, data):
+    write_jsonl(drop / "a.jsonl", event_record())
+    write_envelope(drop / "b.envelope.json",
+                   [event_record(event_id="x"), event_record(event_id="e2", idempotency_key=""),
+                    "nope", event_record(event_id="e3", idempotency_key="k3")])
+    counts = ingest_drop(drop, data)
+    assert (counts["NWD"].accepted, counts["NWD"].duplicate) == (2, 1)
+    assert counts["NWD"].rejected == 1 and counts["(unknown)"].rejected == 1
+    assert sorted(r["line"] for r in rejects(data)) == [2, 3]
+
+
+@pytest.mark.parametrize("text", ["{not json", "[]", '{"batch_id": "b"}', '{"events": {}}'])
+def test_bad_envelope_rejects_file(drop, data, text):
+    (drop / "bad.envelope.json").write_text(text)
+    counts = ingest_drop(drop, data)
+    assert counts["(unknown)"].rejected == 1
+    assert [r["line"] for r in rejects(data)] == [0]
+    assert not data.joinpath("events").exists()
+
+
+def test_check_handles_envelopes_and_plain_json_is_ignored(drop, data):
+    write_envelope(drop / "a.envelope.json", [event_record()])
+    (drop / "other.json").write_text("{}")
+    before = snapshot(drop)
+    assert main(["ingest", "--check", str(drop), "--data-dir", str(data)]) == 0
+    assert snapshot(drop) == before and not data.exists()
+    ingest_drop(drop, data)
+    assert (drop / "other.json").exists() and len(store_lines(data)) == 1
