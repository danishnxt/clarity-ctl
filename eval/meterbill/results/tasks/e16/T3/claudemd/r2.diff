@@ -20,6 +20,7 @@ MISSING_KEY_REASON = "missing idempotency_key"
 # idempotency_key is not required in the header: rows without it are rejected one by one.
 CSV_COLUMNS = ("tenant_id", "meter", "quantity", "timestamp", "event_id")
 _SUFFIXES = {".jsonl", ".csv"}
+ENVELOPE_SUFFIX = ".envelope.json"
 
 
 @dataclass
@@ -103,6 +104,26 @@ def _csv_rows(path: Path) -> Iterator[_Row]:
             yield _validate(record, line)
 
 
+def _envelope_rows(path: Path) -> Iterator[_Row]:
+    """One batch envelope: ``{"batch_id", "sent_at", "device_id", "events": [...]}``.
+
+    Row line = 1-based position in ``events``. Envelope-level problems give one reject at
+    line 0 and store nothing. Envelope fields are not copied into events.
+    """
+    with open(path, encoding="utf-8-sig") as handle:
+        text = handle.read()
+    try:
+        doc = json.loads(text, parse_float=Decimal)
+    except json.JSONDecodeError as exc:
+        yield _Row(0, text, error=f"invalid JSON ({exc.msg})")
+        return
+    if not isinstance(doc, dict) or not isinstance(doc.get("events"), list):
+        yield _Row(0, doc, error="envelope must be an object with an events list")
+        return
+    for position, record in enumerate(doc["events"], start=1):
+        yield _validate(record, position)
+
+
 def _tenant_of(row: _Row) -> str:
     if row.event is not None:
         return row.event.tenant_id
