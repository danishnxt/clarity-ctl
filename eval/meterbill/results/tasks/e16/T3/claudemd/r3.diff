 _SUFFIXES = {".jsonl", ".csv"}
+ENVELOPE_SUFFIX = ".envelope.json"
 
 
 @dataclass
@@ -103,6 +104,25 @@ def _csv_rows(path: Path) -> Iterator[_Row]:
             yield _validate(record, line)
 
 
+def _envelope_rows(path: Path) -> Iterator[_Row]:
+    """Batch envelope: ``{"batch_id", "sent_at", "device_id", "events": [...]}``.
+
+    Each event is one row; its "line" is its 1-based position in ``events``.
+    A bad envelope (invalid JSON, not an object, no ``events`` list) is one reject at line 0.
+    """
+    with open(path, encoding="utf-8-sig") as handle:
+        try:
+            doc = json.load(handle, parse_float=Decimal)
+        except json.JSONDecodeError as exc:
+            yield _Row(0, None, error=f"invalid JSON ({exc.msg})")
+            return
+    if not isinstance(doc, dict) or not isinstance(doc.get("events"), list):
+        yield _Row(0, None, error="envelope must be an object with an events list")
+        return
+    for number, record in enumerate(doc["events"], start=1):
+        yield _validate(record, number)
+
+
 def _tenant_of(row: _Row) -> str:
     if row.event is not None:
         return row.event.tenant_id
