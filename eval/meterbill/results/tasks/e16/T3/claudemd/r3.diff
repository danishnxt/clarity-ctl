diff --git a/tests/test_ingest.py b/tests/test_ingest.py
index f4ebf60..ce3e496 100644
--- a/tests/test_ingest.py
+++ b/tests/test_ingest.py
@@ -298,3 +298,40 @@ def test_invoice_reads_from_store_when_events_omitted(data_dir, drop, capsys):
     assert "1800.15 EUR" in from_store
     # a tenant or period with no stored events yields an empty invoice, not an error
     assert main(args("2026-08")) == 0
+
+
+def write_envelope(path, events, **extra):
+    doc = {"batch_id": "b1", "sent_at": "2026-10-02T00:00:00Z", "device_id": "d1", "events": events, **extra}
+    path.write_text(json.dumps(doc))
+
+
+def test_envelope_events_are_stored_deduped_and_moved(drop, data):
+    write_envelope(drop / "m.envelope.json", [
+        event_record(), event_record(event_id="e2", idempotency_key="k2"),
+        event_record(event_id="e3"), {"tenant_id": "NWD"}])
+    counts = ingest_drop(drop, data)
+    c = counts["NWD"]
+    assert (c.accepted, c.duplicate, c.rejected) == (2, 1, 1)
+    assert [r["event_id"] for r in store_lines(data)] == ["e1", "e2"]
+    assert (drop / "processed" / "m.envelope.json").exists()
+    assert rejects(data)[0]["file"] == "m.envelope.json" and rejects(data)[0]["line"] == 4
+
+
+def test_envelope_dry_run_writes_nothing(drop, data):
+    write_envelope(drop / "m.envelope.json", [event_record()])
+    assert ingest_drop(drop, data, dry_run=True)["NWD"].accepted == 1
+    assert (drop / "m.envelope.json").exists() and not (data / "events").exists()
+
+
+@pytest.mark.parametrize("body", ["{oops", "[]", '{"batch_id": "x"}', '{"events": {}}'])
+def test_bad_envelope_is_one_reject(drop, data, body):
+    (drop / "m.envelope.json").write_text(body)
+    counts = ingest_drop(drop, data)
+    assert counts["(unknown)"].rejected == 1
+    assert len(rejects(data)) == 1
+
+
+def test_plain_json_files_still_ignored(drop, data):
+    (drop / "other.json").write_text("{}")
+    assert ingest_drop(drop, data) == {}
+    assert (drop / "other.json").exists()
