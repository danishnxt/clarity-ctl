diff --git a/tests/test_ingest.py b/tests/test_ingest.py
index f4ebf60..92ca545 100644
--- a/tests/test_ingest.py
+++ b/tests/test_ingest.py
@@ -298,3 +298,46 @@ def test_invoice_reads_from_store_when_events_omitted(data_dir, drop, capsys):
     assert "1800.15 EUR" in from_store
     # a tenant or period with no stored events yields an empty invoice, not an error
     assert main(args("2026-08")) == 0
+
+
+def write_envelope(path, events, **extra):
+    doc = {"batch_id": "b1", "sent_at": "2026-10-02T00:00:00Z", "device_id": "d1", **extra}
+    path.write_text(json.dumps({**doc, "events": events}))
+
+
+def test_envelope_file_is_stored(drop, data):
+    write_envelope(drop / "a.envelope.json",
+                   [event_record(), event_record(event_id="e2", idempotency_key="k2")])
+    (drop / "other.json").write_text("{}")
+    counts = ingest_drop(drop, data)
+    assert counts["NWD"].accepted == 2
+    assert len(store_lines(data)) == 2
+    assert (drop / "processed" / "a.envelope.json").exists()
+    assert (drop / "other.json").exists()
+
+
+def test_envelope_bad_events_rejected_with_position(drop, data):
+    bad = event_record(event_id="e3")
+    del bad["idempotency_key"]
+    write_envelope(drop / "a.envelope.json",
+                   [event_record(), event_record(quantity="abc", event_id="e2"), bad])
+    counts = ingest_drop(drop, data)
+    assert counts["NWD"].accepted == 1 and counts["NWD"].rejected == 2
+    assert [(r["line"], r["file"]) for r in rejects(data)] == [(2, "a.envelope.json"), (3, "a.envelope.json")]
+    assert rejects(data)[1]["reason"] == "missing idempotency_key"
+
+
+def test_envelope_duplicates_and_dry_run(drop, data):
+    write_envelope(drop / "a.envelope.json", [event_record(), event_record(event_id="e9")])
+    counts = ingest_drop(drop, data, dry_run=True)
+    assert counts["NWD"].accepted == 1 and counts["NWD"].duplicate == 1
+    assert (drop / "a.envelope.json").exists() and not (data / "events").exists()
+
+
+@pytest.mark.parametrize("content", ["not json", "[]", '{"batch_id": "x"}', '{"events": {}}'])
+def test_invalid_envelope_is_one_reject(drop, data, content):
+    (drop / "a.envelope.json").write_text(content)
+    counts = ingest_drop(drop, data)
+    assert counts["(unknown)"].rejected == 1
+    assert [r["line"] for r in rejects(data)] == [1]
+    assert (drop / "processed" / "a.envelope.json").exists()
