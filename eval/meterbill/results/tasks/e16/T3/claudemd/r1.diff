 @dataclass
@@ -103,6 +108,26 @@ def _csv_rows(path: Path) -> Iterator[_Row]:
             yield _validate(record, line)
 
 
+def _envelope_rows(path: Path) -> Iterator[_Row]:
+    """Batch envelope: one JSON object whose ``events`` list holds the event records.
+
+    Row "line" numbers are 1-based positions in ``events``. A file that is not a
+    valid envelope gives a single reject at line 1 and stores nothing.
+    """
+    with open(path, encoding="utf-8-sig") as handle:
+        text = handle.read()
+    try:
+        doc = json.loads(text, parse_float=Decimal)
+    except json.JSONDecodeError as exc:
+        yield _Row(1, text[:200], error=f"invalid JSON ({exc.msg})")
+        return
+    if not isinstance(doc, dict) or not isinstance(doc.get("events"), list):
+        yield _Row(1, None, error="envelope must be an object with an events list")
+        return
+    for position, record in enumerate(doc["events"], start=1):
+        yield _validate(record, position)
+
+
 def _tenant_of(row: _Row) -> str:
