+def _envelope_rows(path: Path) -> Iterator[_Row]:
+    """Rows of a batch envelope; ``line`` is the 1-based position in ``events``."""
+    with open(path, encoding="utf-8-sig") as handle:
+        try:
+            doc = json.load(handle, parse_float=Decimal)
+        except json.JSONDecodeError as exc:
+            yield _Row(0, None, error=f"invalid JSON ({exc.msg})")
+            return
+    if not isinstance(doc, dict) or not isinstance(doc.get("events"), list):
+        yield _Row(0, doc, error="envelope must be an object with an events list")
+        return
+    for number, record in enumerate(doc["events"], start=1):
+        yield _validate(record, number)
+
