diff --git a/tests/test_ingest.py b/tests/test_ingest.py
index f4ebf60..b6f3f3c 100644
--- a/tests/test_ingest.py
+++ b/tests/test_ingest.py
@@ -298,3 +298,25 @@ def test_invoice_reads_from_store_when_events_omitted(data_dir, drop, capsys):
     assert "1800.15 EUR" in from_store
     # a tenant or period with no stored events yields an empty invoice, not an error
     assert main(args("2026-08")) == 0
+
+
+def test_envelope_file_is_stored_checked_and_moved(drop, data):
+    env = {"batch_id": "b1", "sent_at": "2026-10-05T00:00:00Z", "device_id": "d1",
+           "events": [event_record(), event_record(event_id="e2", idempotency_key="k2"),
+                      event_record(event_id="e3", idempotency_key="")]}
+    (drop / "m.envelope.json").write_text(json.dumps(env))
+    (drop / "other.json").write_text("{}")
+    dry = ingest_drop(drop, data, dry_run=True)
+    assert (dry["NWD"].accepted, dry["NWD"].rejected) == (2, 1)
+    assert (drop / "m.envelope.json").exists() and not data.exists()
+    counts = ingest_drop(drop, data)
+    assert (counts["NWD"].accepted, counts["NWD"].rejected) == (2, 1)
+    assert [r["event_id"] for r in store_lines(data)] == ["e1", "e2"]
+    assert rejects(data)[0]["line"] == 3
+    assert (drop / "processed" / "m.envelope.json").exists() and (drop / "other.json").exists()
+
+
+def test_malformed_envelope_is_one_reject(drop, data):
+    (drop / "bad.envelope.json").write_text('{"events": 5}')
+    counts = ingest_drop(drop, data)
+    assert counts["(unknown)"].rejected == 1
