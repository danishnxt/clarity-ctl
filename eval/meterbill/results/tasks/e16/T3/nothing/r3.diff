diff --git a/tests/test_ingest.py b/tests/test_ingest.py
index f4ebf60..364f5d6 100644
--- a/tests/test_ingest.py
+++ b/tests/test_ingest.py
@@ -298,3 +298,35 @@ def test_invoice_reads_from_store_when_events_omitted(data_dir, drop, capsys):
     assert "1800.15 EUR" in from_store
     # a tenant or period with no stored events yields an empty invoice, not an error
     assert main(args("2026-08")) == 0
+
+
+def write_envelope(path, events, **extra):
+    envelope = {"batch_id": "b1", "sent_at": "2026-10-06T00:00:00+00:00", "device_id": "d1",
+                "events": events, **extra}
+    path.write_text(json.dumps(envelope))
+
+
+def test_envelope_file_is_stored_deduped_and_moved(drop, data):
+    write_envelope(drop / "a.envelope.json",
+                   [event_record(), event_record(event_id="e2", idempotency_key="k2"),
+                    event_record(event_id="e3", quantity="-1"), event_record()])
+    (drop / "plain.json").write_text("{}")
+    counts = ingest_drop(drop, data, RejectLog(data / "rejects", date(2026, 11, 2)))
+    assert (counts["NWD"].accepted, counts["NWD"].duplicate, counts["NWD"].rejected) == (2, 1, 1)
+    assert (drop / "processed" / "a.envelope.json").exists() and (drop / "plain.json").exists()
+    entry = rejects(data)[0]
+    assert (entry["file"], entry["line"]) == ("a.envelope.json", 3)
+
+
+def test_malformed_envelopes_are_rejected(drop, data):
+    (drop / "a.envelope.json").write_text("{nope")
+    (drop / "b.envelope.json").write_text(json.dumps({"events": "x"}))
+    counts = ingest_drop(drop, data)
+    assert counts["(unknown)"].rejected == 2
+
+
+def test_check_counts_envelopes_without_moving(drop, data, capsys):
+    write_envelope(drop / "a.envelope.json", [event_record()])
+    assert main(["ingest", "--check", str(drop), "--data-dir", str(data)]) == 0
+    assert "NWD" in capsys.readouterr().out
+    assert (drop / "a.envelope.json").exists()
