diff --git a/tests/test_ingest.py b/tests/test_ingest.py
index f4ebf60..1291b8b 100644
--- a/tests/test_ingest.py
+++ b/tests/test_ingest.py
@@ -298,3 +298,36 @@ def test_invoice_reads_from_store_when_events_omitted(data_dir, drop, capsys):
     assert "1800.15 EUR" in from_store
     # a tenant or period with no stored events yields an empty invoice, not an error
     assert main(args("2026-08")) == 0
+
+
+def write_envelope(path, events):
+    path.write_text(json.dumps({"batch_id": "b1", "sent_at": "2026-10-05T00:00:00Z",
+                                "device_id": "d1", "events": events}))
+
+
+def test_envelope_file_is_stored_and_moved(drop, data):
+    write_envelope(drop / "b1.envelope.json",
+                   [event_record(), event_record(event_id="e2", idempotency_key="k2")])
+    counts = ingest_drop(drop, data)
+    assert (counts["NWD"].accepted, counts["NWD"].rejected) == (2, 0)
+    assert [r["event_id"] for r in store_lines(data)] == ["e1", "e2"]
+    assert (drop / "processed" / "b1.envelope.json").exists()
+
+
+def test_envelope_bad_events_are_rejected_and_plain_json_ignored(drop, data):
+    write_envelope(drop / "b2.envelope.json",
+                   [event_record(), event_record(event_id="e2", idempotency_key=""), "junk"])
+    (drop / "other.json").write_text("{}")
+    counts = ingest_drop(drop, data)
+    assert counts["NWD"].accepted == 1 and counts["NWD"].rejected == 1
+    assert counts["(unknown)"].rejected == 1
+    assert sorted(r["line"] for r in rejects(data)) == [2, 3]
+    assert (drop / "other.json").exists()
+
+
+def test_envelope_malformed_and_check_mode(drop, data):
+    (drop / "bad.envelope.json").write_text("{nope")
+    write_envelope(drop / "ok.envelope.json", [event_record()])
+    counts = ingest_drop(drop, data, dry_run=True)
+    assert counts["NWD"].accepted == 1 and counts["(unknown)"].rejected == 1
+    assert (drop / "ok.envelope.json").exists() and not data.exists()
