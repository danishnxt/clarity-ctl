+def _envelope_rows(path: Path) -> Iterator[_Row]:
+    """Rows of a ``*.envelope.json`` batch; ``line`` is the 1-based index in ``events``."""
+    with open(path, encoding="utf-8-sig") as handle:
+        text = handle.read()
+    try:
+        envelope = json.loads(text, parse_float=Decimal)
+    except json.JSONDecodeError as exc:
+        yield _Row(exc.lineno, text[:200], error=f"invalid JSON ({exc.msg})")
+        return
+    if not isinstance(envelope, dict):
+        yield _Row(0, envelope, error="envelope is not a JSON object")
+        return
+    events = envelope.get("events")
+    if not isinstance(events, list):
+        yield _Row(0, {k: v for k, v in envelope.items() if k != "events"},
+                   error="envelope events is not a list")
+        return
+    for number, record in enumerate(events, start=1):
+        yield _validate(record, number)
+
+
