@@ -298,3 +298,29 @@ def test_invoice_reads_from_store_when_events_omitted(data_dir, drop, capsys):
     assert "1800.15 EUR" in from_store
     # a tenant or period with no stored events yields an empty invoice, not an error
     assert main(args("2026-08")) == 0
+
+
+def test_envelope_file_ingested_with_rejects_and_dedupe(drop, data):
+    good = event_record(event_id="e1", idempotency_key="k1")
+    dup = event_record(event_id="e2", idempotency_key="k1")
+    bad = event_record(event_id="e3", idempotency_key="k3", quantity="x")
+    env = {"batch_id": "b1", "sent_at": "2026-10-05T10:00:00Z", "device_id": "d1",
+           "events": [good, dup, bad]}
+    (drop / "b1.envelope.json").write_text(json.dumps(env))
+    counts = ingest_drop(drop, data)
+    assert (counts["NWD"].accepted, counts["NWD"].duplicate, counts["NWD"].rejected) == (1, 1, 1)
+    assert rejects(data)[0]["file"] == "b1.envelope.json"
+    assert rejects(data)[0]["line"] == 3
+    assert (drop / "processed" / "b1.envelope.json").exists()
+
+
+def test_envelope_check_is_dry_run_and_malformed_rejected(drop, data):
+    (drop / "a.envelope.json").write_text(json.dumps(
+        {"events": [event_record(idempotency_key="k9")]}))
+    (drop / "b.envelope.json").write_text("{nope")
+    (drop / "c.envelope.json").write_text(json.dumps({"events": "x"}))
+    counts = ingest_drop(drop, data, dry_run=True)
+    assert counts["NWD"].accepted == 1
+    assert counts["(unknown)"].rejected == 2
+    assert (drop / "a.envelope.json").exists()
+    assert not (data / "events").exists()
