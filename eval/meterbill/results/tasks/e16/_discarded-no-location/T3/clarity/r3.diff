diff --git a/tests/test_ingest.py b/tests/test_ingest.py
index f4ebf60..8c834cc 100644
--- a/tests/test_ingest.py
+++ b/tests/test_ingest.py
@@ -298,3 +298,49 @@ def test_invoice_reads_from_store_when_events_omitted(data_dir, drop, capsys):
     assert "1800.15 EUR" in from_store
     # a tenant or period with no stored events yields an empty invoice, not an error
     assert main(args("2026-08")) == 0
+
+
+def write_envelope(path, events, **extra):
+    path.write_text(json.dumps({"batch_id": "b1", "sent_at": "2026-10-05T10:00:00Z",
+                                "device_id": "d1", **extra, "events": events}))
+
+
+def test_envelope_file_is_stored_and_moved(drop, data):
+    write_envelope(drop / "a.envelope.json",
+                   [event_record(), event_record(event_id="e2", idempotency_key="k2", quantity="2.50")])
+    counts = ingest_drop(drop, data)
+    assert (counts["NWD"].accepted, counts["NWD"].duplicate, counts["NWD"].rejected) == (2, 0, 0)
+    assert [r["event_id"] for r in store_lines(data)] == ["e1", "e2"]
+    assert (drop / "processed" / "a.envelope.json").exists()
+    assert not (drop / "a.envelope.json").exists()
+
+
+def test_envelope_bad_events_rejected_with_position_and_dups_counted(drop, data):
+    write_jsonl(drop / "a.jsonl", event_record())
+    write_envelope(drop / "b.envelope.json",
+                   [event_record(), event_record(event_id="e2", idempotency_key="k2"), "nope",
+                    event_record(event_id="e3", idempotency_key="")])
+    counts = ingest_drop(drop, data)
+    assert (counts["NWD"].accepted, counts["NWD"].duplicate, counts["NWD"].rejected) == (2, 1, 1)
+    assert counts["(unknown)"].rejected == 1
+    assert sorted(r["line"] for r in rejects(data)) == [3, 4]
+
+
+@pytest.mark.parametrize("body", ["{not json", "[1, 2]", '{"batch_id": "x"}', '{"events": {}}'])
+def test_malformed_envelope_is_one_reject(drop, data, body):
+    (drop / "a.envelope.json").write_text(body)
+    counts = ingest_drop(drop, data)
+    assert counts["(unknown)"].rejected == 1 and len(rejects(data)) == 1
+    assert (drop / "processed" / "a.envelope.json").exists()
+
+
+def test_plain_json_files_are_still_ignored(drop, data):
+    (drop / "a.json").write_text("{}")
+    assert ingest_drop(drop, data) == {}
+    assert (drop / "a.json").exists()
+
+
+def test_check_accepts_envelopes_without_writing(drop, data):
+    write_envelope(drop / "a.envelope.json", [event_record()])
+    assert main(["ingest", "--check", str(drop), "--data-dir", str(data)]) == 0
+    assert (drop / "a.envelope.json").exists() and not (data / "events").exists()
