+def _envelope_rows(path: Path) -> Iterator[_Row]:
+    """Rows of a ``*.envelope.json`` batch: ``{"batch_id", "sent_at", "device_id", "events": [...]}``.
+
+    Each event is validated like a JSONL record; its ``line`` is its 1-based position in
+    ``events``. A file that is not a JSON object with an ``events`` list is one reject at
+    line 0 and nothing from it is stored.
+    """
+    with open(path, encoding="utf-8-sig") as handle:
+        text = handle.read()
+    try:
+        envelope = json.loads(text, parse_float=Decimal)
+    except json.JSONDecodeError as exc:
+        yield _Row(0, text[:200], error=f"invalid JSON ({exc.msg})")
+        return
+    if not isinstance(envelope, dict) or not isinstance(envelope.get("events"), list):
+        yield _Row(0, envelope if isinstance(envelope, dict) else text[:200],
+                   error="envelope must be an object with an 'events' list")
+        return
+    for number, record in enumerate(envelope["events"], start=1):
+        yield _validate(record, number)
+
+
 def _csv_rows(path: Path) -> Iterator[_Row]:
     with open(path, encoding="utf-8-sig", newline="") as handle:
         reader = csv.reader(handle)
