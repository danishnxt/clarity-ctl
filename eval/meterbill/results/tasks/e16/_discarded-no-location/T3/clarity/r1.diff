diff --git a/tests/test_ingest.py b/tests/test_ingest.py
index f4ebf60..72e8d65 100644
--- a/tests/test_ingest.py
+++ b/tests/test_ingest.py
@@ -298,3 +298,49 @@ def test_invoice_reads_from_store_when_events_omitted(data_dir, drop, capsys):
     assert "1800.15 EUR" in from_store
     # a tenant or period with no stored events yields an empty invoice, not an error
     assert main(args("2026-08")) == 0
+
+
+def write_envelope(path, events, **extra):
+    envelope = {"batch_id": "b1", "sent_at": "2026-10-05T10:00:00Z", "device_id": "d1", "events": events}
+    envelope.update(extra)
+    path.write_text(json.dumps(envelope), encoding="utf-8")
+
+
+def test_envelope_file_is_stored_and_moved(drop, data):
+    write_envelope(drop / "b1.envelope.json", [event_record(), event_record(event_id="e2", idempotency_key="k2")])
+    counts = ingest_drop(drop, data)
+    assert (counts["NWD"].accepted, counts["NWD"].rejected) == (2, 0)
+    assert [r["event_id"] for r in store_lines(data)] == ["e1", "e2"]
+    assert (drop / "processed" / "b1.envelope.json").exists()
+
+
+def test_plain_json_files_are_still_ignored(drop, data):
+    write_envelope(drop / "b1.json", [event_record()])
+    assert ingest_drop(drop, data) == {}
+    assert (drop / "b1.json").exists()
+
+
+def test_envelope_bad_events_are_rejected_with_position(drop, data):
+    write_envelope(drop / "b1.envelope.json",
+                   [event_record(), "nope", event_record(event_id="e3", idempotency_key="")])
+    counts = ingest_drop(drop, data)
+    assert (counts["NWD"].accepted, counts["NWD"].rejected) == (1, 1)
+    assert sorted(r["line"] for r in rejects(data)) == [2, 3]
+
+
+@pytest.mark.parametrize("body", ["{broken", "[]", '{"batch_id": "x"}', '{"events": {}}'])
+def test_malformed_envelope_is_rejected_whole(drop, data, body):
+    (drop / "b.envelope.json").write_text(body, encoding="utf-8")
+    counts = ingest_drop(drop, data)
+    assert counts["(unknown)"].rejected == 1
+    assert len(rejects(data)) == 1 and (drop / "processed" / "b.envelope.json").exists()
+
+
+def test_envelope_dedupes_against_jsonl_and_check_is_dry(drop, data, capsys):
+    write_jsonl(drop / "a.jsonl", event_record())
+    ingest_drop(drop, data)
+    write_envelope(drop / "b.envelope.json", [event_record(event_id="e9"), event_record(event_id="e2", idempotency_key="k2")])
+    assert main(["ingest", "--check", str(drop), "--data-dir", str(data)]) == 0
+    assert (drop / "b.envelope.json").exists() and len(store_lines(data)) == 1
+    counts = ingest_drop(drop, data)
+    assert (counts["NWD"].accepted, counts["NWD"].duplicate) == (1, 1)
