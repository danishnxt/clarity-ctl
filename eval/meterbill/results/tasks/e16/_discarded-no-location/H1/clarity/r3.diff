+def credit_note_postings(note: CreditNote) -> list[Posting]:
+    """The balanced reversal of a credit note: it undoes what the invoice posted.
+
+    Revenue and tax are debited and receivable credited, each line to the
+    revenue account recorded on the line (never today's meter mapping, which
+    accounting may have changed since). A line without a recorded account, from
+    an invoice built before accounts were recorded, is an error: guessing could
+    reverse revenue out of the wrong account.
+    """
+    number, day, zero = note.number, note.issue_date.isoformat(), Money.zero(note.currency)
+    postings = [Posting(number, day, RECEIVABLE_ACCOUNT, zero, -note.total)]
+    for line in note.lines:
+        if not line.revenue_account:
+            raise ExportError(
+                f"{number}: line {line.invoice_line} ({line.meter!r}) has no recorded "
+                f"revenue account (invoice {note.invoice_number} predates it)"
+            )
+        postings.append(Posting(number, day, line.revenue_account, -line.amount, zero))
+        if line.tax_amount.minor != 0:
+            if not line.country:
+                raise ExportError(f"{number}: line for {line.meter!r} has tax but no country")
+            postings.append(Posting(number, day, TAX_ACCOUNT_PREFIX + line.country,
+                                    -line.tax_amount, zero))
+    return postings
+
+
