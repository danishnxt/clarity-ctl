@@ -91,3 +91,34 @@ def _price_volume(component: PlanComponent, quantity: Decimal, currency: str) ->
         f"{component.meter} (volume tier {number})", quantity, tier.unit_price,
         _amount(quantity, tier.unit_price, currency),
     )
+
+
+@dataclass(frozen=True, slots=True)
+class NextTier:
+    units_needed: Decimal  # extra units on top of the quantity to reach the next tier
+    unit_price: Decimal  # major currency units per unit in that tier
+
+
+def next_tier(component: PlanComponent, quantity: Decimal) -> NextTier | None:
+    """How far ``quantity`` is from the next price tier of a tiered or volume component.
+
+    None when the component has no tiers to climb (flat, per_unit) or the
+    quantity is already in the last tier. Tiered bounds are inclusive, so the
+    next tier starts at the unit after ``up_to``; volume bounds are exclusive,
+    so it starts at ``up_to`` itself.
+    """
+    if component.model not in (PricingModel.TIERED, PricingModel.VOLUME):
+        return None
+    tiers = component.tiers
+    for index, tier in enumerate(tiers):
+        if tier.up_to is None:
+            return None
+        if component.model is PricingModel.TIERED:
+            start = tier.up_to + 1
+            current = quantity <= tier.up_to
+        else:
+            start = tier.up_to
+            current = quantity < tier.up_to
+        if current:
+            return NextTier(start - quantity, tiers[index + 1].unit_price)
+    return None
