+
+
+def _comp(model, tiers):
+    return PlanComponent(meter="m", model=model, tiers=tuple(Tier(Decimal(u) if u else None, Decimal(p)) for u, p in tiers))
+
+
+@pytest.mark.parametrize("model,qty,expected", [
+    (PricingModel.TIERED, "999", ("2", "0.08")),
+    (PricingModel.TIERED, "1000", ("1", "0.08")),
+    (PricingModel.TIERED, "1001", ("9000", "0.05")),
+    (PricingModel.TIERED, "10001", None),
+    (PricingModel.VOLUME, "999", ("1", "0.08")),
+    (PricingModel.VOLUME, "1000", ("9000", "0.05")),
+    (PricingModel.VOLUME, "10000", None),
+])
+def test_next_tier(model, qty, expected):
+    from meterbill.pricing import next_tier
+    comp = _comp(model, [("1000", "0.10"), ("10000", "0.08"), (None, "0.05")])
+    got = next_tier(comp, Decimal(qty))
+    assert (got and (str(got.units_needed), str(got.unit_price))) == expected
