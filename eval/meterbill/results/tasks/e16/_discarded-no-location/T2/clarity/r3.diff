index 8173df5..1f8e18e 100644
--- a/meterbill/pricing.py
+++ b/meterbill/pricing.py
@@ -19,6 +19,30 @@ class PricedPart:
     amount: Money
 
 
+@dataclass(frozen=True, slots=True)
+class NextTier:
+    units_needed: Decimal  # more units to reach the next tier from the quoted quantity
+    unit_price: Decimal  # major currency units per unit in that tier
+
+
+def next_tier(component: PlanComponent, quantity: Decimal) -> NextTier | None:
+    """How far ``quantity`` is from the next price tier, or None if not tiered/volume or on the top tier.
+
+    Uses the same bounds as pricing: tiered tiers are inclusive (the next tier
+    starts at ``up_to + 1``), volume tiers exclusive (it starts at ``up_to``).
+    """
+    if component.model not in (PricingModel.TIERED, PricingModel.VOLUME):
+        return None
+    inclusive = component.model is PricingModel.TIERED
+    for index, tier in enumerate(component.tiers):
+        if tier.up_to is None:
+            return None
+        if quantity <= tier.up_to if inclusive else quantity < tier.up_to:
+            needed = tier.up_to - quantity + (1 if inclusive else 0)
+            return NextTier(needed, component.tiers[index + 1].unit_price)
+    return None
+
+
 def tier_span(lower: Decimal, tier: Tier) -> str:
     """The unit range of a tier whose lower edge is ``lower``, e.g. "1001-10000" or "10001+"."""
     first = f"{lower + 1:f}"
