diff --git a/tests/test_quote.py b/tests/test_quote.py
index 1bf3250..956b752 100644
--- a/tests/test_quote.py
+++ b/tests/test_quote.py
@@ -131,3 +131,33 @@ def test_cli_quote_errors(args, capsys):
     assert main(["quote", *args]) == 1
     captured = capsys.readouterr()
     assert captured.err.startswith("error: ") and captured.out == ""
+
+
+# --- next-tier hint ---
+
+def _hint_component(model):
+    from meterbill.plans import PlanComponent, PricingModel, Tier
+    tiers = (Tier(Decimal(1000), Decimal("0.10")), Tier(Decimal(5000), Decimal("0.08")),
+             Tier(None, Decimal("0.05")))
+    return PlanComponent("m", PricingModel(model), tiers=tiers)
+
+
+def test_next_tier_bounds():
+    from meterbill.pricing import next_tier
+    t, v = _hint_component("tiered"), _hint_component("volume")
+    # tiered: 1000 is still tier 1, 1001 is the first unit of tier 2
+    assert next_tier(t, Decimal(1000)).units_needed == 1
+    assert next_tier(t, Decimal(1000)).unit_price == Decimal("0.08")
+    assert next_tier(t, Decimal(1001)).units_needed == 4000
+    assert next_tier(t, Decimal(5001)) is None
+    # volume: 1000 is already tier 2, 999 is one short
+    assert next_tier(v, Decimal(999)).units_needed == 1
+    assert next_tier(v, Decimal(1000)).units_needed == 4000
+    assert next_tier(v, Decimal(5000)) is None
+
+
+def test_hint_text():
+    from meterbill.quote import _next_tier_hint
+    assert _next_tier_hint(_hint_component("volume"), Decimal(999)) == "next tier: +1 unit at 0.08"
+    assert _next_tier_hint(_hint_component("volume"), Decimal(9000)) == "next tier: top tier"
+    assert _next_tier_hint(_hint_component("tiered"), Decimal(10)) == "next tier: +991 units at 0.08"
