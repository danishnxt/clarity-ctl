diff --git a/meterbill/pricing.py b/meterbill/pricing.py
index 8173df5..3eaadfa 100644
--- a/meterbill/pricing.py
+++ b/meterbill/pricing.py
@@ -91,3 +91,33 @@ def _price_volume(component: PlanComponent, quantity: Decimal, currency: str) ->
         f"{component.meter} (volume tier {number})", quantity, tier.unit_price,
         _amount(quantity, tier.unit_price, currency),
     )
+
+
+@dataclass(frozen=True, slots=True)
+class NextTier:
+    units_needed: Decimal  # more units to reach the next tier
+    unit_price: Decimal  # major currency units per unit in that tier
+
+
+def next_tier(component: PlanComponent, quantity: Decimal) -> NextTier | None:
+    """How far ``quantity`` is from the next price tier of a tiered or volume component.
+
+    Returns None when the quantity is already in the last tier. Bounds follow
+    price_quantity: tiered tier bounds are inclusive, so a tiered quantity equal
+    to a tier's ``up_to`` needs 1 more unit; volume bounds are exclusive, so a
+    volume quantity one below ``up_to`` needs 1 more unit, and one equal to it
+    is already in the next tier.
+    """
+    if component.model not in (PricingModel.TIERED, PricingModel.VOLUME):
+        raise ValueError(f"{component.meter!r} has no tiers")
+    if quantity < 0 or not quantity.is_finite():
+        raise ValueError(f"quantity must be finite and not negative: {quantity}")
+    tiers = component.tiers
+    inclusive = component.model is PricingModel.TIERED
+    for index, tier in enumerate(tiers):
+        if tier.up_to is None:
+            return None
+        if (quantity <= tier.up_to) if inclusive else (quantity < tier.up_to):
+            needed = tier.up_to + 1 - quantity if inclusive else tier.up_to - quantity
+            return NextTier(needed, tiers[index + 1].unit_price)
+    return None
