+
+
+
+def _tiers(model):
+    return PlanComponent(meter="m", model=model, tiers=(
+        Tier(Decimal(1000), Decimal("0.10")), Tier(Decimal(10000), Decimal("0.08")),
+        Tier(None, Decimal("0.05"))))
+
+
+@pytest.mark.parametrize("model,qty,expected", [
+    (PricingModel.TIERED, "1", "next tier: +1000 units at 0.08"),
+    (PricingModel.TIERED, "1000", "next tier: +1 unit at 0.08"),
+    (PricingModel.TIERED, "1001", "next tier: +9000 units at 0.05"),
+    (PricingModel.TIERED, "10001", "next tier: top tier"),
+    (PricingModel.VOLUME, "999", "next tier: +1 unit at 0.08"),
+    (PricingModel.VOLUME, "1000", "next tier: +9000 units at 0.05"),
+    (PricingModel.VOLUME, "10000", "next tier: top tier"),
+])
+def test_next_tier_hint(model, qty, expected):
+    from meterbill.quote import format_hint
+    assert format_hint(_tiers(model), Decimal(qty)) == expected
+
