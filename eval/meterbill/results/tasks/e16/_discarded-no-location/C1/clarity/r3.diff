+def test_plans_list_sorted_aligned_with_model(capsys):
+    from meterbill.cli import main
+    assert main(["plans", "list"]) == 0
+    lines = capsys.readouterr().out.splitlines()
+    assert lines[0].split() == ["ID", "NAME", "MODEL", "CURRENCY"]
+    ids = [line.split("  ")[0].strip() for line in lines[1:]]
+    assert ids == sorted(ids)
+    assert len({line.index("CURRENCY") if i == 0 else line.rindex("  ") for i, line in enumerate(lines[:1])}) == 1
+    assert any("per_unit" in line for line in lines[1:]) and any("mixed" in line for line in lines[1:])
