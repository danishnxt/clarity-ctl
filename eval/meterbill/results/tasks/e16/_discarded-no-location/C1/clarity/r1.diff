+def test_plans_list_sorted_with_mixed_model(capsys):
+    assert main(["plans", "list"]) == 0
+    lines = capsys.readouterr().out.splitlines()
+    assert lines[0].split() == ["ID", "NAME", "MODEL", "CURRENCY"]
+    ids = [line.split()[0] for line in lines[1:]]
+    assert ids == sorted(ids)
+    assert "mixed" in next(line for line in lines if line.startswith("growth"))
