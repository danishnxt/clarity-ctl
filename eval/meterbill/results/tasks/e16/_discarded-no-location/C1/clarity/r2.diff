+def test_plans_list_sorted_aligned_table(capsys):
+    from meterbill.plans import load_catalog
+
+    assert main(["plans", "list"]) == 0
+    lines = capsys.readouterr().out.splitlines()
+    plans = load_catalog(ROOT / "data").plans
+    assert lines[0].split("  ")[0] == "ID" and lines[0].split() == ["ID", "NAME", "MODEL", "CURRENCY"]
+    assert [l.split("  ")[0].rstrip() for l in lines[1:]] == sorted(plans)
+    assert len(lines) == len(plans) + 1
+    assert all(l.index("  ") <= len("enterprise-jpy") for l in lines)
