+def _run_plans(args: argparse.Namespace) -> int:
+    try:
+        catalog = load_catalog(args.data_dir)
+    except (ValueError, OSError) as exc:  # CatalogError is a ValueError
+        print(f"error: {exc}", file=sys.stderr)
+        return 1
+    rows = [("ID", "NAME", "MODEL", "CURRENCY")]
+    for plan_id in sorted(catalog.plans):
+        plan = catalog.plans[plan_id]
+        models = {c.model.value for c in plan.components}
+        model = models.pop() if len(models) == 1 else "mixed"
+        rows.append((plan.id, plan.name, model, plan.currency))
+    widths = [max(len(r[i]) for r in rows) for i in range(4)]
+    for row in rows:
+        print("  ".join(f"{c:<{w}}" for c, w in zip(row, widths)).rstrip())
+    return 0
