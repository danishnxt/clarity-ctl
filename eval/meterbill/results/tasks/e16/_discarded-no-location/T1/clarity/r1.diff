+def test_tax_rate_looked_up_once_per_country_per_call_not_across_calls(catalog):
+    from meterbill.tax import TaxResolver
+
+    class Counting(TaxResolver):
+        calls = 0
+
+        def rate_for(self, *a):
+            Counting.calls += 1
+            return super().rate_for(*a)
+
+    r = Counting()
+    build_invoice("NWD", OCT, events(), catalog, date(2026, 11, 2), r)
+    assert Counting.calls == 1  # two lines, one country
+    build_invoice("NWD", OCT, events(), catalog, date(2026, 11, 2), r)
+    assert Counting.calls == 2  # nothing carried over to the next call
