+
+
+class _CountingResolver:
+    def __init__(self, inner):
+        self.inner, self.calls = inner, []
+
+    def rate_for(self, tenant_id, country, on_date):
+        self.calls.append(country)
+        return self.inner.rate_for(tenant_id, country, on_date)
+
+
+def test_tax_lookup_once_per_country_per_call_not_across_calls(catalog):
+    from meterbill.tax import TaxResolver
+
+    resolver = _CountingResolver(TaxResolver())
+    for _ in range(2):
+        build_invoice("NWD", OCT, events(), catalog, date(2026, 11, 2), resolver)
+    # two lines, one country: one lookup per call, nothing carried between calls
+    assert resolver.calls == ["DE", "DE"]
