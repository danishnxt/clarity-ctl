+
+
+def test_build_invoice_caches_rate_per_call_only(catalog, data_dir):
+    from datetime import date
+    from meterbill.invoices import build_invoice
+    from meterbill.period import Period
+    from meterbill.tax import TaxResolver
+
+    class Counting(TaxResolver):
+        calls = 0
+
+        def rate_for(self, *a):
+            Counting.calls += 1
+            return super().rate_for(*a)
+
+    r = Counting(data_dir)
+    period = Period(2026, 10)
+    from tests.test_invoices import events
+    build_invoice("NWD", period, events(), catalog, date(2026, 11, 2), r)
+    first = Counting.calls
+    build_invoice("NWD", period, events(), catalog, date(2026, 11, 2), r)
+    assert first >= 1 and Counting.calls == 2 * first  # nothing carried across calls
