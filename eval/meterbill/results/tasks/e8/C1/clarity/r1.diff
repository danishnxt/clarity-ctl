+def test_plans_list_table(capsys):
+    assert main(["plans", "list", "--data-dir", str(ROOT / "data")]) == 0
+    lines = capsys.readouterr().out.splitlines()
+    assert lines[0].split() == ["ID", "NAME", "MODEL", "CURRENCY"]
+    ids = [line.split()[0] for line in lines[1:]]
+    assert ids == sorted(ids) and ids
+    assert len({len(line) for line in lines}) == 1
+    assert all(line.startswith(("ID  ", *ids)) for line in lines)
