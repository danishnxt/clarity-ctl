+def format_plans(plans: Sequence[Plan]) -> str:
+    rows = [("ID", "NAME", "MODEL", "CURRENCY")]
+    for plan in sorted(plans, key=lambda p: p.id):
+        models = {c.model.value for c in plan.components}
+        model = "mixed" if len(models) > 1 else (next(iter(models)) if models else "-")
+        rows.append((plan.id, plan.name, model, plan.currency))
+    widths = [max(len(r[i]) for r in rows) for i in range(4)]
+    return "\n".join("  ".join(f"{r[i]:<{widths[i]}}" for i in range(4)) for r in rows)
+
+
+def _run_plans_list(args: argparse.Namespace) -> int:
+    try:
+        catalog = load_catalog(args.data_dir)
+    except (ValueError, OSError, CatalogError) as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 1
+    print(format_plans(list(catalog.plans.values())))
+    return 0
+
