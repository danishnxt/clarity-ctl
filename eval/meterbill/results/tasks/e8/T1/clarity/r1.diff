+def test_tax_lookup_memoized_per_build_only(catalog):
+    from meterbill.tax import TaxResolver
+
+    calls = []
+
+    class Counting(TaxResolver):
+        def rate_for(self, tenant_id, country, on_date):
+            calls.append(country)
+            return super().rate_for(tenant_id, country, on_date)
+
+    resolver = Counting()
+    build_invoice("NWD", OCT, events(), catalog, date(2026, 11, 2), resolver)
+    assert len(calls) == 1  # two lines, same country: one lookup
+    build_invoice("NWD", OCT, events(), catalog, date(2026, 11, 2), resolver)
+    assert len(calls) == 2  # nothing carried over to the next build
