+def test_tax_lookup_memoized_per_call_only(catalog, data_dir):
+    from meterbill.invoices import build_invoice
+    from meterbill.tax import TaxResolver
+
+    class Counting(TaxResolver):
+        calls = 0
+
+        def rate_for(self, *a):
+            Counting.calls += 1
+            return super().rate_for(*a)
+
+    ev = events()
+    p = OCT
+    r = Counting(data_dir)
+    build_invoice("NWD", p, ev, catalog, date(2026, 11, 2), r)
+    first = Counting.calls
+    build_invoice("NWD", p, ev, catalog, date(2026, 11, 2), r)
+    assert first == 1 and Counting.calls == 2 * first  # nothing kept between calls
