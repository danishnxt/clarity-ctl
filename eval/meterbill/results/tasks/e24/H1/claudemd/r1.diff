+# --- credit notes ---------------------------------------------------------
+
+def _acct_invoice(cur="EUR", acct="4010"):
+    line = InvoiceLine("api_calls", Decimal(1), Decimal(1), Money(1000, cur), "DE",
+                       Decimal("0.19"), Money(190, cur), revenue_account=acct)
+    return _invoice([line, InvoiceLine("fee", Decimal(1), Decimal(1), Money(500, cur), "US",
+                                       Decimal(0), Money(0, cur), revenue_account="4020")], cur)
+
+
+def _note(inv, lines=None, day=date(2026, 11, 20)):
+    from meterbill.credits import issue_credit_note
+    from meterbill.invoices import SequenceStore
+    import tempfile, pathlib
+    store = SequenceStore(pathlib.Path(tempfile.mkdtemp()) / "c.json", prefix="CN")
+    return issue_credit_note(inv, lines, reason="dispute", store=store, issue_date=day)
+
+
+def test_credit_note_reverses_original_accounts_not_current_map():
+    from meterbill.exports import credit_note_postings
+    note = _note(_acct_invoice(acct="4010"))
+    remapped = AccountMap({"api_calls": "4999"}, "4999")  # accounting remapped since
+    out = io.StringIO()
+    write_postings([note], Period(2026, 11), remapped, out)
+    rows = [json.loads(r) for r in out.getvalue().splitlines()]
+    assert [(r["account"], r["debit"], r["credit"]) for r in rows] == [
+        ("1200", "0.00", "16.90"), ("4010", "10.00", "0.00"),
+        ("2200-DE", "1.90", "0.00"), ("4020", "5.00", "0.00")]
+    assert _balance(credit_note_postings(note)) == 0
+
+
+@pytest.mark.parametrize("cur", ["JPY", "KWD"])
+def test_credit_note_balanced_in_other_exponents(cur):
+    from meterbill.exports import credit_note_postings
+    assert _balance(credit_note_postings(_note(_acct_invoice(cur)))) == 0
+
+
+def test_credit_note_partial_and_period_by_issue_month():
+    note = _note(_acct_invoice(), lines=[2])
+    out = io.StringIO()
+    assert write_postings([note], Period(2026, 10), ACCOUNTS, out) == 0
+    assert write_postings([note], Period(2026, 11), ACCOUNTS, out) == 2
+
+
+def test_credit_note_without_stored_account_is_an_error():
+    from meterbill.exports import credit_note_postings
+    with pytest.raises(ExportError):
+        credit_note_postings(_note(_invoice([_line("api_calls", 1000, 190, "DE")])))
+
+
+def test_revenue_account_roundtrips_and_invoice_posts_to_it():
+    from meterbill.credits import credit_note_from_json, credit_note_to_json
+    from meterbill.invoices import invoice_from_json
+    inv = invoice_from_json(invoice_to_json(_acct_invoice()))
+    assert inv.lines[0].revenue_account == "4010"
