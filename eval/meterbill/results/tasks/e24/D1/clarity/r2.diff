diff --git a/meterbill/dunning.py b/meterbill/dunning.py
new file mode 100644
index 0000000..74cea75
--- /dev/null
+++ b/meterbill/dunning.py
@@ -0,0 +1,59 @@
+"""Payment reminders: which finalized, unpaid invoices get a reminder on a date.
+
+Schedule (days after due_date): level 1 at +7, level 2 at +28, level 3 at +35;
+level 3 also copies finance. An invoice is skipped when its open amount is
+below 5.00 EUR (converted at the invoice's issue date) or when a credit note
+was issued against it within the last 30 days.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import date, timedelta
+from typing import Iterable, Sequence
+
+from meterbill.credits import CreditNote
+from meterbill.fx import FxConverter
+from meterbill.invoices import Invoice, InvoiceStatus
+from meterbill.money import Money
+from meterbill.payments import Payment, balance_for
+
+LEVEL_OFFSETS = {1: 7, 2: 28, 3: 35}  # days after due_date
+LEVEL_EXTRA_CC = {3: ("finance@meterbill.example",)}
+MIN_OPEN = Money(500, "EUR")
+CREDIT_NOTE_QUIET_DAYS = 30
+
+
+@dataclass(frozen=True, slots=True)
+class Reminder:
+    invoice: Invoice
+    level: int
+    extra_cc: tuple[str, ...]
+    open_amount: Money
+
+
+def due_reminders(
+    invoices: Iterable[Invoice], payments: Sequence[Payment],
+    credit_notes: Sequence[CreditNote], fx: FxConverter, on: date,
+) -> list[Reminder]:
+    """Reminders due exactly on ``on``, sorted by invoice number."""
+    found = []
+    for invoice in invoices:
+        if (invoice.status is not InvoiceStatus.FINALIZED or invoice.number is None
+                or invoice.due_date is None):
+            continue
+        level = next((lv for lv, days in LEVEL_OFFSETS.items()
+                      if invoice.due_date + timedelta(days=days) == on), None)
+        if level is None:
+            continue
+        open_amount = balance_for(invoice, payments, credit_notes).open_amount
+        if open_amount.minor <= 0:
+            continue
+        if any(n.invoice_number == invoice.number
+               and timedelta(0) <= on - n.issue_date <= timedelta(days=CREDIT_NOTE_QUIET_DAYS)
+               for n in credit_notes):
+            continue
+        if fx.convert(open_amount, MIN_OPEN.currency, invoice.issue_date) < MIN_OPEN:
+            continue
+        found.append(Reminder(invoice, level, LEVEL_EXTRA_CC.get(level, ()), open_amount))
+    return sorted(found, key=lambda r: r.invoice.number)
diff --git a/tests/test_dunning.py b/tests/test_dunning.py
new file mode 100644
index 0000000..8a352c2
--- /dev/null
+++ b/tests/test_dunning.py
@@ -0,0 +1,93 @@
+import pytest
+from conftest import event_record
+
+from meterbill.cli import main
+from meterbill.outbox import Outbox
+
+# finalized 2026-11-03 with 14-day terms -> due 2026-11-17
+L1, L2, L3 = "2026-11-24", "2026-12-15", "2026-12-22"
+
+
+@pytest.fixture
+def invoice(data_dir, write_events, capsys):
+    path = write_events(event_record(quantity="100000"))  # big enough to clear the 5 EUR floor
+    assert main(["invoices", "create", "--tenant", "NWD", "--period", "2026-10",
+                 "--events", str(path), "--issue-date", "2026-11-02",
+                 "--data-dir", str(data_dir)]) == 0
+    draft = next(w for w in capsys.readouterr().out.split() if w.startswith("DRAFT-"))
+    assert main(["invoices", "finalize", draft, "--date", "2026-11-03",
+                 "--data-dir", str(data_dir)]) == 0
+    out = capsys.readouterr().out
+    return next(w for w in out.split() if w.startswith("INV-"))
+
+
+def dunning(data_dir, day, capsys, *extra):
+    code = main(["dunning", "--date", day, "--data-dir", str(data_dir), *extra])
+    return code, capsys.readouterr().out.splitlines()
+
+
+def test_levels_and_cc(data_dir, invoice, capsys):
+    to = "billing@northwind.example"
+    assert dunning(data_dir, L1, capsys)[1] == [f"{invoice}  L1  to={to}  cc=finance@northwind.example"]
+    assert dunning(data_dir, L2, capsys)[1][0].startswith(f"{invoice}  L2")
+    assert dunning(data_dir, L3, capsys)[1] == [
+        f"{invoice}  L3  to={to}  cc=finance@northwind.example,finance@meterbill.example"]
+    assert dunning(data_dir, "2026-11-25", capsys)[1] == []
+
+
+def test_paid_invoice_skipped(data_dir, invoice, capsys):
+    assert main(["invoices", "show", invoice, "--data-dir", str(data_dir)]) == 0
+    open_line = next(l for l in capsys.readouterr().out.splitlines() if l.startswith("Open:"))
+    amount = open_line.split()[1]
+    assert main(["payments", "record", "--tenant", "NWD", "--amount", amount, "--currency",
+                 "EUR", "--date", "2026-11-10", "--reference", invoice,
+                 "--data-dir", str(data_dir)]) == 0
+    capsys.readouterr()
+    assert dunning(data_dir, L1, capsys)[1] == []
+
+
+def _load(data_dir, invoice):
+    from meterbill.invoices import InvoiceStore
+    return InvoiceStore(data_dir / "invoices").load(invoice)
+
+
+def _remind(data_dir, inv, payments, notes, day="2026-11-24"):
+    from datetime import date
+
+    from meterbill.dunning import due_reminders
+    from meterbill.fx import FxConverter
+    return due_reminders([inv], payments, notes, FxConverter(data_dir), date.fromisoformat(day))
+
+
+def test_small_open_amount_skipped(data_dir, invoice):
+    from datetime import date
+
+    from meterbill.money import Money
+    from meterbill.payments import Payment
+    inv = _load(data_dir, invoice)
+    def paid(minor):
+        return [Payment("NWD", Money(inv.total.minor - minor, "EUR"), date(2026, 11, 10), invoice)]
+    assert _remind(data_dir, inv, paid(499), []) == []
+    assert len(_remind(data_dir, inv, paid(500), [])) == 1
+
+
+def test_recent_credit_note_skips(data_dir, invoice):
+    from dataclasses import replace
+    from datetime import date
+
+    from meterbill.credits import CreditNote
+    inv = _load(data_dir, invoice)
+    note = CreditNote("CN-1", invoice, "NWD", "Northwind", "EUR", "x", date(2026, 10, 25), ())
+    # 30 days before the run date still counts; 31 does not
+    assert _remind(data_dir, inv, [], [replace(note, issue_date=date(2026, 10, 25))]) == []
+    assert len(_remind(data_dir, inv, [], [replace(note, issue_date=date(2026, 10, 24))])) == 1
+
+
+def test_queue_writes_outbox(data_dir, invoice, capsys):
+    code, lines = dunning(data_dir, L3, capsys, "--queue")
+    assert code == 0 and len(lines) == 1
+    (mail,) = Outbox(data_dir / "outbox").list()
+    assert (mail.kind, mail.ref, mail.to) == ("reminder", invoice, "billing@northwind.example")
+    assert mail.cc == ("finance@northwind.example", "finance@meterbill.example")
+    assert dunning(data_dir, L3, capsys)[1] == lines
+    assert len(Outbox(data_dir / "outbox").list()) == 1  # no --queue, nothing new
