+def test_small_remainder_written_off(data_dir, tmp_path, capsys):
+    inv = make_invoice(data_dir, tmp_path, "NWD", "1000", date(2026, 11, 3), "a")
+    pay(data_dir, str((inv.total.minor - 49) / 100))
+    _, lines, _ = allocate(data_dir, capsys)
+    assert lines == [f"PAY-1 -> {inv.number} {Money(inv.total.minor - 49, 'EUR')}",
