diff --git a/tests/test_allocation.py b/tests/test_allocation.py
new file mode 100644
index 0000000..40f51c6
--- /dev/null
+++ b/tests/test_allocation.py
@@ -0,0 +1,173 @@
+import json
+from datetime import date
+
+import pytest
+
+from meterbill.cli import main
+from meterbill.events import stream_events
+from meterbill.invoices import InvoiceStore, SequenceStore, build_invoice
+from meterbill.money import Money
+from meterbill.payments import Payment, PaymentStore, balance_for, AllocationStore
+from meterbill.period import Period
+from meterbill.plans import load_catalog
+from meterbill.wallets import WalletStore
+from conftest import event_record
+
+
+def make_invoice(data_dir, tmp_path, tenant, qty, finalize_date, tag):
+    """Finalized invoice; due date = finalize date + 14 days."""
+    store = InvoiceStore(data_dir / "invoices")
+    f = tmp_path / f"{tag}.jsonl"
+    f.write_text(json.dumps(event_record(tenant_id=tenant, quantity=qty,
+                                         idempotency_key=tag, event_id=tag)) + "\n")
+    d = build_invoice(tenant, Period.parse("2026-10"), stream_events(f), load_catalog(data_dir),
+                      date(2026, 11, 2))
+    store.save_draft(d)
+    return store.finalize(d.draft_id, SequenceStore(data_dir / "sequences.json"), 14,
+                          finalize_date)
+
+
+def pay(data_dir, amount, currency="EUR", when="2026-11-10", ref=None, tenant="NWD"):
+    PaymentStore(data_dir / "payments.jsonl").record(
+        Payment(tenant, Money.from_major(amount, currency), date.fromisoformat(when), ref))
+
+
+def allocate(data_dir, capsys, tenant="NWD"):
+    capsys.readouterr()
+    code = main(["payments", "allocate", "--tenant", tenant, "--data-dir", str(data_dir)])
+    cap = capsys.readouterr()
+    return code, cap.out.splitlines(), cap.err
+
+
+def open_of(data_dir, invoice):
+    return balance_for(invoice, PaymentStore(data_dir / "payments.jsonl").load(), (),
+                       AllocationStore(data_dir / "allocations.jsonl").load())
+
+
+@pytest.fixture
+def two(data_dir, tmp_path):
+    # b is due first (finalized earlier) although created second
+    a = make_invoice(data_dir, tmp_path, "NWD", "100000", date(2026, 11, 5), "a")
+    b = make_invoice(data_dir, tmp_path, "NWD", "100000", date(2026, 11, 3), "b")
+    return a, b
+
+
+def test_oldest_due_first_and_spread(data_dir, two, capsys):
+    a, b = two
+    total = b.total.minor
+    pay(data_dir, str((total + 1000) / 100))
+    code, lines, _ = allocate(data_dir, capsys)
+    assert code == 0
+    assert lines == [f"PAY-1 -> {b.number} {b.total}",
+                     f"PAY-1 -> {a.number} {Money(1000, 'EUR')}"]
+    assert open_of(data_dir, b).open_amount.minor == 0 and open_of(data_dir, b).paid
+    assert open_of(data_dir, a).open_amount.minor == a.total.minor - 1000
+
+
+def test_tie_lower_number_first(data_dir, tmp_path, capsys):
+    a = make_invoice(data_dir, tmp_path, "NWD", "1000", date(2026, 11, 3), "a")
+    b = make_invoice(data_dir, tmp_path, "NWD", "1000", date(2026, 11, 3), "b")
+    pay(data_dir, "1.00")
+    _, lines, _ = allocate(data_dir, capsys)
+    first = min(a.number, b.number)
+    assert lines == [f"PAY-1 -> {first} 1.00 EUR"]
+
+
+def test_idempotent_and_listing(data_dir, two, capsys):
+    pay(data_dir, "5.00")
+    allocate(data_dir, capsys)
+    code, lines, _ = allocate(data_dir, capsys)
+    assert (code, lines) == (0, [])
+    main(["payments", "list", "--tenant", "NWD", "--unmatched", "--data-dir", str(data_dir)])
+    assert "5.00 EUR" not in capsys.readouterr().out
+
+
+def test_payment_date_order_then_id(data_dir, two, capsys):
+    a, b = two
+    pay(data_dir, "1.00", when="2026-11-10")   # id 1
+    pay(data_dir, "2.00", when="2026-11-09")   # id 2, earlier date: first
+    pay(data_dir, "3.00", when="2026-11-09")   # id 3
+    _, lines, _ = allocate(data_dir, capsys)
+    assert [l.split(" -> ")[0] for l in lines] == ["PAY-2", "PAY-3", "PAY-1"]
+
+
+def test_matched_payments_untouched_other_tenants_ignored(data_dir, two, capsys):
+    a, b = two
+    pay(data_dir, "1.00", ref=a.number)
+    pay(data_dir, "1.00", tenant="ACM")
+    code, lines, _ = allocate(data_dir, capsys)
+    assert (code, lines) == (0, [])
+
+
+def test_leftover_to_wallet_in_payment_currency(data_dir, tmp_path, capsys):
+    inv = make_invoice(data_dir, tmp_path, "NWD", "1000", date(2026, 11, 3), "a")
+    pay(data_dir, str((inv.total.minor + 700) / 100))
+    _, lines, _ = allocate(data_dir, capsys)
+    assert lines == [f"PAY-1 -> {inv.number} {inv.total}", "PAY-1 -> wallet 7.00 EUR"]
+    assert WalletStore(data_dir).balance("NWD", "EUR") == Money(700, "EUR")
+
+
+def test_no_open_invoices_all_to_wallet(data_dir, capsys):
+    pay(data_dir, "12.00")
+    _, lines, _ = allocate(data_dir, capsys)
+    assert lines == ["PAY-1 -> wallet 12.00 EUR"]
+
+
+def test_void_invoice_skipped(data_dir, two, capsys):
