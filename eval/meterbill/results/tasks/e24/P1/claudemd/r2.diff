+def test_foreign_currency_converted_at_payment_date(data_dir, tmp_path, capsys):
+    from meterbill.fx import FxConverter
+    inv = make_invoice(data_dir, tmp_path, "NWD", "100000", date(2026, 11, 3), "a")
+    fx = FxConverter(data_dir)
+    day = date(2026, 11, 9)
+    usd_all = fx.convert(inv.total, "USD", day)
+    # pays 10.00 USD: converted to EUR at the payment date rate
+    pay(data_dir, "10.00", "USD", when=day.isoformat())
+    _, lines, _ = allocate(data_dir, capsys)
+    assert lines == [f"PAY-1 -> {inv.number} {fx.convert(Money(1000, 'USD'), 'EUR', day)}"]
+    # paying far more than needed: invoice covered, leftover to wallet in USD
+    pay(data_dir, str((usd_all.minor + 5000) / 100), "USD", when=day.isoformat())
+    _, lines, _ = allocate(data_dir, capsys)
+    assert lines[0].startswith(f"PAY-2 -> {inv.number} ")
+    assert lines[-1].startswith("PAY-2 -> wallet ") and lines[-1].endswith(" USD")
+    assert open_of(data_dir, inv).open_amount.minor <= 0
+
