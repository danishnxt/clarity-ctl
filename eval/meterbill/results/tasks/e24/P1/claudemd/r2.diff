+def test_stale_fx_rate_aborts_and_records_nothing(data_dir, tmp_path, capsys):
+    make_invoice(data_dir, tmp_path, "NWD", "1000", date(2026, 11, 3), "a")
+    pay(data_dir, "1.00", "USD", when="2027-06-01")
+    code, lines, err = allocate(data_dir, capsys)
+    assert code == 1 and lines == [] and "error" in err
+    assert AllocationStore(data_dir / "allocations.jsonl").load() == []
+
