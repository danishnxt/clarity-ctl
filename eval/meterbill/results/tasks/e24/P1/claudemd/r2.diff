@@ -0,0 +1,165 @@
+"""Allocation of unmatched payments to a tenant's open invoices.
+
+A payment with no matching invoice is spread over the tenant's open finalized
+invoices, oldest due date first, ties broken by the lower invoice number. Void
+invoices are never touched. A payment in another currency is converted at the
+rate of the PAYMENT date (``FxConverter``; a missing or stale rate raises
+``FxError`` and nothing is recorded). If what stays open on an invoice after a
+payment landed on it is under 0.50 in the invoice currency, the rest is written
+off to account 6900. Whatever is left of the payment goes into the tenant's
+wallet in the payment's currency; nothing is ever refunded.
+
+Results live in ``allocations.jsonl`` (append-only, one line per movement).
+A payment id is its 1-based line number in ``payments.jsonl``, which is
+append-only, so ids never change. A payment with any allocation line is done.
+"""
+
+from __future__ import annotations
+
+import fcntl
+import json
+from contextlib import contextmanager
+from dataclasses import dataclass
+from datetime import date
+from pathlib import Path
+from typing import Iterator, Sequence
+
+from meterbill.credits import CreditNote
+from meterbill.fx import FxConverter
+from meterbill.invoices import Invoice
+from meterbill.money import Money, exponent_for
+from meterbill.payments.models import Payment
+from meterbill.payments.store import PaymentError, balance_for, matches
+
+ALLOCATIONS_FILE = "allocations.jsonl"
+WRITE_OFF_ACCOUNT = "6900"
+WALLET = "wallet"
+WRITE_OFF_BELOW_MAJOR = "0.50"  # strictly under this (invoice currency) is written off
+
+
+@dataclass(frozen=True, slots=True)
+class Allocation:
+    payment_id: int
+    kind: str  # "invoice", "wallet" or "writeoff"
+    target: str  # invoice number, "wallet" or ledger account
+    amount: Money  # in the TARGET's currency (invoice's, or the payment's for the wallet)
+    tenant_id: str
+    invoice: str | None = None  # invoice the movement belongs to (invoice and writeoff)
+
+    @property
+    def payment_label(self) -> str:
+        return f"PAY-{self.payment_id}"
+
+
+def _to_dict(a: Allocation) -> dict[str, object]:
+    return {"payment_id": a.payment_id, "kind": a.kind, "target": a.target,
+            "amount": a.amount.minor, "currency": a.amount.currency,
+            "tenant_id": a.tenant_id, "invoice": a.invoice}
+
+
+def _from_dict(data: object) -> Allocation:
+    try:
+        kind = data["kind"]
+        if kind not in ("invoice", "wallet", "writeoff") or isinstance(data["payment_id"], bool):
+            raise ValueError(f"bad allocation kind or id {kind!r}")
+        return Allocation(int(data["payment_id"]), kind, data["target"],
+                          Money(data["amount"], data["currency"]), data["tenant_id"],
+                          data.get("invoice"))
+    except (KeyError, TypeError) as exc:
+        raise ValueError(f"malformed allocation: {exc!r}") from None
+
+
+class AllocationStore:
+    def __init__(self, path: str | Path) -> None:
+        self.path = Path(path)
+
+    def load(self) -> list[Allocation]:
+        if not self.path.is_file():
+            return []
+        return self._parse(self.path.read_text(encoding="utf-8"))
+
+    def _parse(self, text: str) -> list[Allocation]:
+        out = []
+        for n, line in enumerate(text.splitlines(), 1):
+            if not line.strip():
+                continue
+            try:
+                out.append(_from_dict(json.loads(line)))
+            except ValueError as exc:
+                raise PaymentError(f"{self.path.name} line {n}: {exc}") from None
+        return out
+
+    @contextmanager
+    def locked(self) -> Iterator[tuple[list[Allocation], "callable"]]:
+        """Hold the file lock; yields the stored allocations and an ``append`` function."""
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        with open(self.path, "a+", encoding="utf-8") as handle:
+            fcntl.flock(handle, fcntl.LOCK_EX)
+            handle.seek(0)
+            existing = self._parse(handle.read())
+
+            def append(new: Sequence[Allocation]) -> None:
+                handle.seek(0, 2)
+                handle.write("".join(json.dumps(_to_dict(a)) + "\n" for a in new))
+                handle.flush()
+
+            yield existing, append
+
+
+def allocated_payment_ids(allocations: Sequence[Allocation]) -> set[int]:
+    return {a.payment_id for a in allocations}
+
+
+def _due_key(invoice: Invoice) -> tuple[date, str]:
+    return (invoice.due_date or date.max, invoice.number or "")
+
+
+def plan_allocations(
+    numbered: Sequence[tuple[int, Payment]],
+    invoices: Sequence[Invoice],
+    credit_notes: Sequence[CreditNote],
+    stored: Sequence[Allocation],
+    fx: FxConverter,
+) -> list[Allocation]:
+    """Pure planning: the allocations for every not yet allocated, unmatched payment."""
+    payments = [p for _, p in numbered]
+    done = allocated_payment_ids(stored)
+    finalized = [i for i in invoices if i.number is not None]
+    open_left = {i.number: balance_for(i, payments, credit_notes, stored).open_amount
+                 for i in finalized}
+    todo = sorted(((n, p) for n, p in numbered
+                   if n not in done and not any(matches(p, i) for i in finalized)),
+                  key=lambda item: (item[1].received_date, item[0]))
+    ordered = sorted(finalized, key=_due_key)
+    plan: list[Allocation] = []
+    for pid, pay in todo:
+        remaining = pay.amount
+        for inv in ordered:
+            if remaining.minor <= 0:
+                break
+            if inv.tenant_id != pay.tenant_id or open_left[inv.number].minor <= 0:
+                continue
+            open_amt = open_left[inv.number]
+            if inv.currency == pay.amount.currency:
+                applied = consumed = Money(min(open_amt.minor, remaining.minor), inv.currency)
+            else:
+                converted = fx.convert(remaining, inv.currency, pay.received_date)
+                if converted.minor <= open_amt.minor:
+                    applied, consumed = converted, remaining
+                else:
+                    applied = open_amt
+                    back = fx.convert(open_amt, pay.amount.currency, pay.received_date)
+                    consumed = Money(min(back.minor, remaining.minor), pay.amount.currency)
+            if applied.minor <= 0:
+                continue
+            plan.append(Allocation(pid, "invoice", inv.number, applied, pay.tenant_id, inv.number))
+            remaining = remaining - consumed
+            left = open_amt - applied
+            if left.minor > 0 and left.minor * 2 < 10 ** exponent_for(inv.currency):
+                plan.append(Allocation(pid, "writeoff", WRITE_OFF_ACCOUNT, left,
+                                       pay.tenant_id, inv.number))
+                left = Money.zero(inv.currency)
+            open_left[inv.number] = left
+        if remaining.minor > 0:
+            plan.append(Allocation(pid, WALLET, WALLET, remaining, pay.tenant_id))
+    return plan
