@@ -0,0 +1,179 @@
+"""Allocation of unmatched payments to open invoices, the wallet and write-offs.
+
+``plan_allocations`` is pure: it decides every movement of money first, and the
+caller records them only if the whole plan succeeded. Payments are never edited;
+results live in ``allocations.jsonl`` (one line per movement) and are read back
+by ``balance_for``.
+
+Rules: payments go in payment-date order, then payment id; invoices by due date,
+then invoice number; only FINALIZED invoices (void and draft are skipped). A
+payment in another currency is converted at the PAYMENT date's rate. If an
+invoice has less than 0.50 (invoice currency) left open after a payment touched
+it, the rest goes to account 6900. What no invoice can take goes to the wallet
+in the payment's currency.
+"""
+
+from __future__ import annotations
+
+import fcntl
+import json
+from dataclasses import dataclass
+from datetime import date
+from decimal import Decimal
+from pathlib import Path
+from typing import Iterable
+
+from meterbill.credits import CreditNote
+from meterbill.fx.converter import FxConverter
+from meterbill.invoices import Invoice, InvoiceStatus
+from meterbill.money import Money, exponent_for
+from meterbill.payments.models import Payment
+from meterbill.payments.store import PaymentError, balance_for, matches
+
+ALLOCATIONS_FILE = "allocations.jsonl"
+WRITE_OFF_ACCOUNT = "6900"
+WALLET = "wallet"
+WRITE_OFF_LIMIT = Decimal("0.50")  # major units of the invoice currency
+
+
+def payment_label(number: int) -> str:
+    return f"PAY-{number:05d}"  # padded so text order equals numeric order
+
+
+@dataclass(frozen=True, slots=True)
+class Allocation:
+    payment: int  # id: physical line number in payments.jsonl
+    tenant_id: str
+    kind: str  # "invoice", "wallet" or "writeoff"
+    target: str  # invoice number, "wallet" or account number
+    amount: Money  # in the target's currency
+    source: Money  # part of the payment used (zero for a write-off)
+    date: date  # the payment's date
+    invoice: str | None = None  # invoice number, for kinds "invoice" and "writeoff"
+
+    def line(self) -> str:
+        return f"{payment_label(self.payment)} -> {self.target} {self.amount}"
+
+
+def _to_dict(a: Allocation) -> dict[str, object]:
+    return {
+        "payment": a.payment, "tenant_id": a.tenant_id, "kind": a.kind, "target": a.target,
+        "amount": a.amount.minor, "currency": a.amount.currency,
+        "source_amount": a.source.minor, "source_currency": a.source.currency,
+        "date": a.date.isoformat(), "invoice": a.invoice,
+    }
+
+
+def _from_dict(data: object) -> Allocation:
+    try:
+        return Allocation(
+            payment=data["payment"], tenant_id=data["tenant_id"], kind=data["kind"],
+            target=data["target"], amount=Money(data["amount"], data["currency"]),
+            source=Money(data["source_amount"], data["source_currency"]),
+            date=date.fromisoformat(data["date"]), invoice=data["invoice"],
+        )
+    except (KeyError, TypeError) as exc:
+        raise ValueError(f"malformed allocation: {exc!r}") from None
+
+
+class AllocationStore:
+    def __init__(self, path: str | Path) -> None:
+        self.path = Path(path)
+
+    def load(self) -> list[Allocation]:
+        if not self.path.is_file():
+            return []
+        out = []
+        with open(self.path, encoding="utf-8") as handle:
+            for n, line in enumerate(handle, 1):
+                if not line.strip():
+                    continue
+                try:
+                    out.append(_from_dict(json.loads(line)))
+                except ValueError as exc:
+                    raise PaymentError(f"{self.path.name} line {n}: {exc}") from None
+        return out
+
+    def lock(self):
+        """Exclusive lock for a whole allocation run (plan and record)."""
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        handle = open(self.path.with_name(self.path.name + ".lock"), "w")
+        fcntl.flock(handle, fcntl.LOCK_EX)
+        return handle  # closing it releases the lock
+
+    def append(self, allocations: Iterable[Allocation]) -> None:
+        text = "".join(json.dumps(_to_dict(a)) + "\n" for a in allocations)
+        if not text:
+            return
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        with open(self.path, "a", encoding="utf-8") as handle:
+            handle.write(text)
+            handle.flush()
+
+
+def allocated_ids(allocations: Iterable[Allocation]) -> set[int]:
+    return {a.payment for a in allocations}
+
+
+def plan_allocations(
+    numbered: list[tuple[int, Payment]],
+    invoices: list[Invoice],
+    credit_notes: list[CreditNote],
+    existing: list[Allocation],
+    fx: FxConverter,
+) -> list[Allocation]:
+    """Movements for the not yet allocated payments of ONE tenant that match no invoice."""
+    done = allocated_ids(existing)
+    finalized = [i for i in invoices if i.status is InvoiceStatus.FINALIZED and i.number]
+    all_payments = [p for _, p in numbered]
+    todo = sorted(
+        ((n, p) for n, p in numbered
+         if n not in done and not any(matches(p, i) for i in finalized)),
+        key=lambda item: (item[1].received_date, item[0]),
+    )
+    # open amount per invoice, in minor units, updated as the plan proceeds
+    open_minor: dict[str, int] = {}
+    for inv in finalized:
+        bal = balance_for(inv, all_payments, credit_notes, existing)
+        if bal.open_amount.minor > 0:
+            open_minor[inv.number] = bal.open_amount.minor
+    order = sorted((i for i in finalized if i.number in open_minor),
+                   key=lambda i: (i.due_date or date.max, i.number))
+
+    plan: list[Allocation] = []
+    for n, pay in todo:
+        left = pay.amount  # still unplaced, payment currency
+        for inv in order:
+            if left.minor <= 0:
+                break
+            room = open_minor[inv.number]
+            if room <= 0:
+                continue
+            currency = inv.currency
+            if currency == left.currency:
+                value = left
+            else:
+                value = fx.convert(left, currency, pay.received_date)
+            if value.minor <= 0:
+                continue
+            if value.minor <= room:
+                applied, used = value, left
+            else:
+                applied = Money(room, currency)
+                used = (applied if currency == left.currency
+                        else min(fx.convert(applied, left.currency, pay.received_date), left))
+            plan.append(Allocation(n, pay.tenant_id, "invoice", inv.number, applied, used,
+                                   pay.received_date, inv.number))
+            open_minor[inv.number] = room - applied.minor
+            left = left - used
+            remaining = open_minor[inv.number]
+            limit = WRITE_OFF_LIMIT * (10 ** exponent_for(currency))
+            if 0 < remaining < limit:
+                plan.append(Allocation(n, pay.tenant_id, "writeoff", WRITE_OFF_ACCOUNT,
+                                       Money(remaining, currency), Money.zero(left.currency),
+                                       pay.received_date, inv.number))
+                open_minor[inv.number] = 0
+        if left.minor > 0:
+            plan.append(Allocation(n, pay.tenant_id, "wallet", WALLET, left, left,
+                                   pay.received_date))
+    return plan
