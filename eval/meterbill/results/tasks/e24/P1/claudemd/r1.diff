+++ b/tests/test_allocation.py
@@ -0,0 +1,158 @@
+import json
+from datetime import date
+
+import pytest
+
+from meterbill.cli import main
+from meterbill.invoices import InvoiceStore, SequenceStore, build_invoice
+from meterbill.payments import Payment, PaymentStore, balance_for, AllocationStore
+from meterbill.period import Period
+from meterbill.plans import load_catalog
+from meterbill.wallets import WalletStore
+from meterbill.money import Money
+from meterbill.events import stream_events
+from conftest import event_record
+
+
+@pytest.fixture
+def setup(data_dir, tmp_path):
+    """Two finalized NWD invoices (Sept, Oct; different due dates) and one ACM invoice."""
+    catalog = load_catalog(data_dir)
+    store = InvoiceStore(data_dir / "invoices")
+    seq = SequenceStore(data_dir / "sequences.json")
+    out = {}
+    for key, tenant, period, qty, fin in (
+        ("sep", "NWD", "2026-09", "50000", date(2026, 10, 2)),
+        ("oct", "NWD", "2026-10", "100000", date(2026, 11, 3)),
+        ("acm", "ACM", "2026-10", "100000", date(2026, 11, 3)),
+    ):
+        f = tmp_path / f"{key}.jsonl"
+        ts = f"{period}-15T12:00:00+00:00"
+        f.write_text(json.dumps(event_record(tenant_id=tenant, quantity=qty, timestamp=ts)) + "\n")
+        d = build_invoice(tenant, Period.parse(period), stream_events(f), catalog, fin)
+        store.save_draft(d)
+        out[key] = store.finalize(d.draft_id, seq, 14, fin)
+    return data_dir, out
+
+
+def pay(data_dir, tenant, amount, day="2026-11-10", currency="EUR", ref=None):
+    argv = ["payments", "record", "--tenant", tenant, "--amount", amount, "--currency", currency,
+            "--date", day, "--data-dir", str(data_dir)]
+    if ref:
+        argv += ["--reference", ref]
+    assert main(argv) == 0
+
+
+def allocate(data_dir, tenant="NWD"):
+    return main(["payments", "allocate", "--tenant", tenant, "--data-dir", str(data_dir)])
+
+
+def bal(data_dir, inv):
+    return balance_for(inv, PaymentStore(data_dir / "payments.jsonl").load(), (),
+                       AllocationStore(data_dir / "allocations.jsonl").load())
+
+
+def test_oldest_due_first_then_spill_to_next_and_wallet(setup, capsys):
+    data_dir, inv = setup
+    sep, octo = inv["sep"], inv["oct"]
+    pay(data_dir, "NWD", str(sep.total.to_major() + octo.total.to_major() + 5))
+    capsys.readouterr()
+    assert allocate(data_dir) == 0
+    lines = capsys.readouterr().out.splitlines()
+    assert lines == [
+        f"PAY-00001 -> {sep.number} {sep.total}",
+        f"PAY-00001 -> {octo.number} {octo.total}",
+        "PAY-00001 -> wallet 5.00 EUR",
+    ]
+    assert bal(data_dir, sep).paid and bal(data_dir, octo).paid
+    assert WalletStore(data_dir).balance("NWD", "EUR") == Money(500, "EUR")
+    capsys.readouterr()
+    main(["invoices", "show", sep.number, "--data-dir", str(data_dir)])
+    assert "Settled: yes" in capsys.readouterr().out
+
+
+def test_rerun_is_a_no_op_and_list_shows_allocated(setup, capsys):
+    data_dir, inv = setup
+    pay(data_dir, "NWD", "10.00")
+    assert allocate(data_dir) == 0
+    capsys.readouterr()
+    assert allocate(data_dir) == 0
+    assert capsys.readouterr().out == ""
+    main(["payments", "list", "--tenant", "NWD", "--unmatched", "--data-dir", str(data_dir)])
+    assert "allocated" not in capsys.readouterr().out
+    main(["payments", "list", "--tenant", "NWD", "--data-dir", str(data_dir)])
+    assert "allocated" in capsys.readouterr().out
+
+
+def test_payment_order_date_then_id_and_matched_untouched(setup, capsys):
+    data_dir, inv = setup
+    sep = inv["sep"]
+    pay(data_dir, "NWD", "1.00", day="2026-11-12")           # id 1, later date
+    pay(data_dir, "NWD", "2.00", day="2026-11-10")           # id 2
+    pay(data_dir, "NWD", "3.00", day="2026-11-10")           # id 3
+    pay(data_dir, "NWD", "4.00", day="2026-11-10", ref=inv["oct"].number)  # matched: skipped
+    capsys.readouterr()
+    allocate(data_dir)
+    lines = capsys.readouterr().out.splitlines()
+    assert [l.split(" -> ")[0] for l in lines] == ["PAY-00002", "PAY-00003", "PAY-00001"]
+    assert all(f"-> {sep.number} " in l for l in lines)
+
+
+def test_void_and_other_tenant_invoices_skipped(setup, capsys):
+    data_dir, inv = setup
+    store = InvoiceStore(data_dir / "invoices")
+    store.void(inv["sep"].number, "test")
+    pay(data_dir, "NWD", "1.00")
+    capsys.readouterr()
+    allocate(data_dir)
+    out = capsys.readouterr().out
+    assert inv["sep"].number not in out and inv["acm"].number not in out
+    assert f"-> {inv['oct'].number} 1.00 EUR" in out
+
+
+def test_write_off_small_remainder(setup, capsys):
+    data_dir, inv = setup
+    sep = inv["sep"]
