+++ b/meterbill/payments/allocate.py
@@ -0,0 +1,155 @@
+"""Allocation of unmatched payments to a tenant's open invoices (decisions #45, #59).
+
+Payments are taken in (payment date, payment id) order. Each goes to the open
+finalized invoices with the oldest due date first (ties: lower invoice number).
+A payment in another currency than the invoice is converted at the rate of the
+payment date. What is left of a payment after every open invoice is paid goes to
+the tenant's wallet in the payment's currency. An invoice that one of these
+payments leaves with less than 0.50 open is written off to ledger account 6900.
+Voided and draft invoices are never touched.
+
+Results are appended to ``allocations.jsonl``; a payment with any line there counts
+as allocated and is no longer unmatched. Nothing is written if planning fails.
+"""
+
+from __future__ import annotations
+
+import fcntl
+import json
+from datetime import date
+from decimal import ROUND_HALF_EVEN, Decimal
+from pathlib import Path
+from typing import Iterable
+
+from meterbill.credits import CreditNote
+from meterbill.fx.converter import FxConverter
+from meterbill.invoices import Invoice, InvoiceStatus
+from meterbill.money import Money
+from meterbill.payments.models import Allocation, Payment
+from meterbill.payments.store import PaymentError, balance_for, unmatched_payments
+
+ALLOCATIONS_FILE = "allocations.jsonl"
+WRITE_OFF_ACCOUNT = "6900"  # not in accounts.json yet; to be confirmed with finance (#59)
+WRITE_OFF_BELOW = Decimal("0.50")  # major units of the invoice currency
+
+
+def _to_dict(a: Allocation) -> dict[str, object]:
+    return {"payment": a.payment_id, "tenant_id": a.tenant_id, "kind": a.kind,
+            "target": a.target, "invoice": a.invoice, "amount": a.amount.minor,
+            "currency": a.amount.currency, "date": a.date.isoformat()}
+
+
+def _from_dict(data: object) -> Allocation:
+    try:
+        if data["kind"] not in ("invoice", "writeoff", "wallet"):
+            raise ValueError("unknown kind")
+        return Allocation(data["payment"], data["tenant_id"], data["kind"], data["target"],
+                          Money(data["amount"], data["currency"]),
+                          date.fromisoformat(data["date"]), data["invoice"])
+    except (KeyError, TypeError) as exc:
+        raise ValueError(f"malformed allocation: {exc!r}") from None
+
+
+class AllocationStore:
+    def __init__(self, path: str | Path) -> None:
+        self.path = Path(path)
+
+    def load(self) -> list[Allocation]:
+        if not self.path.is_file():
+            return []
+        with open(self.path, encoding="utf-8") as handle:
+            return self._read(handle)
+
+    def _read(self, handle) -> list[Allocation]:
+        out = []
+        for n, line in enumerate(handle, 1):
+            if line.strip():
+                try:
+                    out.append(_from_dict(json.loads(line)))
+                except ValueError as exc:
+                    raise PaymentError(f"{self.path.name} line {n}: {exc}") from None
+        return out
+
+    def append_locked(self, build):
+        """Under an exclusive lock call ``build(existing)`` -> list of new allocations,
+        append them in one write and return them."""
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        with open(self.path, "a+", encoding="utf-8") as handle:
+            fcntl.flock(handle, fcntl.LOCK_EX)
+            handle.seek(0)
+            new = build(self._read(handle))
+            if new:
+                handle.seek(0, 2)
+                handle.write("".join(json.dumps(_to_dict(a)) + "\n" for a in new))
+                handle.flush()
+        return new
+
+
+def plan_allocations(
+    tenant_id: str,
+    payments: Iterable[Payment],
+    invoices: Iterable[Invoice],
+    credit_notes: Iterable[CreditNote],
+    existing: Iterable[Allocation],
+    fx: FxConverter,
+) -> list[Allocation]:
+    """The allocations for the tenant's unmatched payments, in output order."""
+    payments = [p for p in payments if p.tenant_id == tenant_id]
+    existing = list(existing)
+    credit_notes = list(credit_notes)
+    finalized = [i for i in invoices
+                 if i.tenant_id == tenant_id and i.status is InvoiceStatus.FINALIZED
+                 and i.number is not None]
+    todo = sorted(unmatched_payments(payments, finalized, existing),
+                  key=lambda p: (p.received_date, p.id))
+    # Open amounts count payments matched by reference and earlier allocations.
+    open_left = {i.number: balance_for(i, payments, credit_notes, existing).open_amount
+                 for i in finalized}
+    order = sorted(finalized, key=lambda i: (i.due_date or date.max, i.number))
+    by_number = {i.number: i for i in finalized}
+    out: list[Allocation] = []
+    last_payment: dict[str, Payment] = {}  # invoice number -> latest payment that paid it
+    for p in todo:
+        remaining = p.amount
+        for inv in order:
+            if remaining.minor <= 0:
+                break
+            room = open_left[inv.number]
+            if room.minor <= 0:
+                continue
+            if p.amount.currency == inv.currency:
+                rate = None
+                offered = remaining
+            else:
+                rate = fx.rate(p.amount.currency, inv.currency, p.received_date)
+                offered = FxConverter.apply(remaining, inv.currency, rate)
+            if offered.minor <= 0:
+                break  # too small to pay anything in the invoice currency
+            if offered <= room:
+                paid, remaining = offered, Money.zero(remaining.currency)
+            else:
+                paid = room
+                if rate is None:
+                    used = room
+                else:
+                    used = Money.from_major(room.to_major() / rate, remaining.currency,
+                                            ROUND_HALF_EVEN)
+                remaining = Money(max(remaining.minor - used.minor, 0), remaining.currency)
+            open_left[inv.number] = room - paid
+            last_payment[inv.number] = p
+            out.append(Allocation(p.id, tenant_id, "invoice", inv.number, paid,
+                                  p.received_date))
+        if remaining.minor > 0:
+            out.append(Allocation(p.id, tenant_id, "wallet", "wallet", remaining,
+                                  p.received_date))
+    # Residuals left by this run's payments are written off, listed with the payment
+    # that left them (after that payment's invoice lines, before its wallet line).
+    for number, p in last_payment.items():
+        left = open_left[number]
+        if 0 < left.minor and left.to_major() < WRITE_OFF_BELOW:
+            alloc = Allocation(p.id, tenant_id, "writeoff", WRITE_OFF_ACCOUNT, left,
+                               p.received_date, by_number[number].number)
+            at = max(k for k, a in enumerate(out) if a.payment_id == p.id and a.kind == "invoice"
+                     and a.target == number)
+            out.insert(at + 1, alloc)
+    return out
