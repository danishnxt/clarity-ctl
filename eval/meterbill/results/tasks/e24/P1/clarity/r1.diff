diff --git a/tests/test_allocation.py b/tests/test_allocation.py
new file mode 100644
index 0000000..9867d74
--- /dev/null
+++ b/tests/test_allocation.py
@@ -0,0 +1,111 @@
+import json
+from datetime import date
+
+import pytest
+
+from conftest import event_record
+from meterbill.cli import main
+from meterbill.events import stream_events
+from meterbill.invoices import InvoiceStore, SequenceStore, build_invoice
+from meterbill.money import Money
+from meterbill.payments import AllocationStore, Payment, PaymentStore, balance_for
+from meterbill.period import Period
+from meterbill.plans import load_catalog
+from meterbill.wallets import WalletStore
+
+
+@pytest.fixture
+def two(data_dir, tmp_path):
+    """Two finalized NWD invoices: older due date first (2026-09), then 2026-10."""
+    catalog = load_catalog(data_dir)
+    store = InvoiceStore(data_dir / "invoices")
+    seq = SequenceStore(data_dir / "sequences.json")
+    out = []
+    for period, qty, fin in (("2026-10", "100000", date(2026, 11, 3)),
+                             ("2026-09", "50000", date(2026, 10, 3))):
+        f = tmp_path / f"{period}.jsonl"
+        f.write_text(json.dumps(event_record(tenant_id="NWD", quantity=qty,
+                                             timestamp=f"{period}-05T10:00:00Z")) + "\n")
+        d = build_invoice("NWD", Period.parse(period), stream_events(f), catalog, fin)
+        store.save_draft(d)
+        out.append(store.finalize(d.draft_id, seq, 14, fin))
+    return data_dir, sorted(out, key=lambda i: i.due_date)
+
+
+def pay(data_dir, amount, when="2026-11-10", currency="EUR", ref=None, tenant="NWD"):
+    PaymentStore(data_dir / "payments.jsonl").record(
+        Payment(tenant, Money.from_major(amount, currency), date.fromisoformat(when), ref))
+
+
+def allocate(data_dir, capsys):
+    capsys.readouterr()
+    assert main(["payments", "allocate", "--tenant", "NWD", "--data-dir", str(data_dir)]) == 0
+    return capsys.readouterr().out.splitlines()
+
+
+def open_of(data_dir, invoice):
+    return balance_for(invoice, PaymentStore(data_dir / "payments.jsonl").load(), (),
+                       AllocationStore(data_dir / "allocations.jsonl").load())
+
+
+def test_spreads_oldest_due_first_and_wallet_leftover(two, capsys):
+    data_dir, (old, new) = two
+    total = (old.total + new.total).to_major() + 5
+    pay(data_dir, str(total))
+    lines = allocate(data_dir, capsys)
+    assert lines == [f"PAY-000001 -> {old.number} {old.total}",
+                     f"PAY-000001 -> {new.number} {new.total}",
+                     "PAY-000001 -> wallet 5.00 EUR"]
+    assert open_of(data_dir, old).paid and open_of(data_dir, new).paid
+    assert WalletStore(data_dir).balance("NWD", "EUR") == Money(500, "EUR")
+    assert allocate(data_dir, capsys) == []  # idempotent
+
+
+def test_order_by_date_then_id_and_partial(two, capsys):
+    data_dir, (old, new) = two
+    pay(data_dir, "10.00", when="2026-11-12")
+    pay(data_dir, "10.00", when="2026-11-10")
+    lines = allocate(data_dir, capsys)
+    assert lines == [f"PAY-000002 -> {old.number} 10.00 EUR",
+                     f"PAY-000001 -> {old.number} 10.00 EUR"]
+    assert open_of(data_dir, old).open_amount == old.total - Money(2000, "EUR")
+
+
+def test_void_invoice_skipped(two, capsys):
+    data_dir, (old, new) = two
+    InvoiceStore(data_dir / "invoices").void(old.number, "test")
+    pay(data_dir, "10.00")
+    assert allocate(data_dir, capsys) == [f"PAY-000001 -> {new.number} 10.00 EUR"]
+
+
+def test_residual_under_fifty_cents_written_off(two, capsys):
+    data_dir, (old, new) = two
+    short = (old.total.to_major() - Money(30, "EUR").to_major())
+    pay(data_dir, str(short))
+    lines = allocate(data_dir, capsys)
+    assert lines == [f"PAY-000001 -> {old.number} {Money.from_major(short, 'EUR')}",
+                     "PAY-000001 -> 6900 0.30 EUR"]
+    assert open_of(data_dir, old).paid
+    # exactly 0.50 stays open
+    pay(data_dir, str(new.total.to_major() - Money(50, "EUR").to_major()))
+    assert len(allocate(data_dir, capsys)) == 1
+    assert open_of(data_dir, new).open_amount == Money(50, "EUR")
+
+
+def test_foreign_payment_converted_at_payment_date(two, capsys):
+    data_dir, (old, new) = two
+    pay(data_dir, "10.00", when="2026-10-01", currency="USD")
+    (line,) = allocate(data_dir, capsys)
+    assert line == f"PAY-000001 -> {old.number} 9.25 EUR"  # 10 / 1.0812
+
