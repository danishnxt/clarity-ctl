@@ -99,6 +99,38 @@ class SequenceStore:
         data = self._read(entity)
         return self._counters(data, tenant_id, entity).get(str(year), 0)
 
+    def adopt_entity_layout(self, entity: str) -> None:
+        """Move an old ``{tenant: {year: last}}`` file under ``entity`` (no-op if already nested).
+
+        Pre-entity counters all belonged to the one original entity, so numbering
+        continues there; other entities start at 1.
+        """
+        lock_path = self.path.with_name(self.path.name + ".lock")
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        with open(lock_path, "w") as lock:
+            fcntl.flock(lock, fcntl.LOCK_EX)
+            try:
+                data = self._read(None)
+            except SequenceError:
+                return  # not the old layout (or broken); next_number reports it
+            if not data:
+                return
+            self._write(migrate_to_entity_sequences(data, entity.upper()))
+
+    def _write(self, data: dict) -> None:
+        fd, tmp = tempfile.mkstemp(dir=self.path.parent, prefix=self.path.name, suffix=".tmp")
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as handle:
+                json.dump(data, handle, indent=2, sort_keys=True)
+                handle.write("\n")
+                handle.flush()
+                os.fsync(handle.fileno())
+            os.replace(tmp, self.path)
+        except BaseException:
+            if os.path.exists(tmp):
+                os.unlink(tmp)
+            raise
+
     def next_number(self, tenant_id: str, year: int, entity: str | None = None) -> str:
         key = tenant_id.upper()
         lock_path = self.path.with_name(self.path.name + ".lock")
