+def test_credit_note_takes_invoice_entity_with_own_sequence(invoice, tmp_path):
+    import dataclasses
+    us = dataclasses.replace(invoice, entity="MBUS")
+    store = SequenceStore(tmp_path / "cn.json", "CN")
+    d = date(2027, 1, 5)
+    a = issue_credit_note(invoice, reason="r", store=store, issue_date=d)
+    b = issue_credit_note(us, reason="r", store=store, issue_date=d)
+    c = issue_credit_note(invoice, reason="r", store=store, issue_date=d)
+    assert (a.number, b.number, c.number) == (
+        "CN-MBDE-NWD-2027-00001", "CN-MBUS-NWD-2027-00001", "CN-MBDE-NWD-2027-00002")
+    assert b.entity == "MBUS"
+    # separate from the invoice sequence
+    assert SequenceStore(tmp_path / "cn.json", "CN").last_issued("NWD", 2027, "MBUS") == 1
+
+
+def test_old_credit_sequences_migrate_and_old_notes_load(invoice, tmp_path):
+    path = tmp_path / "cn.json"
+    path.write_text('{"NWD": {"2027": 3}}')
+    note = issue_credit_note(invoice, reason="r", store=SequenceStore(path, "CN"),
+                             issue_date=date(2027, 1, 5))
+    assert note.number == "CN-MBDE-NWD-2027-00004"
+    from meterbill.credits import credit_note_from_dict, credit_note_to_dict
+    doc = credit_note_to_dict(note)
+    assert credit_note_from_dict(doc) == note
+    del doc["entity"]
+    doc["number"] = "CN-NWD-2027-00003"
+    old = credit_note_from_dict(doc)
+    assert old.entity is None and old.number == "CN-NWD-2027-00003"
