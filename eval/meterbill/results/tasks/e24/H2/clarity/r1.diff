+def _migrate_credit_sequences(path: Path) -> None:
+    """Move an old ``{tenant: {year: n}}`` credit counter file under MBDE (continues numbering)."""
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except (FileNotFoundError, json.JSONDecodeError):
+        return
+    if isinstance(data, dict):
+        migrated = migrate_to_entity_sequences(data, "MBDE")
+        if migrated is not data:
+            path.write_text(json.dumps(migrated, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+
+
