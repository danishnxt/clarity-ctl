+def test_credit_note_takes_entity_of_invoice(invoice, tmp_path):
+    from dataclasses import replace
+    from meterbill.credits import credit_note_from_json, credit_note_to_json
+
+    us = replace(invoice, entity="MBUS")  # tenant moved later; the invoice's entity rules
+    store = SequenceStore(tmp_path / "cn.json", "CN")
+    d = issue_credit_note(invoice, reason="r", store=store, issue_date=date(2027, 1, 5))
+    u = issue_credit_note(us, reason="r", store=store, issue_date=date(2027, 1, 5))
+    u2 = issue_credit_note(us, reason="r", store=store, issue_date=date(2027, 1, 6))
+    assert (d.number, u.number, u2.number) == (
+        "CN-MBDE-NWD-2027-00001", "CN-MBUS-NWD-2027-00001", "CN-MBUS-NWD-2027-00002")
+    assert u.entity == "MBUS"
+    assert credit_note_from_json(credit_note_to_json(u)) == u
+
+
+def test_old_format_credit_note_loads(invoice, tmp_path):
+    from meterbill.credits import credit_note_from_dict, credit_note_to_dict
+
+    note = issue_credit_note(invoice, reason="r", store=SequenceStore(tmp_path / "c.json", "CN"))
+    doc = credit_note_to_dict(note)
+    del doc["entity"]
+    doc["number"] = "CN-NWD-2026-00007"
+    old = credit_note_from_dict(doc)
+    assert old.entity is None and old.number == "CN-NWD-2026-00007"
+    assert "entity" not in credit_note_to_dict(old)
+
+
+def test_old_credit_sequence_file_migrates_under_mbde(tmp_path):
+    from meterbill.cli import _migrate_credit_sequences
+
+    path = tmp_path / "credit_sequences.json"
+    path.write_text('{"NWD": {"2026": 4}}')
+    _migrate_credit_sequences(path)
+    assert json.loads(path.read_text()) == {"MBDE": {"NWD": {"2026": 4}}}
+    assert SequenceStore(path, "CN").next_number("NWD", 2026, "MBDE") == "CN-MBDE-NWD-2026-00005"
