@@ -99,6 +99,38 @@ class SequenceStore:
         data = self._read(entity)
         return self._counters(data, tenant_id, entity).get(str(year), 0)
 
+    def _write(self, data: dict) -> None:
+        fd, tmp = tempfile.mkstemp(dir=self.path.parent, prefix=self.path.name, suffix=".tmp")
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as handle:
+                json.dump(data, handle, indent=2, sort_keys=True)
+                handle.write("\n")
+                handle.flush()
+                os.fsync(handle.fileno())
+            os.replace(tmp, self.path)
+        except BaseException:
+            if os.path.exists(tmp):
+                os.unlink(tmp)
+            raise
+
+    def migrate_to_entity(self, entity: str) -> bool:
+        """Move an old ``{tenant: {year: last}}`` file under ``entity`` (counters continue).
+
+        Returns True when the file was rewritten; a missing, empty or already
+        migrated file is left alone. An invalid file raises ``SequenceError``.
+        """
+        lock_path = self.path.with_name(self.path.name + ".lock")
+        if not self.path.exists():
+            return False
+        with open(lock_path, "w") as lock:
+            fcntl.flock(lock, fcntl.LOCK_EX)
+            data = self._read(None)
+            migrated = migrate_to_entity_sequences(data, entity.upper())
+            if migrated == data:
+                return False
+            self._write(migrated)
+            return True
+
     def next_number(self, tenant_id: str, year: int, entity: str | None = None) -> str:
         key = tenant_id.upper()
         lock_path = self.path.with_name(self.path.name + ".lock")
