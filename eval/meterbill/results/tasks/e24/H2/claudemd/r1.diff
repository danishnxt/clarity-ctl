+def test_credit_note_takes_invoice_entity_and_own_sequence(invoice, tmp_path):
+    from dataclasses import replace
+
+    store = SequenceStore(tmp_path / "cn.json", "CN")
+    us = replace(invoice, entity="MBUS")
+    d = date(2026, 11, 3)
+    assert issue_credit_note(us, reason="r", store=store, issue_date=d).number == "CN-MBUS-NWD-2026-00001"
+    assert issue_credit_note(invoice, reason="r", store=store, issue_date=d).number == "CN-MBDE-NWD-2026-00001"
+    assert issue_credit_note(us, reason="r", store=store, issue_date=d).number == "CN-MBUS-NWD-2026-00002"
+    assert json.loads((tmp_path / "cn.json").read_text()) == {
+        "MBUS": {"NWD": {"2026": 2}}, "MBDE": {"NWD": {"2026": 1}}}
+
+
