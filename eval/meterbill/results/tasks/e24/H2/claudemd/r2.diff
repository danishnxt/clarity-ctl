+def test_note_takes_entity_of_invoice_not_tenant(invoice, tmp_path):
+    from dataclasses import replace
+
+    us = replace(invoice, entity="MBUS")  # tenant has since moved to MBDE; invoice stays MBUS
+    store = SequenceStore(tmp_path / "cn.json", "CN")
+    a = issue_credit_note(us, [1], reason="r", store=store, issue_date=date(2026, 12, 1))
+    b = issue_credit_note(invoice, [1], reason="r", store=store, issue_date=date(2026, 12, 1))
+    c = issue_credit_note(us, [1], reason="r", store=store, issue_date=date(2026, 12, 1))
+    assert (a.number, b.number, c.number) == (
+        "CN-MBUS-NWD-2026-00001", "CN-MBDE-NWD-2026-00001", "CN-MBUS-NWD-2026-00002")
+    assert a.entity == "MBUS"
