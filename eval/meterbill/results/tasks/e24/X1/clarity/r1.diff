diff --git a/meterbill/ingest/purge.py b/meterbill/ingest/purge.py
new file mode 100644
index 0000000..11c4c1c
--- /dev/null
+++ b/meterbill/ingest/purge.py
@@ -0,0 +1,148 @@
+"""Retention purge for stored data (decisions #47/#52).
+
+* ``rejects/<YYYY-MM-DD>.jsonl`` is kept 30 days: deleted once older than that.
+* Raw event month files are kept until 25 months after the END of their billing
+  period (the exclusive end, i.e. the first day of the next month); deleted once
+  the as-of date is strictly after that day.
+* HARD RULE, whatever the age: events of a period with no FINALIZED invoice, or
+  with a credit note issued in the last 12 months, are never deleted. A UTC month
+  file is also read by the neighbouring periods of tenants whose timezone is not
+  UTC, so the file is kept unless every period that can read it is purgeable.
+
+Only data files are listed and counted; the ``.idem`` index (and legacy ``.seen``)
+beside a deleted month file is removed silently with it, before the data file, so a
+crash leaves a file that simply rebuilds its index.
+"""
+
+from __future__ import annotations
+
+import calendar
+import re
+import sys
+from dataclasses import dataclass
+from datetime import date, timedelta
+from pathlib import Path
+
+from meterbill.credits import CreditNote
+from meterbill.exports import load_documents
+from meterbill.invoices import Invoice, InvoiceStatus, InvoiceStore
+from meterbill.ingest.store import is_valid_tenant_dir_name
+from meterbill.period import Period
+from meterbill.plans import CatalogError, load_catalog
+
+REJECT_DAYS = 30
+EVENT_MONTHS = 25
+CREDIT_MONTHS = 12
+_DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
+_MONTH_RE = re.compile(r"^\d{4}-\d{2}$")
+
+
+def add_months(day: date, months: int) -> date:
+    index = day.year * 12 + day.month - 1 + months
+    year, month = divmod(index, 12)
+    return date(year, month + 1, min(day.day, calendar.monthrange(year, month + 1)[1]))
+
+
+def _shift(period: Period, months: int) -> Period:
+    shifted = add_months(period.first_day, months)
+    return Period(shifted.year, shifted.month)
+
+
+@dataclass
+class _Facts:
+    finalized: set[tuple[str, str]]  # (tenant, period) with a finalized invoice
+    recent_credit: set[tuple[str, str]]  # (tenant, period) credited recently
+    recent_credit_tenants: set[str]  # recent credit whose invoice could not be found
+
+
+def _gather(data_dir: Path, today: date) -> _Facts:
+    invoices: dict[str, Invoice] = {}
+    finalized: set[tuple[str, str]] = set()
+    store = InvoiceStore(data_dir / "invoices")
+    root = data_dir / "invoices"
+    tenants = sorted(p.name for p in root.iterdir() if p.is_dir()) if root.is_dir() else []
+    documents: list[object] = []
+    if (data_dir / "documents").is_dir():
+        documents = list(load_documents(data_dir / "documents"))
+    all_invoices = [i for t in tenants for i in store.list(t)]
+    all_invoices += [d for d in documents if isinstance(d, Invoice)]
+    for inv in all_invoices:
+        if inv.number:
+            invoices[inv.number] = inv
+        if inv.status is InvoiceStatus.FINALIZED:
+            finalized.add((inv.tenant_id, str(inv.period)))
+    since = add_months(today, -CREDIT_MONTHS)
+    credited: set[tuple[str, str]] = set()
+    unresolved: set[str] = set()
+    for doc in documents:
+        if isinstance(doc, CreditNote) and doc.issue_date >= since:
+            inv = invoices.get(doc.invoice_number)
+            if inv is None:
+                unresolved.add(doc.tenant_id)
+            else:
+                credited.add((inv.tenant_id, str(inv.period)))
+    return _Facts(finalized, credited, unresolved)
+
+
+def _purgeable(tenant: str, period: Period, today: date, facts: _Facts) -> bool:
+    key = (tenant, str(period))
+    if tenant in facts.recent_credit_tenants or key in facts.recent_credit:
+        return False
+    if key not in facts.finalized:
+        return False
+    return today > add_months(period.end_day, EVENT_MONTHS)
+
+
+def plan_purge(data_dir: str | Path, today: date) -> list[tuple[Path, list[Path]]]:
+    """(data file, sibling index files) to delete, sorted by data file path."""
+    data_dir = Path(data_dir)
+    out: list[tuple[Path, list[Path]]] = []
+    rejects = data_dir / "rejects"
+    if rejects.is_dir():
+        cutoff = today - timedelta(days=REJECT_DAYS)
+        for path in rejects.glob("*.jsonl"):
+            if not _DATE_RE.match(path.stem):
+                continue
+            try:
+                day = date.fromisoformat(path.stem)
+            except ValueError:
+                continue
+            if day < cutoff:
+                out.append((path, []))
+    events = data_dir / "events"
+    if events.is_dir():
+        facts = _gather(data_dir, today)
+        try:
+            catalog = load_catalog(data_dir)
+        except CatalogError as exc:
+            print(f"warning: tenants unreadable, treating all as non-UTC: {exc}", file=sys.stderr)
+            catalog = None
+        for path in events.glob("*/*.jsonl"):
+            tenant = path.parent.name
+            if not is_valid_tenant_dir_name(tenant) or not _MONTH_RE.match(path.stem):
+                continue
+            try:
+                period = Period.parse(path.stem)
+            except ValueError:
+                continue
+            utc_only = False
+            if catalog is not None:
+                try:
+                    utc_only = catalog.tenant(tenant).tz == "UTC"
+                except CatalogError:
+                    utc_only = False
+            periods = [period] if utc_only else [_shift(period, -1), period, _shift(period, 1)]
+            if all(_purgeable(tenant, p, today, facts) for p in periods):
+                out.append((path, [path.with_suffix(".idem"), path.with_suffix(".seen")]))
+    return sorted(out, key=lambda pair: str(pair[0]))
+
+
+def purge(data_dir: str | Path, today: date, *, dry_run: bool = False) -> list[Path]:
+    """Delete (unless ``dry_run``) what is past retention; return the data files, sorted."""
+    plan = plan_purge(data_dir, today)
+    if not dry_run:
+        for path, indexes in plan:
+            for index in indexes:
+                index.unlink(missing_ok=True)
+            path.unlink(missing_ok=True)
+    return [path for path, _ in plan]
diff --git a/tests/test_purge.py b/tests/test_purge.py
new file mode 100644
index 0000000..545e835
--- /dev/null
+++ b/tests/test_purge.py
@@ -0,0 +1,118 @@
+import json
+from datetime import date
+from decimal import Decimal
+
+from conftest import event_record
+
+from meterbill.cli import main
+from meterbill.credits.models import CreditNote, CreditNoteLine
+from meterbill.credits.serialization import credit_note_to_json
+from meterbill.invoices import Invoice, InvoiceStatus, invoice_to_json
+from meterbill.money import Money
+from meterbill.period import Period
+
+TODAY = "2026-11-11"
+
+
+def seed(data_dir, tenant, month, idem=True):
+    path = data_dir / "events" / tenant / f"{month}.jsonl"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(event_record(tenant_id=tenant)) + "\n")
+    if idem:
+        path.with_suffix(".idem").write_text('"k1"\n')
+    return path
+
+
+def invoice(data_dir, tenant, period, status=InvoiceStatus.FINALIZED, number=None):
+    number = number or f"INV-MBDE-{tenant}-{period[:4]}-{period[5:]}001"
+    inv = Invoice(tenant, tenant, Period.parse(period), "EUR", (), date(2020, 1, 1),
+                  number=number, status=status)
+    path = data_dir / "invoices" / tenant / f"{number}.json"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(invoice_to_json(inv))
+    return number
+
+
+def credit(data_dir, tenant, inv_number, issued):
+    note = CreditNote("CN-MBDE-%s-2026-00001" % tenant, inv_number, tenant, tenant, "EUR", "r",
+                      issued, (CreditNoteLine(1, "m", None, Decimal(-1), Money(-100, "EUR"),
+                                              Decimal("0.19"), Money(-19, "EUR")),))
+    path = data_dir / "documents" / f"{note.number}.json"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(credit_note_to_json(note))
+
+
+def run(data_dir, capsys, *extra):
+    capsys.readouterr()
+    assert main(["purge", "--date", TODAY, "--data-dir", str(data_dir), *extra]) == 0
+    return capsys.readouterr().out.splitlines()
+
+
+def test_old_finalized_month_deleted_with_index_but_only_data_listed(data_dir, capsys):
+    f = seed(data_dir, "GLB", "2024-01")
+    invoice(data_dir, "GLB", "2024-01")
+    assert run(data_dir, capsys) == [str(f)]
+    assert not f.exists() and not f.with_suffix(".idem").exists()
+
+
+def test_dry_run_deletes_nothing(data_dir, capsys):
+    f = seed(data_dir, "GLB", "2024-01")
+    invoice(data_dir, "GLB", "2024-01")
+    assert run(data_dir, capsys, "--dry-run") == [str(f)]
+    assert f.exists() and f.with_suffix(".idem").exists()
+
+
+def test_age_boundary_25_months_after_period_end(data_dir, capsys):
+    f = seed(data_dir, "GLB", "2024-10")  # period ends 2024-11-01; +25 months = 2026-12-01
+    invoice(data_dir, "GLB", "2024-10")
+    for day, expected in (("2026-12-01", []), ("2026-12-02", [str(f)])):
+        capsys.readouterr()
+        main(["purge", "--date", day, "--dry-run", "--data-dir", str(data_dir)])
+        assert capsys.readouterr().out.splitlines() == expected
+
+
+def test_never_without_finalized_invoice(data_dir, capsys):
+    seed(data_dir, "GLB", "2020-01")  # no invoice
+    seed(data_dir, "GLB", "2020-02")
+    invoice(data_dir, "GLB", "2020-02", status=InvoiceStatus.VOID)
+    assert run(data_dir, capsys) == []
+
+
+def test_recent_credit_note_protects_its_period_only(data_dir, capsys):
+    a = seed(data_dir, "GLB", "2024-01")
+    b = seed(data_dir, "GLB", "2024-02")
+    n1 = invoice(data_dir, "GLB", "2024-01")
+    invoice(data_dir, "GLB", "2024-02")
+    credit(data_dir, "GLB", n1, date(2026, 6, 1))
+    assert run(data_dir, capsys, "--dry-run") == [str(b)]
+    credit_old = data_dir / "documents"
+    for p in credit_old.iterdir():
+        p.unlink()
+    credit(data_dir, "GLB", n1, date(2025, 11, 10))  # more than 12 months ago
+    assert run(data_dir, capsys, "--dry-run") == [str(a), str(b)]
+
+
+def test_non_utc_tenant_needs_neighbouring_periods_finalized(data_dir, capsys):
+    f = seed(data_dir, "NWD", "2024-01")  # Berlin: also read by 2023-12 and 2024-02
+    seed(data_dir, "NWD", "2024-02")
+    for p in ("2023-12", "2024-01"):
+        invoice(data_dir, "NWD", p)
+    assert run(data_dir, capsys, "--dry-run") == []
+    invoice(data_dir, "NWD", "2024-02")
+    assert run(data_dir, capsys, "--dry-run") == [str(f)]  # 2024-02 still needs 2024-03
+
+
+def test_rejects_kept_30_days_and_output_sorted(data_dir, capsys):
+    rej = data_dir / "rejects"
+    rej.mkdir()
+    for name in ("2026-10-12", "2026-10-11", "2026-10-13", "notes"):
+        (rej / f"{name}.jsonl").write_text("{}\n")
+    ev = seed(data_dir, "GLB", "2024-01")
+    invoice(data_dir, "GLB", "2024-01")
+    out = run(data_dir, capsys)
+    assert out == sorted(out) == [str(ev), str(rej / "2026-10-11.jsonl")]
+    assert (rej / "2026-10-12.jsonl").exists() and (rej / "notes.jsonl").exists()
+
+
+def test_bad_date(data_dir, capsys):
+    assert main(["purge", "--date", "nope", "--data-dir", str(data_dir)]) == 1
