diff --git a/meterbill/ingest/purge.py b/meterbill/ingest/purge.py
new file mode 100644
index 0000000..1c694a1
--- /dev/null
+++ b/meterbill/ingest/purge.py
@@ -0,0 +1,167 @@
+"""Retention purge of stored raw events and reject logs.
+
+Rules (user): event month files are kept 25 months after the END of their billing
+period; ``rejects/`` files 30 days. Events are NEVER deleted while any billing period
+they touch has no finalized invoice, or has a credit note issued in the last 12 months.
+All boundaries are conservative: data goes only when strictly past its retention.
+
+Event files are by UTC month but billing periods are the tenant's LOCAL month, so one
+file can touch up to three periods; every one of them must qualify.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from datetime import date, timedelta
+from pathlib import Path
+
+from meterbill.credits.models import CreditNote
+from meterbill.exports.csv_export import load_documents
+from meterbill.invoices.models import Invoice, InvoiceStatus
+from meterbill.invoices.serialization import invoice_from_json
+from meterbill.ingest.store import is_valid_tenant_dir_name
+from meterbill.period import Period
+
+EVENT_RETENTION_MONTHS = 25
+REJECT_RETENTION_DAYS = 30
+CREDIT_NOTE_PROTECTION_MONTHS = 12
+
+_MONTH_FILE = re.compile(r"^(\d{4})-(\d{2})\.jsonl$")
+_REJECT_FILE = re.compile(r"^(\d{4}-\d{2}-\d{2})\.jsonl$")
+
+
+def add_months(day: date, months: int) -> date:
+    index = day.year * 12 + day.month - 1 + months
+    year, month = divmod(index, 12)
+    month += 1
+    # clamp to the end of a shorter month
+    for d in (day.day, 30, 29, 28):
+        try:
+            return date(year, month, d)
+        except ValueError:
+            continue
+    raise AssertionError("unreachable")
+
+
+def _next_period(period: Period) -> Period:
+    return Period(period.year + (period.month == 12), period.month % 12 + 1)
+
+
+def _prev_period(period: Period) -> Period:
+    return Period(period.year - (period.month == 1), (period.month - 2) % 12 + 1)
+
+
+def _load_invoices(data_dir: Path) -> list[Invoice]:
+    invoices: list[Invoice] = []
+    store_root = data_dir / "invoices"
+    if store_root.is_dir():
+        for path in sorted(store_root.glob("*/*.json")):
+            invoices.append(invoice_from_json(path.read_text(encoding="utf-8")))
+    docs = data_dir / "documents"
+    if docs.is_dir():
+        invoices.extend(d for d in load_documents(docs) if isinstance(d, Invoice))
+    return invoices
+
+
+def _credit_notes(data_dir: Path) -> list[CreditNote]:
+    docs = data_dir / "documents"
+    if not docs.is_dir():
+        return []
+    return [d for d in load_documents(docs) if isinstance(d, CreditNote)]
+
+
+def _local_periods(tenant: str, period: Period, zones: dict) -> list[Period]:
+    """Billing periods (local months) that events of a UTC month file can belong to."""
+    zone = zones.get(tenant)
+    if zone is None:
+        return [_prev_period(period), period, _next_period(period)]
+    first = period.start.astimezone(zone)
+    last = (period.end - timedelta(microseconds=1)).astimezone(zone)
+    result = [Period(first.year, first.month)]
+    while result[-1] != Period(last.year, last.month):
+        result.append(_next_period(result[-1]))
+    return result
+
+
+@dataclass(frozen=True, slots=True)
+class PurgePlan:
+    files: tuple[Path, ...]  # data files to delete, sorted
+    index_files: tuple[Path, ...]  # sibling indexes removed with them (not reported)
+
+
+def plan_purge(data_dir: str | Path, today: date, zones: dict | None = None) -> PurgePlan:
+    """What a purge as of ``today`` deletes. Reads only; any unreadable document raises."""
+    base = Path(data_dir)
+    zones = zones or {}
+    invoices = _load_invoices(base)
+    finalized = {(i.tenant_id, i.period) for i in invoices if i.status is InvoiceStatus.FINALIZED}
+    by_number = {i.number: i for i in invoices if i.number}
+    cutoff = add_months(today, -CREDIT_NOTE_PROTECTION_MONTHS)
+    protected: set[tuple[str, Period]] = set()
+    protected_tenants: set[str] = set()
+    for note in _credit_notes(base):
+        if note.issue_date < cutoff:
+            continue
+        invoice = by_number.get(note.invoice_number)
+        if invoice is None:
+            protected_tenants.add(note.tenant_id)  # cannot tell which period: keep all
+        else:
+            protected.add((invoice.tenant_id, invoice.period))
+
+    files: list[Path] = []
+    indexes: list[Path] = []
+    events_root = base / "events"
+    if events_root.is_dir():
+        for tenant_dir in sorted(events_root.iterdir()):
+            tenant = tenant_dir.name
+            if not tenant_dir.is_dir() or not is_valid_tenant_dir_name(tenant):
+                continue
+            if tenant in protected_tenants:
+                continue
+            for path in sorted(tenant_dir.glob("*.jsonl")):
+                match = _MONTH_FILE.match(path.name)
+                if not match:
+                    continue
+                try:
+                    month = Period(int(match[1]), int(match[2]))
+                except ValueError:
+                    continue
+                periods = _local_periods(tenant, month, zones)
+                if all(
+                    add_months(p.end_day, EVENT_RETENTION_MONTHS) < today
+                    and (tenant, p) in finalized
+                    and (tenant, p) not in protected
+                    for p in periods
+                ):
+                    files.append(path)
+                    for suffix in (".idem", ".seen"):
+                        sibling = path.with_suffix(suffix)
+                        if sibling.exists():
+                            indexes.append(sibling)
+
+    rejects_root = base / "rejects"
+    if rejects_root.is_dir():
+        for path in rejects_root.glob("*.jsonl"):
+            match = _REJECT_FILE.match(path.name)
+            if not match:
+                continue
+            try:
+                logged = date.fromisoformat(match[1])
+            except ValueError:
+                continue
+            if (today - logged).days > REJECT_RETENTION_DAYS:
+                files.append(path)
+    return PurgePlan(tuple(sorted(files, key=str)), tuple(sorted(indexes, key=str)))
+
+
+def execute_purge(plan: PurgePlan) -> None:
+    """Delete each data file with its index files. Index goes first: a data file without
+    an index is rebuilt on next use, an index without data would claim keys of gone events."""
+    index_for: dict[Path, list[Path]] = {}
+    for index in plan.index_files:
+        index_for.setdefault(index.with_suffix(".jsonl"), []).append(index)
+    for path in plan.files:
+        for index in index_for.get(path, []):
+            index.unlink(missing_ok=True)
+        path.unlink(missing_ok=True)
diff --git a/tests/test_purge.py b/tests/test_purge.py
new file mode 100644
index 0000000..bb0345b
--- /dev/null
+++ b/tests/test_purge.py
@@ -0,0 +1,99 @@
+import json
+from datetime import date
+
+from meterbill.cli import main
+from meterbill.invoices.serialization import invoice_to_json
+from meterbill.invoices.models import Invoice, InvoiceLine, InvoiceStatus
+from meterbill.money import Money
+from meterbill.period import Period
+
+
+def finalized(tenant, period, number, status=InvoiceStatus.FINALIZED):
+    return Invoice(tenant, tenant, Period.parse(period), "EUR", (), date(2024, 1, 5),
+                   number=number, status=status, due_date=date(2024, 1, 19))
+
+
+def setup(data, tenant="NWD", month="2024-01"):
+    ev = data / "events" / tenant
+    ev.mkdir(parents=True, exist_ok=True)
+    (ev / f"{month}.jsonl").write_text("{}\n")
+    (ev / f"{month}.idem").write_text('"k"\n')
+    return ev
+
+
+def put_invoices(data, tenant, periods):
+    d = data / "invoices" / tenant
+    d.mkdir(parents=True, exist_ok=True)
+    for i, p in enumerate(periods):
+        (d / f"INV-MBDE-{tenant}-2024-{i + 1:05d}.json").write_text(
+            invoice_to_json(finalized(tenant, p, f"INV-MBDE-{tenant}-2024-{i + 1:05d}")))
+
+
+def run(data, date_, capsys, *extra):
+    code = main(["purge", "--date", date_, "--data-dir", str(data), *extra])
+    return code, capsys.readouterr().out.splitlines()
+
+
+def test_deletes_old_finalized_events_and_index(data_dir, capsys):
+    ev = setup(data_dir, tenant="ACM")
+    put_invoices(data_dir, "ACM", ["2023-12", "2024-01", "2024-02"])
+    code, out = run(data_dir, "2026-03-02", capsys, "--dry-run")
+    assert code == 0 and out == [str(ev / "2024-01.jsonl")]
+    assert (ev / "2024-01.jsonl").exists()
+    code, out = run(data_dir, "2026-03-02", capsys)
+    assert out == [str(ev / "2024-01.jsonl")]
+    assert not (ev / "2024-01.jsonl").exists() and not (ev / "2024-01.idem").exists()
+
+
+def test_retention_boundary(data_dir, capsys):
+    setup(data_dir, tenant="TKY")
+    put_invoices(data_dir, "TKY", ["2023-12", "2024-01", "2024-02"])
+    # UTC tenant: period 2024-01 ends 2024-02-01; +25 months = 2026-03-01; delete only strictly after
+    assert run(data_dir, "2026-03-01", capsys)[1] == []
+    assert len(run(data_dir, "2026-03-02", capsys)[1]) == 1
+
+
+def test_no_finalized_invoice_keeps_events(data_dir, capsys):
+    setup(data_dir, tenant="ZEN")
+    d = data_dir / "invoices" / "ZEN"
+    d.mkdir(parents=True)
+    (d / "INV-MBDE-ZEN-2024-00001.json").write_text(
+        invoice_to_json(finalized("ZEN", "2024-01", "INV-MBDE-ZEN-2024-00001", InvoiceStatus.VOID)))
+    assert run(data_dir, "2030-01-01", capsys)[1] == []
+
+
+def test_recent_credit_note_protects(data_dir, capsys):
+    from meterbill.credits.models import CreditNote
+    from meterbill.credits.serialization import credit_note_to_dict
+    setup(data_dir, tenant="ZEN")
+    put_invoices(data_dir, "ZEN", ["2024-01"])
+    note = CreditNote("CN-ZEN-2026-00001", "INV-MBDE-ZEN-2024-00001", "ZEN", "ZEN", "EUR", "r",
+                      date(2026, 1, 10), ())
+    docs = data_dir / "documents"
+    docs.mkdir()
+    (docs / "cn.json").write_text(json.dumps(credit_note_to_dict(note)))
+    assert run(data_dir, "2026-12-01", capsys)[1] == []
+    assert len(run(data_dir, "2027-01-11", capsys)[1]) == 1
+
+
+def test_berlin_neighbour_period_must_qualify(data_dir, capsys):
+    setup(data_dir, tenant="NWD")  # Europe/Berlin: 2024-01 UTC file touches 2024-01 only,
+    put_invoices(data_dir, "NWD", ["2024-01"])  # starts 01:00 local Jan 1, ends 00:59 Feb 1
+    assert run(data_dir, "2030-01-01", capsys)[1] == []  # Feb 1 local is 2024-02: no invoice
+    put_invoices_extra = data_dir / "invoices" / "NWD" / "INV-MBDE-NWD-2024-00002.json"
+    put_invoices_extra.write_text(invoice_to_json(finalized("NWD", "2024-02", "INV-MBDE-NWD-2024-00002")))
+    assert len(run(data_dir, "2030-01-01", capsys)[1]) == 1
+
+
+def test_rejects_older_than_30_days_sorted(data_dir, capsys):
+    r = data_dir / "rejects"
+    r.mkdir()
+    for n in ("2026-10-12", "2026-10-11", "2026-09-01"):
+        (r / f"{n}.jsonl").write_text("x\n")
+    code, out = run(data_dir, "2026-11-11", capsys)
+    assert out == [str(r / "2026-09-01.jsonl"), str(r / "2026-10-11.jsonl")]
+    assert (r / "2026-10-12.jsonl").exists()
+
+
+def test_bad_date_exit_1(data_dir, capsys):
+    assert main(["purge", "--date", "nope", "--data-dir", str(data_dir)]) == 1
