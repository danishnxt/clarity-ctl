+def format_tenants(catalog) -> str:
+    """Table of tenants sorted by id; two spaces between left-aligned columns."""
+    rows = [("ID", "NAME", "COUNTRY", "PLAN", "CURRENCY", "TZ")]
+    for t in sorted(catalog.tenants.values(), key=lambda t: t.id):
+        rows.append((t.id, t.name, t.country, t.plan_id,
+                     t.billing_currency or catalog.plan(t.plan_id).currency, t.tz))
+    widths = [max(len(r[i]) for r in rows) for i in range(6)]
+    return "\n".join("  ".join(r[i].ljust(widths[i]) for i in range(6)).rstrip() for r in rows)
