@@ -20,6 +20,7 @@ MISSING_KEY_REASON = "missing idempotency_key"
 # idempotency_key is not required in the header: rows without it are rejected one by one.
 CSV_COLUMNS = ("tenant_id", "meter", "quantity", "timestamp", "event_id")
 _SUFFIXES = {".jsonl", ".csv"}
+ENVELOPE_SUFFIX = ".envelope.json"
 
 
 @dataclass
@@ -103,6 +104,33 @@ def _csv_rows(path: Path) -> Iterator[_Row]:
             yield _validate(record, line)
 
 
+def _envelope_rows(path: Path) -> Iterator[_Row]:
+    """Rows of a batch envelope file: ``{"batch_id", "sent_at", "device_id", "events": [...]}``.
+
+    Each event is validated on its own, so a bad event does not reject its neighbours; its "line" is
+    its 1-based position in the ``events`` list.
+    """
+    with open(path, encoding="utf-8") as handle:
+        try:
+            envelope = json.load(handle, parse_float=Decimal)
+        except json.JSONDecodeError as exc:
+            yield _Row(1, None, error=f"invalid JSON ({exc.msg})")
+            return
+    events = envelope.get("events") if isinstance(envelope, dict) else None
+    if not isinstance(events, list):
+        yield _Row(1, envelope, error="envelope must be an object with an events list")
+        return
+    if not all(_has_idempotency_key(r) for r in events):
+        yield _Row(1, envelope, error=MISSING_KEY_REASON)
+        return
+    for number, record in enumerate(events, start=1):
+        yield _validate(record, number)
+
+
+def _is_envelope(path: Path) -> bool:
+    return path.name.lower().endswith(ENVELOPE_SUFFIX)
+
+
 def _tenant_of(row: _Row) -> str:
