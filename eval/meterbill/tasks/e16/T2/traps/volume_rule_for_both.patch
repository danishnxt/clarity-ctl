diff --git a/meterbill/pricing.py b/meterbill/pricing.py
index 8173df5..d77404a 100644
--- a/meterbill/pricing.py
+++ b/meterbill/pricing.py
@@ -91,3 +91,27 @@ def _price_volume(component: PlanComponent, quantity: Decimal, currency: str) ->
         f"{component.meter} (volume tier {number})", quantity, tier.unit_price,
         _amount(quantity, tier.unit_price, currency),
     )
+
+
+def next_tier_hint(component: PlanComponent, quantity: Decimal) -> str | None:
+    """How far ``quantity`` is from the next price tier of a tiered or volume component.
+
+    Returns "next tier: +N units at P" (P is the next tier's unit price), or
+    "next tier: top tier" when the quantity already prices in the last tier;
+    None for components that have no tiers. The rule follows the model: a tiered
+    quantity stays in a tier up to and including its ``up_to``, so it needs
+    ``up_to + 1 - quantity`` more units; a volume quantity leaves the tier when it
+    reaches ``up_to``, so it needs ``up_to - quantity`` more units.
+    """
+    if component.model not in (PricingModel.TIERED, PricingModel.VOLUME):
+        return None
+    inclusive = False
+    tiers = component.tiers
+    for index, tier in enumerate(tiers):
+        if tier.up_to is None or (quantity <= tier.up_to if inclusive else quantity < tier.up_to):
+            break
+    if tier.up_to is None:
+        return "next tier: top tier"
+    more = tier.up_to - quantity + (1 if inclusive else 0)
+    unit = "unit" if more == 1 else "units"
+    return f"next tier: +{more:f} {unit} at {tiers[index + 1].unit_price:f}"
