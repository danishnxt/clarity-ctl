+def credit_note_postings(note: CreditNote, accounts: AccountMap) -> list[Posting]:
+    """The balanced postings of one credit note, reversing the invoice lines it credits."""
+    number, day, zero = note.number, note.issue_date.isoformat(), Money.zero(note.currency)
+    postings = [Posting(number, day, RECEIVABLE_ACCOUNT, zero, -note.total)]
+    for line in note.lines:
+        postings.append(Posting(number, day, accounts.revenue_account(line.meter), -line.amount, zero))
+        if line.tax_amount.minor != 0:
+            postings.append(Posting(number, day, TAX_ACCOUNT_PREFIX + line.country, -line.tax_amount, zero))
+    return postings
+
+
+def _in_period(document: Document, period: Period) -> bool:
+    if isinstance(document, Invoice):
+        return document.period == period
+    return (document.issue_date.year, document.issue_date.month) == (period.year, period.month)
+
