+def format_plans(plans) -> str:
+    """Table of plans sorted by id: ID, NAME, MODEL, CURRENCY, two spaces between left-aligned columns."""
+    rows = [("ID", "NAME", "MODEL", "CURRENCY")]
+    for plan in sorted(plans, key=lambda p: p.id):
+        models = {c.model.value for c in plan.components}
+        rows.append((plan.id, plan.name, models.pop() if len(models) == 1 else "mixed", plan.currency))
+    widths = [max(len(r[i]) for r in rows) for i in range(4)]
+    return "\n".join("  ".join(r[i].ljust(widths[i]) for i in range(4)).rstrip() for r in rows)
