index 0000000..8a77970
--- /dev/null
+++ b/meterbill/payments/allocate.py
@@ -0,0 +1,116 @@
+"""Allocation of a tenant's unmatched payments to its open invoices."""
+
+from __future__ import annotations
+
+import json
+import os
+import tempfile
+from dataclasses import dataclass
+from datetime import date
+from decimal import Decimal
+from pathlib import Path
+
+from meterbill.credits import CreditNote
+from meterbill.fx import FxConverter
+from meterbill.invoices import Invoice, InvoiceStatus
+from meterbill.money import Money
+from meterbill.payments.models import Payment
+from meterbill.payments.store import PaymentStore, balance_for, matches, payment_to_dict
+from meterbill.wallets import WalletStore
+
+WRITE_OFF_ACCOUNT = "6900"
+ALLOCATED, WRITTEN_OFF = "allocated", f"writeoff:{WRITE_OFF_ACCOUNT}"
+
+
+@dataclass(frozen=True, slots=True)
+class Movement:
+    payment_id: str
+    target: str            # an invoice number, "wallet", or a ledger account number
+    amount: Money
+
+
+def _write_all(path: Path, payments: list[Payment]) -> None:
+    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name, suffix=".tmp")
+    with os.fdopen(fd, "w", encoding="utf-8") as handle:
+        for p in payments:
+            handle.write(json.dumps(payment_to_dict(p)) + "\n")
+        handle.flush()
+        os.fsync(handle.fileno())
+    os.replace(tmp, path)
+
+
+def allocate_unmatched(
+    tenant_id: str,
+    invoices: list[Invoice],
+    credit_notes: list[CreditNote],
+    store: PaymentStore,
+    wallets: WalletStore,
+    converter: FxConverter,
+) -> list[Movement]:
+    """Allocate the tenant's unmatched payments, oldest payment first, and record the result.
+
+    Open invoices are filled oldest due date first, ties by the lower invoice number; void
+    invoices are skipped. A leftover goes to the wallet in the payment's currency. A payment in
+    another currency than the invoice is converted at the payment date's rate, and an open
+    remainder under 0.50 after it is written off to account 6900. Each processed payment is
+    replaced in the payments file by the matched payments it was split into.
+    """
+    everything = store.load()
+    finalized = [i for i in invoices if i.status is InvoiceStatus.FINALIZED and i.number]
+    ids = {id(p): f"P{n}" for n, p in enumerate(everything, 1)}
+    pending = sorted((p for p in everything if p.tenant_id == tenant_id
+                      and not any(matches(p, i) for i in finalized)),
+                     key=lambda p: (p.received_date, ids[id(p)]))
+    replacements: dict[int, list[Payment]] = {}
+    added: list[Payment] = []
+    movements: list[Movement] = []
+
+    def open_amount(invoice: Invoice) -> Money:
+        return balance_for(invoice, [*everything, *added], credit_notes).open_amount
+
+    for payment in pending:
+        remaining, when, pid = payment.amount, payment.received_date, ids[id(payment)]
+        pieces: list[Payment] = []
+        candidates = sorted((i for i in finalized if i.tenant_id == tenant_id),
+                            key=lambda i: (i.due_date or date.max, i.number))
+        for invoice in candidates:
+            if remaining.minor <= 0:
+                break
+            owed = open_amount(invoice)
+            if owed.minor <= 0:
+                continue
+            cross = invoice.currency != remaining.currency
+            if cross:
+                rate = converter.rate(remaining.currency, invoice.currency, when)
+                available = FxConverter.apply(remaining, invoice.currency, rate)
+            else:
+                available = remaining
+            take = Money(min(owed.minor, available.minor), invoice.currency)
+            if take.minor < available.minor:           # the payment is only partly used
+                used = FxConverter.apply(take, remaining.currency,
+                                         converter.rate(invoice.currency, remaining.currency, when))
+                remaining = Money(max(remaining.minor - used.minor, 0), remaining.currency)
+            else:
+                remaining = Money.zero(remaining.currency)
+            piece = Payment(tenant_id, take, when, invoice.number, ALLOCATED)
+            pieces.append(piece)
+            added.append(piece)
+            movements.append(Movement(pid, invoice.number, take))
+            left = owed - take
+            if cross and left.minor > 0 and _below_half(left):
+                off = Payment(tenant_id, left, when, invoice.number, WRITTEN_OFF)
+                pieces.append(off)
+                added.append(off)
+                movements.append(Movement(pid, WRITE_OFF_ACCOUNT, left))
+        replacements[id(payment)] = pieces
+    if pending:
+        merged: list[Payment] = []
+        for p in everything:
+            merged.extend(replacements.get(id(p), [p]))
+        _write_all(store.path, merged)
+    return movements
+
+
+def _below_half(amount: Money) -> bool:
+    """Whether a positive amount is under 0.50 of its currency (half a major unit)."""
+    return amount.to_major() < Decimal("0.50")
