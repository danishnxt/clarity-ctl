+def _migrate_credit_sequences(path: Path) -> None:
+    """Move credit note counters written before entities existed under the default entity."""
+    if not path.is_file():
+        return
+    data = json.loads(path.read_text(encoding="utf-8") or "{}")
+    migrated = migrate_to_entity_sequences(data, DEFAULT_ENTITY)
+    if migrated is not data:
