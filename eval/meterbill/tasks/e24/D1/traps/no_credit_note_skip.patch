diff --git a/meterbill/dunning.py b/meterbill/dunning.py
new file mode 100644
index 0000000..45c927d
--- /dev/null
+++ b/meterbill/dunning.py
@@ -0,0 +1,63 @@
+"""Payment reminders: which reminder, if any, is due for each unpaid invoice on a date."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import date, timedelta
+from typing import Callable, Iterable
+
+from meterbill.credits import CreditNote
+from meterbill.fx import FxConverter
+from meterbill.invoices import Invoice, InvoiceStatus
+from meterbill.money import Money
+from meterbill.outbox import Contact
+from meterbill.payments import Payment, balance_for
+
+FINANCE_COPY = "finance@meterbill.example"
+# (level, days after the due date, addresses the level adds to the contact's own cc list)
+LEVELS = ((1, 7, ()), (2, 28, ()), (3, 35, (FINANCE_COPY,)))
+MIN_OPEN = Money(500, "EUR")      # no reminder below this open amount
+CREDIT_NOTE_QUIET_DAYS = 30       # no reminder while a credit note is this recent
+
+
+@dataclass(frozen=True, slots=True)
+class Reminder:
+    invoice_number: str
+    level: int
+    to: str
+    cc: tuple[str, ...]
+
+
+def format_reminder(reminder: Reminder) -> str:
+    line = f"{reminder.invoice_number}  L{reminder.level}  to={reminder.to}"
+    return line + (f"  cc={','.join(reminder.cc)}" if reminder.cc else "")
+
+
+def due_reminders(
+    on: date,
+    invoices: Iterable[Invoice],
+    payments: list[Payment],
+    credit_notes: list[CreditNote],
+    contact_for: Callable[[str], Contact],
+    converter: FxConverter,
+) -> list[Reminder]:
+    """Reminders due on ``on`` for finalized invoices that still have an open amount, by invoice number."""
+    found = []
+    for invoice in invoices:
+        if invoice.status is not InvoiceStatus.FINALIZED or invoice.due_date is None:
+            continue
+        level = next(((n, extra) for n, days, extra in LEVELS
+                      if invoice.due_date + timedelta(days=days) == on), None)
+        if level is None:
+            continue
+        open_amount = balance_for(invoice, payments, credit_notes).open_amount
+        if open_amount.minor <= 0:
+            continue
+        in_eur = (open_amount if open_amount.currency == "EUR"
+                  else converter.convert(open_amount, "EUR", invoice.issue_date))
+        if in_eur.minor < MIN_OPEN.minor:
+            continue
+        contact = contact_for(invoice.tenant_id)
+        found.append(Reminder(invoice.number, level[0], contact.billing_contact,
+                              contact.cc + level[1]))
+    return sorted(found, key=lambda r: r.invoice_number)
